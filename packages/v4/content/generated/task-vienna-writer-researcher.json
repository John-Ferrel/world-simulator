            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "project-reworked",
              "text": "撕纸的声音很轻，{subject}却听了两遍。新起的第一句只有十几个字，他写在本子边角上，又划掉两个形容词，才誊到首页。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "project-reworked",
              "text": "三个月后他把五十页稿纸码齐，边缘用锥子扎孔穿线，像装订一本私印的书。{neighbor}在楼道里问起进展，他只说“短了”，没说借的五克朗几时能还。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "project-sold",
          "weight": 2,
          "text": "房租催到门口，{subject}把已写的章节卖给一家小报，换了八克朗，够付一个月房租和两顿热饭。长篇锁进抽屉，钥匙搁在盐罐后面，{neighbor}问起时他只说“先不提了”，第二天照常去上工。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 8,
              "reason": "小报买下章节的稿酬"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "长篇被搁置的憋闷"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "小报上的通俗连载"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "novel_shelved",
              "add": true,
              "reason": "长篇手稿暂时锁进抽屉"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "project-sold",
              "text": "小报的编辑在柜台后数出八克朗，纸币边角发软。{subject}把稿子推过去，手指在最后一页上多停了一瞬，那页写着一个没来得及收场的家庭晚餐。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "project-sold",
              "text": "回家路上他买了面包和一小块黄油。抽屉里的手稿用旧报纸包着，钥匙搁在盐罐后面，他伸手去拿盐时碰到那把钥匙，没把它取出来。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "project-split",
          "weight": 1,
          "text": "{subject}把已写的章节拆成三篇随笔，分别寄给两家报纸和一份文学月刊。两家用了，一家没回，稿费一共十一克朗；他把长篇的骨架记在卡片盒里，留作以后，眼下先靠这十一克朗对付药费和煤钱。",
          "effects": [
