            {
              "type": "relation",
              "a": "$subject",
              "b": "$relative",
              "kind": "acquaintance",
              "trust": -0.08,
              "affection": -0.03,
              "obligation": -0.02,
              "fear": 0,
              "respect": -0.04,
              "reason": "亲戚临阵不肯作保"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "relative-refuses-guarantee",
              "text": "亲戚把烟蒂踩灭在门阶上，说自己也要在厂里做人。学徒还没开口，话已经堵在嗓子里。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "relative-refuses-guarantee",
              "text": "厂门口的风把熨平的袖口吹得发凉。他把路上想好的话在心里重念一遍，最后一句也没说出口。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
