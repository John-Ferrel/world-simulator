          "minAge": 32,
          "maxAge": 55
        }
      ],
      "outcomes": [
        {
          "id": "gang-prater-locked-out",
          "weight": 1,
          "text": "{subject}跟着{neighbor}穿过普拉特大街，看人放完焰火才想起回家。院门已经上了闩，母亲的灯灭了，{subject}在楼梯间坐到后半夜，膝盖冻得发僵。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "在冰冷的楼梯间过夜"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.06,
              "affection": 0.03,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "一起在普拉特玩到深夜"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "被锁在门外"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gang-prater-locked-out",
              "text": "焰火在运河对岸炸开，{neighbor}拍着巴掌，{subject}闻到他袖口上码头的鱼腥味，转身跑回院子时门板已经合死。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "gang-prater-locked-out",
              "text": "夜里湿气贴在脖子上，{subject}坐在楼梯的第三级，听见楼上开门又关上，没有人喊{subject}的名字。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "gang-corner-turn-back",
          "weight": 1,
          "text": "{subject}只把{neighbor}送到巷口的煤油灯下就折回去。第二天在水泵边，{neighbor}学{subject}走路的样子，几个人跟着笑，{subject}拎起水桶没有接话。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": -0.03,
              "affection": -0.02,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "被那伙人嘲笑"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "第二天挨了嘲笑"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gang-corner-turn-back",
              "text": "灯芯噼啪响了一下，{subject}说母亲要{subject}回去打水，{neighbor}只是耸了耸肩，把帽子往后一推就跟着别人走了。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "gang-corner-turn-back",
              "text": "水桶带回来的水溅在鞋面上，{subject}站在自家门口听见巷口那伙人的笑声拐了个弯，才慢慢上楼。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "gang-bring-younger-neighbor",
          "weight": 1,
          "text": "{subject}拉上隔壁更小的{neighbor}一起去桥下，回程时那孩子的母亲堵在院门口，说{subject}带坏了她家孩子，声音大得半条街都听见。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "被邻居当街数落"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": -0.02,
              "affection": 0.02,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "一起出门却连累对方母亲"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.01,
              "reason": "被堵在门口责骂"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gang-bring-younger-neighbor",
              "text": "那母亲一只手叉腰一只手攥着{neighbor}的领子，{subject}被问得答不上话，只觉得背后的汗贴着衬衫发凉。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "gang-bring-younger-neighbor",
              "text": "运河边的风把纸屑卷到脚边，{subject}本来还想辩解，看见{neighbor}低着头，就把话咽回去了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "gang-help-with-bread",
          "weight": 1,
          "text": "面包房关门前{subject}和{neighbor}凑了四赫勒，分到一块凉了的面包。夜里母亲问{subject}吃了什么，{subject}只答在院子里喝的水。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": -1,
              "reason": "在外面买剩面包吃"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -4,
              "reason": "凑钱买面包"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.04,
              "affection": 0.02,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "分吃同一块面包"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gang-help-with-bread",
              "text": "纸包着的面包还是温的，{subject}把它掰成两半，{neighbor}接过去先咬了一大口，剩下的一半在{subject}手心里。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "gang-help-with-bread",
              "text": "面包房里飘出烤焦的糖味，{subject}数了数掌心里的硬币，又回头看看站在灯影里的{neighbor}。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-childhood-adolescence.first-errand-job",
      "title": "第一份跑腿钱",
      "weight": 1,
      "rate": 0.0234,
      "conditions": [
        {
          "kind": "age",
          "min": 13,
          "max": 17
        },
        {
          "kind": "employment",
          "employed": false
        },
        {
          "kind": "cash",
          "max": 40
