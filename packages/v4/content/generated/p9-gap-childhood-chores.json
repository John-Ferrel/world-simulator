          "social"
        ]
      }
    },
    {
      "id": "p9-gap-childhood-chores.market-line",
      "title": "替家里排一次配给队",
      "weight": 1,
      "rate": 0.085,
      "conditions": [
        {
          "kind": "age",
          "min": 6,
          "max": 11
        },
        {
          "kind": "householdSize",
          "min": 3
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 6,
          "maxAge": 11
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 55
        }
      ],
      "tags": [
        "childhood",
        "market",
        "food",
        "queue"
      ],
      "outcomes": [
        {
          "id": "line-half-flour",
          "weight": 1,
          "text": "{subject}把布袋抱在胸前，一步一步跟着队伍挪到面包房窗口，买到半袋面粉。后面的人往前挤，她的鞋跟被踩掉一只，找回来时已经沾满泥。回家路上她把布袋换到肩上，另一只手拎着那只鞋，赤脚走过石板。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 2,
              "reason": "排到半袋面粉"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "赤脚走石板路磨伤脚底"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.02,
              "reason": "在人堆里守住自己的位置"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "line-half-flour",
              "text": "队伍从面包房拐到肉铺后墙，{subject}紧贴着前面人的背，怕被挤出队形。窗口的伙计把面粉往秤上一倒，吆喝声盖过了后面的抱怨。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "line-half-flour",
              "text": "有人往前一挤，{subject}脚下一空，鞋跟留在了谁的鞋底下。她弯腰去捡，布袋差点脱手，旁边的人替她扶了一把。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "line-sold-out-potatoes",
          "weight": 1,
          "text": "轮到{subject}时，窗口的木板已经合上，伙计说面粉卖完了。她攥着几个硬币站在墙根，最后在旁边的摊子上买了几个土豆。回家时母亲数了钱和土豆，脸上的纹路松了一点，说面粉明天再去排。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "用剩下的钱买了几个土豆"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "排到窗口却扑了空"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.02,
              "reason": "自己数钱买了土豆"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "line-sold-out-potatoes",
              "text": "前面的人一个个空手退开，木板合上时发出干脆的一声。{subject}站着没动，直到伙计探头说没有就是没有，才把硬币摊在手心里数。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "line-sold-out-potatoes",
              "text": "墙根下全是揉皱的纸和菜叶，{subject}蹲着挑了几个没发芽的土豆，用布袋兜着，走回家时袋子贴着腿一晃一晃。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "line-both-families",
          "weight": 1,
          "text": "{neighbor}从队里探出头，招手让{subject}站到她前面，说孩子站着不容易被挤。{subject}替两家都领了面包，回来在{residence}门口把两包分开。母亲回来后一包一包问清价钱和份量，{subject}把每笔数都说了出来。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 2,
              "reason": "替两家领回的面包里分到的那份"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.07,
              "affection": 0.04,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0.03,
              "reason": "互相照应着排队"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.03,
              "reason": "分清两家的份量和找零"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "line-both-families",
              "text": "窗口的伙计嫌孩子插队，{neighbor}隔着人喊这孩子在替她家排。{subject}抱着两包面包退出来，用指头按着纸包上的折痕，怕拿混了。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "line-both-families",
              "text": "队伍里有{worker}提着饭盒挤过去，{subject}往墙边让了让。{neighbor}塞给她几枚零钱，说照这个数找，别让谁家少了。",
