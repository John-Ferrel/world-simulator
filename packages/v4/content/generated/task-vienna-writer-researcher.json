    {
      "id": "task-vienna-writer-researcher.public-reading",
      "title": "咖啡馆后厅的朗读夜",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 25,
          "max": 59
        },
        {
          "kind": "education",
          "in": [
            "secondary",
