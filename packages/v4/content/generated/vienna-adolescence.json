            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "respect": 0.1,
              "reason": "{teacher}鼓励{subject}继续读书"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$father",
              "kind": "kin",
              "obligation": 0.06,
              "reason": "{father}听闻{subject}可能继续升学"
            }
          ],
          "narration": [
            {
              "id": "school-a",
              "key": "stay-in-school",
              "text": "{teacher}在放学后把{subject}留在教室里，指着算术本上最后一道题说，再念一年，也许能进商业学校。{father}在门外听完，把帽檐压低了半指。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "school-b",
              "key": "stay-in-school",
              "text": "{teacher}用粉笔在黑板角落写下商业学校的报名费，{subject}盯着那个数字。{father}最后说，再念一年，砖厂不会跑。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "go-to-brickworks",
          "weight": 2,
          "text": "{father}把{subject}的算术本合上，说下周一跟着街尾的工头去砖厂。{teacher}在门口拦住{subject}，递来一张抄着夜校地址的纸条，{subject}把它折进鞋垫。",
          "effects": [
            {
              "type": "role",
              "personId": "$subject",
              "role": "brickworks_laborer",
              "add": true,
              "reason": "进入砖厂做工"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 4,
              "reason": "{subject}砖厂首周工钱"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "砖厂头几天搬砖"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "reason": "{teacher}给了夜校地址纸条",
              "flag": "has-evening-school-address",
              "add": true
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "respect": 0.05,
              "obligation": 0.04,
              "reason": "{teacher}塞给{subject}夜校地址"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$father",
              "kind": "kin",
              "obligation": 0.08,
              "fear": 0.03,
              "reason": "{father}决定让{subject}去砖厂"
            }
          ],
          "narration": [
            {
              "id": "brick-a",
              "key": "go-to-brickworks",
              "text": "{father}把{subject}的算术本合上，说下周一跟着街尾的工头去砖厂。{teacher}在门口拦住{subject}，递来一张抄着夜校地址的纸条，{subject}把它折进鞋垫。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "brick-b",
              "key": "go-to-brickworks",
              "text": "{father}带{subject}去砖厂，工头掀开{subject}的袖口看了看胳膊，说行。{teacher}的夜校纸条被汗水洇软，{subject}把它贴在砖垛上晾干。",
              "tone": [
                "dry"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "vienna-adolescence.stolen-roll",
