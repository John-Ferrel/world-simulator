              "amount": 0.03,
              "reason": "在党部门口等待并当面交涉"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "contact-adler-in-person",
              "text": "党部的楼梯很窄，散会的人从他身边挤过去，有人夹着报纸，有人还在争论。他把写好的地址纸条攥出了汗。",
              "tone": [
