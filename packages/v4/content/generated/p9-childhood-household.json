      ],
      "outcomes": [
        {
          "id": "hospital-deposit",
          "weight": 1,
          "text": "{parent}用围巾把{subject}整个裹住，抱下楼梯去坐电车。综合医院的急诊要先交押金，母亲数出几张揉皱的克朗纸币放在柜台上，{subject}被留在观察室里，头顶挂着一盏白得刺眼的灯。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -6,
              "reason": "医院急诊押金和电车票"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "在医院接受处理"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "被留在陌生观察室"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "hospital-deposit",
              "text": "电车在湿轨上叮当响，{parent}一只手抱着{subject}，一只手数着裤袋里的硬币。医院走廊的地砖冰凉，护士掀开围巾探了探额头，让先去柜台。",
              "tone": [
                "tense"
              ]
            },
            {
              "id": "alt",
              "key": "hospital-deposit",
              "text": "观察室里还有别的孩子，隔着帘子听见有人低声哭。{subject}想抓母亲的手，母亲被拦在门边，说天亮下工前再来。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "called-corner-doctor",
          "weight": 1,
          "text": "{parent}请{neighbor}去叫街角的老医生。医生提着皮包上来，听了听胸口，从纸包里抖出几撮退烧药粉，收下两克朗，又用铅笔头在处方纸上写了条饮食单：稀粥、温水、别吃面包皮。",
