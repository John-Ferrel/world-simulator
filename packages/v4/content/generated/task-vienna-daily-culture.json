  "nodes": [
    {
      "id": "task-vienna-daily-culture.cafe-newspaper",
      "title": "咖啡馆里的第二份报纸",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 60,
          "max": 80
        },
        {
          "kind": "cash",
          "min": 3
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 60,
          "maxAge": 80
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 55,
          "maxAge": 85
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "cafe-newspaper.share-and-argue",
          "weight": 1,
          "text": "{subject}把《新自由报》推到{neighbor}面前，两人就议会里一项煤气税争起来。咖啡从烫嘴放到凉透，侍者来收杯时，他们各自把报纸的一角折好，约好明天接着看。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -3,
              "reason": "两杯咖啡和一份报纸的钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.04,
              "obligation": 0,
              "fear": 0,
              "respect": 0.02,
              "reason": "为报纸上的新闻争论后仍约好明日再谈"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "在咖啡馆里有人愿意和他争论"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cafe-newspaper.share-and-argue",
              "text": "他把报纸折成两半，指着议会版上煤气税那一段念出声。邻桌的{neighbor}凑过来，手指点着数字说算错了，两个人把杯子推到一边，差点打翻糖罐。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "cafe-newspaper.share-and-argue",
              "text": "侍者把第二杯咖啡放下时，{subject}已经把报纸让给了{neighbor}。他们从煤气价格争到市政厅的椅子，声音压得很低，却在桌子底下互相踢了一脚。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "cafe-newspaper.correct-reading",
          "weight": 1,
          "text": "{subject}听见{worker}把报上一条煤气价格读错了一个零，顺口纠正。桌边忽然安静下来，{worker}红着脸把报纸推给他，邻桌有人点头，也有人嫌他多嘴。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "在咖啡馆里纠正了读错的数字"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": -0.02,
              "affection": 0,
              "obligation": 0,
              "fear": 0,
              "respect": 0.04,
              "reason": "当众纠正了对方读错的数字"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "known_as_cafe_corrector",
              "add": true,
              "reason": "在咖啡馆里因纠正读报被人记住"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cafe-newspaper.correct-reading",
              "text": "{worker}念到“每千立方尺”时把零吞掉了，{subject}用手指敲了敲桌面，说出正确的数目。旁边喝咖啡的人抬起眼，{worker}把报纸往他面前一推，说那你来念。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "cafe-newspaper.correct-reading",
              "text": "那年轻人读得正起劲，{subject}插了一句“少了一个零”，声音不大，却让整张桌子都听见了。侍者擦杯子时笑了一下，{worker}低下头去搅自己的咖啡。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "cafe-newspaper.buy-paper-for-neighbor",
          "weight": 1,
          "text": "{subject}替腿脚不便的{neighbor}去街角报亭买报，回来时自己的咖啡已被收走，桌上只剩一圈水渍。{neighbor}要把三赫勒塞给他，他摆摆手，坐下来重新要了一杯。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -4,
              "reason": "替邻居买报又重叫了一杯咖啡"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.1,
              "affection": 0.05,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0.02,
              "reason": "替腿脚不便的邻居跑腿买报"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "回来发现咖啡已被收走"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cafe-newspaper.buy-paper-for-neighbor",
              "text": "他穿过街角的风，从报亭窗口递进三赫勒，把折好的报纸夹在腋下。回到桌边时咖啡杯已经不见了，{neighbor}正伸着脖子等，嘴里埋怨他去了太久。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "cafe-newspaper.buy-paper-for-neighbor",
              "text": "报亭的帘子被风吹得啪啪响，{subject}等摊主找零时跺了跺脚。等他回到咖啡馆，侍者已经把杯子收进托盘，{neighbor}把报纸接过去，翻到讣告版先看了起来。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "daily",
        "goals": ["rest", "belonging"],
        "needs": ["belonging", "status"],
        "baseUtility": 1,
        "risk": 0.05,
        "skills": ["literacy", "social"]
      }
    },
    {
      "id": "task-vienna-daily-culture.cinema-concert",
      "title": "周日下午的楼座",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 60,
          "max": 80
        },
        {
          "kind": "cash",
          "min": 5
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 60,
          "maxAge": 80
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 55,
          "maxAge": 85
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "cinema-concert.top-balcony",
          "weight": 1,
          "text": "{subject}买了楼座最后一排的票，扶着栏杆一级级往上走。散场时他跟着人群哼了一段铜管旋律，夜风把帽檐吹歪，他一路走到电车轨道边才想起该往哪边拐。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "楼座票和路上买的热栗子"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "在楼座听完整场并跟着人群哼旋律"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.03,
              "affection": 0.03,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "散场时和邻居在门口碰头"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cinema-concert.top-balcony",
              "text": "楼座的木头椅子硌得他后背发酸，可铜管一响他就忘了。散场灯亮时，他还坐着看空舞台，直到{neighbor}从下面喊他，才慢慢扶栏杆站起来。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "cinema-concert.top-balcony",
              "text": "他把票根折进背心口袋，在最后一排找了个靠墙的位子。音乐响起来时，他用手指在膝盖上打拍子，散场后嘴里还留着那段调子，连买栗子时都在哼。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "cinema-concert.cover-ears",
          "weight": 1,
          "text": "铜管乐刚一响，{subject}就捂住耳朵，太阳穴一跳一跳地疼。没等中场他便扶着栏杆往外走，在门口台阶上坐了好一会儿，票钱算是白花了。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "没听完的楼座票"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "铜管乐太响引起头痛"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "中途离场觉得扫兴又浪费钱"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cinema-concert.cover-ears",
              "text": "小号拔高的那一下，{subject}觉得耳膜被人用指头弹了。他低头从座位间挤出去，楼梯间的冷空气才让太阳穴慢慢松开，楼下检票的人看了他一眼，没说话。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "cinema-concert.cover-ears",
              "text": "他把帽子压紧，双手捂住耳朵，可声音还是从指缝里钻进来。中场休息前他就摸到出口，在台阶上坐下，摸出怀表看时间，盘算着回家该走哪条近路。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "cinema-concert.neighbor-pays",
          "weight": 1,
          "text": "售票口前{subject}数了两遍硬币，还差几赫勒。{neighbor}替他补上，他嘴上道谢，回家路上一路计算着怎么还这份人情，连楼座里演了什么都没记住。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.1,
              "affection": 0.06,
              "obligation": 0.12,
              "fear": 0,
              "respect": 0.05,
              "reason": "邻居替他补足了票钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "欠下人情心里不踏实"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cinema-concert.neighbor-pays",
              "text": "他把硬币一枚枚排在售票窗台上，数到第三遍还是差三赫勒。{neighbor}从后面伸手把铜板推过去，说算我请你看。{subject}把找零捏在手心，整场戏都没松开。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "cinema-concert.neighbor-pays",
              "text": "售票员已经不耐烦地敲窗框了，{subject}的硬币却怎么也不够。{neighbor}叹了口气替他付了，他嘴里说下个月一定还，回家路上却一直低头踢着人行道上的碎石子。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "culture",
        "goals": ["rest", "belonging"],
        "needs": ["belonging", "status"],
        "baseUtility": 1,
        "risk": 0.05,
        "skills": ["social"]
      }
    },
    {
      "id": "task-vienna-daily-culture.church-festival",
      "title": "教堂前的教区节",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 60,
          "max": 80
        },
        {
          "kind": "placeKind",
          "in": ["home", "church"]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 60,
          "maxAge": 80
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 50,
          "maxAge": 85
        },
        {
          "key": "church",
          "kind": "organization",
          "required": false,
          "organizationKind": "church"
        }
      ],
      "outcomes": [
        {
          "id": "church-festival.set-chairs",
          "weight": 1,
          "text": "{subject}帮{neighbor}把棚子下的长椅一张张摆齐，又留下来喝了一碗豆汤。临走时他答应下次带一盘点心，{church}门口的风把蜡烛吹得东倒西歪，他伸手扶正了两支。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "在教区节喝了一碗豆汤"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.05,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0.03,
              "reason": "一起摆长椅并答应下次带点心"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "在教区节上帮忙摆椅子"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "church-festival.set-chairs",
              "text": "长椅腿在石板地上刮出刺耳的声音，{subject}弯着腰一张张对齐。摆完最后一排，{neighbor}端来一碗汤，他坐在台阶上喝，看孩子们绕着蜡烛棚追跑。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "church-festival.set-chairs",
              "text": "他把袖子挽到肘上，和{neighbor}一人一头抬长椅，木头上还留着去年蜡烛的油渍。汤是热的，他喝得很慢，答应下回从家里带一盘点心过来。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "church-festival.all-coins",
          "weight": 1,
          "text": "{subject}把口袋里的零钱全投进{church}门口的捐款箱，数了数只剩几赫勒，回家时没舍得坐电车，沿着环城路慢慢走回去，脚底磨得发热。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "教区节上捐出的零钱"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "没钱坐电车步行回家脚底发热"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "在教区节上慷慨捐款"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "church-festival.all-coins",
              "text": "捐款箱的木盖被摸得发亮，{subject}把铜板一枚枚塞进去，听见它们落到底部。回家路上他在电车轨道边站了一会儿，摸摸空口袋，还是把脚迈向了人行道。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "church-festival.all-coins",
              "text": "他本来想留两赫勒坐车，手伸进口袋时却把最后几枚也投了进去。环城路的石板有些硌脚，他走一段歇一段，到家时天还没黑透。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "church-festival.turn-away",
          "weight": 1,
          "text": "{subject}走到{church}门口，看见和自己吵过架的{neighbor}正站在汤锅后面。他停了两步，转身往市场方向走，教区节的钟声在背后响了一阵，他始终没有回头。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "在教堂门口避开吵过架的邻居"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "rival",
              "trust": -0.06,
              "affection": -0.03,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "在教区节门口转身避开对方"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "church-festival.turn-away",
              "text": "棚子下的汤锅冒着白气，{neighbor}正用长勺搅着。{subject}在台阶下站住，手插在口袋里，最后把帽檐往下压了压，沿着墙根往市场的方向走了。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "church-festival.turn-away",
              "text": "他本来想过去喝碗汤，可看见{neighbor}在汤锅后面，脚就停住了。钟楼上的鸽子扑棱棱飞起来，他顺着市场的方向走，路上踢开了一颗小石子。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "culture",
        "goals": ["belonging", "rest"],
        "needs": ["belonging", "status"],
        "baseUtility": 1,
        "risk": 0.05,
        "skills": ["social"]
      }
    },
    {
      "id": "task-vienna-daily-culture.market-bargain",
      "title": "收摊前的半篮李子",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 60,
          "max": 80
        },
        {
          "kind": "cash",
          "max": 30
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 60,
          "maxAge": 80
        },
        {
          "key": "marketWoman",
          "kind": "worker",
          "required": true,
          "minAge": 30,
          "maxAge": 70
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": false,
          "minAge": 50,
          "maxAge": 85
        }
      ],
      "outcomes": [
        {
          "id": "market-bargain.buy-bruised",
          "weight": 1,
          "text": "{subject}挑出还能吃的半篮李子，付了四赫勒，{marketWoman}又塞给他一只苹果，说是搭头。回家路上篮子沉甸甸地坠着手臂，他把碰伤的先挑出来放在最上面。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.04,
              "reason": "买半篮碰伤的李子"
            },
