    {
      "id": "p9-history-cultural-contact.letter-freud",
      "title": "寄往 Berggasse 19 的求学信",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 22,
          "max": 40
        },
        {
