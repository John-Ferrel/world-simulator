            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-recruit-two",
              "text": "食堂桌上摆着三个汤碗，{worker}推过一块面包来，说已经把包装间的名字记下了，下星期三去活动室。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-recruit-two",
              "text": "{unionMember}在册子末尾添上两个新名字，笔尖顿了顿；午休的汽笛一响，汤碗还冒着热气就没人管了。",
              "tone": [
                "matter-of-fact"
              ]
            }
