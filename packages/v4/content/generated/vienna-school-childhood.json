{
  "id": "vienna-school-childhood",
  "title": "国民学校的孩子",
  "stage": "childhood",
  "ageWindow": {
    "min": 7,
    "max": 11
  },
  "tags": [
    "school",
    "social",
    "childhood"
  ],
  "baseRate": 0.5,
  "conditions": [
    {
      "kind": "education",
      "in": [
        "primary"
      ]
    },
    {
      "kind": "placeKind",
      "in": [
        "school",
