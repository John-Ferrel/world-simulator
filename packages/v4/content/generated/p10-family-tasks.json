          ],
          "narration": [
            {
              "id": "default",
              "key": "arrange-childcare.neighbor",
              "text": "老太太接过孩子，用旧围裙兜着坐在窗边，说一克朗一周，六点送来六点接。来者数出硬币，把奶瓶放在她灶台边。第三夜孩子还是哭醒，来者抱着他在屋里走，天亮前靠着床沿打了个盹。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "arrange-childcare.neighbor",
              "text": "邻居老太太的屋里有一股樟脑味，她把孩子放在膝上颠了颠，说先试一星期。来者每周付一克朗，早晨把孩子裹好送过去，晚上接回来时孩子手里攥着老太太给的干面包皮。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "arrange-childcare.sister",
          "weight": 1,
          "text": "姐姐把孩子接去城外住一个月，说那边有院子，空气好。一个月后送回来，孩子会叫人了，可看见来者就往姐姐身后躲。姐姐在门口站了一会儿，说下个月还能来住。来者把孩子抱进屋，他哭了半宿。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.1,
              "reason": "孩子从城外回来认生"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sister",
              "kind": "kin",
              "trust": 0.06,
              "reason": "姐姐帮忙照看孩子一个月"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "arrange-childcare.sister",
              "text": "姐姐把孩子裹在披肩里抱上电车，说城外有院子，一个月就送回来。来者站在站台上看车走远。一个月后孩子会叫人了，可看见来者就往姐姐身后躲。来者把孩子抱进屋，他哭了半宿。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "arrange-childcare.sister",
              "text": "姐姐家在多瑙河对岸，院子里晾着床单。孩子在那里住了一个月，回来时脸圆了些，手里攥着一块河边的白石子。可他站在门口不肯叫来者，姐姐蹲下来哄，来者把行李提进屋，听见身后孩子叫了一声姨。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "arrange-childcare.quit-job",
          "weight": 1,
          "text": "来者辞掉半天工，自己看孩子。家里少了一份工钱，晚饭从两顿改成一顿，土豆和面包皮煮成一锅。伴侣没说什么，只把煤钱数了两遍。来者夜里等孩子睡了，在窗边替人缝补袜子换几个赫勒。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -4,
              "reason": "辞掉半天工少了一份收入"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": -1,
              "reason": "晚饭减为一顿"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "营养不足和夜里缝补的劳累"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "arrange-childcare.quit-job",
              "text": "来者把半天工的工钱单交回去，换回自己看孩子。晚饭从两顿并成一顿，土豆和面包皮煮一锅，伴侣把煤钱数了两遍。孩子睡下后，来者在窗边缝袜子，一枚针扎了手指，她含住指头继续缝。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "arrange-childcare.quit-job",
              "text": "厂里说半天工没了就没了，来者没再争。厨房里少了一只面包，晚饭只有一锅糊糊。伴侣把勺子放下，说来年春天再说。夜里来者替邻居补袜子，三个赫勒一双，缝到灯芯烧短。",
              "tone": [
                "matter-of-fact"
              ]
            }
