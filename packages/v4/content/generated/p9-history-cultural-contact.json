          "maxAge": 66,
          "historicalId": "Q9215"
        },
        {
          "key": "mentor",
          "kind": "worker",
          "required": false,
          "minAge": 40,
          "maxAge": 70,
          "occupation": "Arzt"
        }
      ],
      "outcomes": [
        {
          "id": "freud-invites-wednesday",
          "weight": 1,
          "text": "{freud}回信说可以先来听周三的讨论，但要自己找一位分析者，费用另算。{subject}把信读了三遍，在日历上圈出日期，又去问{mentor}能否介绍便宜些的分析者，{mentor}摇头。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "寄信和买讨论会用的笔记本"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "弗洛伊德允许旁听周三讨论，分析须另找且自费",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$subject",
              "visibility": "private",
              "trueInWorld": true
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$freud",
              "kind": "acquaintance",
              "trust": 0.05,
              "respect": 0.15,
              "reason": "得到回信并获准旁听"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "求学信有了回音"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "freud-invites-wednesday",
              "text": "回信写在诊所信笺上，字迹工整。{subject}在病房走廊里拆开，读到“可先旁听”时停下脚步。{mentor}看过信说，分析者的费用不是小数，最好先问清楚。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "freud-invites-wednesday",
              "text": "信封上的地址是贝格街十九号，邮戳清楚。{subject}把信折好放进上衣内袋，去问{mentor}有没有便宜些的分析者。{mentor}正在写病历，头也没抬，只说“慢慢找”。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "freud-one-line-refusal",
          "weight": 1,
          "text": "回信只有一句：病房经验不够，先去综合医院做满一年助理。{subject}把信放在桌上，数了数自己已经做了七个月。推荐条和病例还夹在信封里，没有动过。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.07,
              "reason": "被直接拒绝"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "弗洛伊德要求至少一年助理经验才考虑",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$subject",
              "visibility": "private",
              "trueInWorld": true
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "寄信邮资和信纸"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "freud-one-line-refusal",
              "text": "回信短得像个便条，末尾有签名。{subject}把信翻过来，背面空白。病房里有人在叫换药，{subject}把信塞进抽屉，抽屉里还压着没抄完的病例。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "freud-one-line-refusal",
              "text": "只有一句话，连客套都省了。{subject}在灯下又读了一遍，把信封里的推荐条抽出来看了看，又放回去。窗外天已经暗了，病房的煤气灯一盏盏亮起来。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "freud-no-reply",
          "weight": 1,
          "text": "信没有回音。{subject}把推荐条和病例收进抽屉，改去听大学的神经病理课，一学期学费十二克朗。第一堂课坐在后排，抄了四页笔记，教授的名字始终没听清。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -12,
              "reason": "神经病理课学费"
