  "developmentEvents": [
    {
      "action": "vienna-social-movement.recruitment/read-and-decline",
      "year": 1918,
      "text": "Anna Bauer把传单读了两遍，记下上面的地址，却没有去。第二天照常上工；午休时听见两个工友低声谈论同一场集会。"
    },
    {
      "action": "vienna-social-movement.leaflet/vienna-social-movement.leaflet.join",
      "year": 1918,
      "text": "回家路上Hermann Kral塞来半块黑面包，说以后每周三在五区碰头。Emil Weiss把面包掰成两半，一半当场吃掉，指头上的墨印碰到面包皮，留下淡黑的痕。"
    },
    {
      "action": "vienna-social-movement.recruitment/join-and-carry",
      "year": 1918,
      "text": "Hermann Kral在楼梯下面接到一张折成四折的传单。纸上没有署名，只写着下一次集会的地址。Hermann Kral去了，在昏暗的屋里报上姓名，成为Vienna Women's Anti-War Committee的一员，并答应负责自己所在街区的联络。"
    },
    {
      "action": "vienna-social-movement.recruitment/report-to-official",
      "year": 1918,
      "text": "Katharina Bauer把传单交给楼里的门房。门房没有接，只让Katharina Bauer自己去找警察局。那天傍晚，两个穿便衣的人在街口站了很久。"
    },
    {
      "action": "vienna-social-movement.leaflet/vienna-social-movement.leaflet.hide",
      "year": 1918,
      "text": "Anna Bauer走后，Katharina Bauer蹲在灶前拨弄煤渣，心跳还没平。那张纸的墨味混着煤烟，他连咳两声，把汤锅从火上端开，没再往砖缝那边看。"
    },
    {
      "action": "vienna-social-movement.recruitment/join-and-carry",
      "year": 1918,
      "text": "Maria Kral在楼梯下面接到一张折成四折的传单。纸上没有署名，只写着下一次集会的地址。Maria Kral去了，在昏暗的屋里报上姓名，成为Vienna Women's Anti-War Committee的一员，并答应负责自己所在街区的联络。"
    },
    {
      "action": "vienna-social-movement.meeting/speak-and-organize",
      "year": 1918,
      "text": "Maria Kral在后屋的会议上报出自己街区的名字：谁家缺煤，谁被房东催租，谁知道哪间印刷厂还在招人。Vienna Women's Anti-War Committee把这些事记进一本旧账本，散会时每个人带走一叠更小的纸条。"
    },
    {
      "action": "vienna-social-movement.recruitment/read-and-decline",
      "year": 1918,
      "text": "Rosa Lechner把传单读了两遍，记下上面的地址，却没有去。第二天照常上工；午休时听见两个工友低声谈论同一场集会。"
    }
  ],
