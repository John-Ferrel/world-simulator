              "b": "$relative",
              "kind": "kin",
              "trust": 0.08,
              "reason": "舅公真替他引见"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$foreman",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "工头看了他干活"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "trial_work_pending",
              "add": true,
              "reason": "约好下周试工"
            },
