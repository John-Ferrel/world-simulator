# Local PostgreSQL; no credentials are committed.
DATABASE_URL=postgres://localhost:55432/living_world
PORT=3001
WORLD_SEED=tide
WORLD_MINUTES_PER_YEAR=20
WORLD_MAX_YEARS=300
AUTO_NEXT_WORLD=false
COOKIE_SECURE=false
# Optional model mode. No key means deterministic baseline simulation.
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_DAILY_TOKEN_CAP=50000
# LLM_API_KEY=

# OPENCODE_key=
# Optional OpenCode Go (do not commit a real key)
WORLD_PACK=earth-1900
LLM_PROVIDER=opencode-go
LLM_MODEL=opencode-go/deepseek-v4.1-flash
# OPENCODE_API_KEY=
OPENCODE_SESSION=world-simulator
# Dynamic deliberation is budgeted globally; simulation never waits for it.
LLM_PLANS_PER_MONTH=16
SIM_COMMAND_BATCH_SIZE=100

# Months advanced per commit; 1 preserves production one-month semantics.
SIM_MONTHS_PER_STEP=12

# Deterministic immediate birth for local play; model enrichment can happen later.
BIRTH_FAST_PATH=true

# v4 Vienna slice
V4_ECONOMY=1
V4_HORIZON_YEAR=2000
V4_WISH_WORKER=1
