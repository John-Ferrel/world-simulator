    {
      "id": "p10-edu-work-tasks.seek-apprenticeship",
      "title": "作坊门口的工具袋",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 25
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "max": 40
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 25
        },
        {
          "key": "master",
          "kind": "worker",
