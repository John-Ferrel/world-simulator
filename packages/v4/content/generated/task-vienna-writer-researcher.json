      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 25,
          "maxAge": 59
        },
        {
          "key": "schnitzler",
          "kind": "historical",
          "required": false,
          "minAge": 48,
          "maxAge": 56,
          "historicalId": "Q44331"
