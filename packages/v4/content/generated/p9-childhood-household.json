              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.08,
              "affection": 0.08,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0.03,
              "reason": "母亲通宵照看"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "vinegar-compress",
              "text": "醋味在狭小的屋子里散不开，湿布换了一次又一次。{subject}半睡着听见母亲起身去舀水，铁盆边碰出很轻的一声。",
