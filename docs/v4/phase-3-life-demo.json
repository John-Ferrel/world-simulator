      "age": 74,
      "events": 327,
      "sample": [
        {
          "year": 1983,
          "action": "vienna-parish-aid.funeral-society/funeral-society.pay",
          "text": "八个赫勒在手心里被汗捂热，Life 01一枚枚点过，才从怀里掏出蓝皮本。纸角卷了，铅笔写的名字挤成一片，她翻到中间一页，用指甲在门牌号上按了按。"
        },
        {
          "year": 1983,
          "action": "vienna-housing-move.moving-day/moving-day-sell-up",
          "text": "收破烂的把两克朗数在门槛上，顺手敲了敲桌板看木料。Ferdinand 2把铁盒扣好，那里面只有照片和几封旧信。Life 01替Ferdinand 2扶着门，说旧床架值不了几个钱，能脱手就不亏。"
        },
        {
          "year": 1984,
          "action": "vienna-elder-bereavement.empty-room/empty-room.move-out",
          "text": "旧货商只肯给四克朗，说柜子太旧、床架缺一条横档。Life 01点了头，看他用绳子把椅子四条腿捆在一起，扛上肩就走。"
        },
        {
          "year": 1984,
          "action": "vienna-elder-bereavement.grave-visit/grave-visit.clean-stone",
          "text": "丁香才开，一小把要十赫勒。Life 01把它搁在碑脚，坐了一会儿再起身，裤子上沾了泥，Mitzi Kral伸手替他拍了拍。"
        },
        {
          "year": 1984,
          "action": "vienna-housing-move.rent-notice/rent-notice-pay",
          "text": "纸上的字是看门人代写的，墨水还没干透。Otto Hofer把裁好的旧报纸摞好，腾出钱来先付房租，自己那份晚饭由土豆改成稀汤。"
        },
        {
          "year": 1985,
          "action": "vienna-elder-care.union-office/sign-for-small-allowance",
          "text": "Life 01在签字栏画了个歪斜的名字，Mitzi Winter 3递过十二克朗，把钢笔收回胸袋。"
        },
        {
          "year": 1985,
          "action": "vienna-church-community.tenement-prayer/rent-prayer-argument",
          "text": "Life 01怪Friedrich Moser把人都招到楼梯上，木头泡了潮气才裂的。Friedrich Moser没还嘴，蹲下去看那道裂缝，指甲刮下一层朽木屑。"
        },
        {
          "year": 1986,
          "action": "statistical_death/pneumonia",
          "text": "Life 01在Leopoldstädter Zinshaus, gemeinsamer Gang发起高烧，咳嗽越来越深。邻居帮忙去请医生，医生到时只留下药粉和一张账单；几天后呼吸变得很浅。"
        }
      ]
    },
    {
      "id": "person-phase3-life-2",
      "name": "Life 02",
      "born": {
        "year": 1912,
        "month": 1
      },
      "died": {
        "year": 1987,
        "month": 1
      },
      "deathCause": "老年衰竭",
      "alive": false,
      "age": 75,
      "events": 227,
      "sample": [
        {
          "year": 1984,
          "action": "statistical_infection",
          "text": "Life 02在Leopoldstädter Zinshaus, gemeinsamer Gang病倒了，肺炎让身体发热、虚弱，接下来的日子只能卧床。"
        },
        {
          "year": 1984,
          "action": "vienna-parish-aid.sick-call/sick-call.help-in",
          "text": "火柴划了三根才点着，煤核太潮，烟往屋里钻。病人咳得床板发响，Life 02把窗子推开一条缝，又把毯子往上拉了拉。粥在锅里冒泡，气味盖住了酸味。"
        },
        {
          "year": 1985,
          "action": "statistical_recovery",
          "text": "Life 02从肺炎中慢慢恢复，能下床喝水，但身体还虚弱。"
        },
        {
          "year": 1985,
          "action": "vienna-elder-care.union-office/paperwork-blocked",
          "text": "Mitzi Winter 3用指节敲了敲表格上的空格，说这一栏空着不能办。Life 02攥着表格站在长凳旁，后面排队的人绕过他。"
        },
        {
          "year": 1985,
          "action": "vienna-life-old-age/family-care",
          "text": "邻居每天来看Life 02，带来面包和报纸。Life 02坐在窗边读讣告，认出几个旧同事的名字，把报纸折好放在桌上。"
        },
        {
          "year": 1986,
          "action": "vienna-elder-bereavement.empty-room/empty-room.lodger",
          "text": "泥瓦匠姓霍夫曼，靴子上有干了的灰浆。Life 02把旧箱子挪到墙角，铺上一条干净床单，又把Hermann 2送来的那罐果酱摆在桌上，说早上有面包。"
        },
        {
          "year": 1986,
          "action": "vienna-church-community.saint-vincent-box/box-request-granted",
          "text": "圣文生会的修女在登记簿上写下Friedrich Huber的门牌号，递过面包券和一小袋土豆。Life 02在旁边按了指印作保，说这户男人在工厂有活。"
        },
        {
          "year": 1987,
          "action": "statistical_death/old_age",
          "text": "Life 02在Leopoldstädter Zinshaus, gemeinsamer Gang的床上安静地停止呼吸。桌上还放着没吃完的药和一杯水，邻居早上来敲门时才发现。"
        }
      ]
