      "outcomes": [
        {
          "id": "card-trade",
          "weight": 1,
          "text": "{subject}蹲在烟草店门口，用三张攒下的烟画跟{neighbor}换了一张印着皇帝像的卡。{neighbor}接过三张，转身就进杂货铺，用皇帝像换了块糖。{subject}追到柜台边，只看见糖纸在{neighbor}手里发亮。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "换到喜欢的烟画"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": -0.02,
              "fear": 0,
              "reason": "换卡后发现对方转手换糖"
            }
          ],
          "narration": [
            {
              "id": "vienna-childhood-street.cigarette-card.card-trade.alt1",
