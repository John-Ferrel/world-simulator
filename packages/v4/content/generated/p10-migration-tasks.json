      }
    },
    {
      "id": "p10-migration-tasks.emigrate",
      "title": "领事馆门口的队伍",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 45
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "min": 30
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 45
        },
        {
          "key": "official",
          "kind": "official",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 60
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 25,
          "maxAge": 60
        }
      ],
      "tags": ["emigration", "passport", "ship"],
      "outcomes": [
        {
          "id": "emigrate-sell-and-sail",
          "weight": 1,
          "text": "他把木工工具和床架折价卖给旧货商，又找工友凑了几个克朗，才在领事馆交出出生证明、无犯罪记录和体检单，买下去的里雅斯特上船的统舱票。行李只剩一只箱子，检票员在票角打了孔，他把箱子抱在膝上坐了一夜。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -8,
              "reason": "补齐船票、护照手续费与体检单费用，已扣卖家具所得"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "票根攥在手里，终于能动身"
            },
            {
              "type": "condition",
              "personId": "$subject",
              "condition": "exhaustion",
              "add": true,
              "reason": "在统舱里抱着箱子坐了一整夜没有睡"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "去美国的船票加手续费一共一百多克朗，统舱最便宜",
              "confidence": 0.85,
              "sourceKind": "witnessed",
              "personId": "$official",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "emigrate-sell-and-sail",
              "text": "旧货商把床架往秤上一放，报了个数。工具他留了一套最顺手的，用旧布裹了三层。领事馆的窗户开得很高，队伍里有人咳嗽，有人把文件摊在膝盖上又看一遍。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "emigrate-sell-and-sail",
              "text": "的里雅斯特的码头有鱼腥味。检票员用钳子在票角夹了个圆孔，他捏着那只箱子，箱底还粘着维也纳的煤灰。邻座的老妇人分给他半块面包，他没说话，点了点头。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "emigrate-missing-paper",
          "weight": 1,
          "text": "窗口后的官员把他的出生证明推回来，说教区印章不清楚，要重开一份。他跑了两天教区办公室，船期已经过了，退票扣了二十克朗手续费。他把剩下的钱换成去汉堡的火车票，同乡说那边港口有更便宜的船。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -14,
              "reason": "退票手续费、去汉堡的火车票与两天排队住店"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "错过船期，证明没办成"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$official",
              "kind": "acquaintance",
              "trust": -0.03,
              "affection": -0.02,
              "obligation": 0,
              "fear": 0.03,
              "respect": 0.02,
              "reason": "被退回文件，觉得官员不肯多说一句"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "emigrate-missing-paper",
              "text": "官员把纸翻了个面，指给他看那枚模糊的紫印章，说下一份。他还没来得及问，身后的人已经挤了上来。教区办公室的门房说神父下午才回，他就在走廊的长凳上等到天黑。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "emigrate-missing-paper",
              "text": "退票窗口的女人用指甲刮了刮票根，扣下钱，从柜台底下推出几枚银币。他把钱摊在掌心数了一遍，正好够一张去汉堡的车票和两顿热汤。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "emigrate-hamburg-wait",
          "weight": 1,
          "text": "他到汉堡港时船位排到三个星期以后。他住进码头边的大通铺，白天帮人扛行李换几个铜板，钱一天天见少。第三个星期他听说还要再等，便把剩下的钱买了回维也纳的车票，箱子比来时轻了一半。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -11,
              "reason": "汉堡住店、吃饭与回维也纳的车票"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "通铺里拥挤潮湿，夜夜咳嗽"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.09,
              "reason": "走不成又折回，觉得白费了盘缠"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "汉堡港的船位要排好几个星期，大通铺一夜要几十赫勒",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$neighbor",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "emigrate-hamburg-wait",
              "text": "通铺里睡二十来个人，有人咳嗽，有人半夜数钱。他把箱子枕在头下，听着码头的汽笛一遍遍响。扛完一船行李，手心的铜板带着盐味。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "emigrate-hamburg-wait",
              "text": "售票处的男人说三个星期，语气像在说天气。他回到通铺把票钱摊在膝上反复数，最后留下回程那份。上火车那天，海风把外套吹得鼓起来，他没回头。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "migration",
        "goals": ["survival", "status"],
        "needs": ["cash", "autonomy"],
        "baseUtility": 1.5,
        "risk": 0.55,
        "skills": ["social", "numeracy"]
      }
    },
    {
      "id": "p10-migration-tasks.return-home",
      "title": "回乡的火车票",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 60
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "max": 40
        },
        {
          "kind": "employment",
          "employed": false
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 60
        },
        {
          "key": "brother",
          "kind": "sibling",
          "required": true,
          "minAge": 25,
          "maxAge": 60
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 25,
          "maxAge": 60
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 65
        }
      ],
      "tags": ["return", "train", "family"],
      "outcomes": [
        {
          "id": "return-ticket-bought",
          "weight": 1,
          "text": "他在南站买了一张三等车票，十二克朗四十赫勒，把木工工具留给了同屋的工友。车过布吕恩时换了一次车，哥哥站在站台上，手里拎着一壶水。第二天一早他就跟着下地，手上磨出了新泡。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -13,
              "reason": "回乡三等车票与路上买面包的钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.07,
              "reason": "哥哥在站台上等到了，心里落地"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$brother",
              "kind": "kin",
              "trust": 0.1,
              "affection": 0.08,
              "obligation": 0.08,
              "fear": 0,
              "respect": 0.05,
              "reason": "回乡投靠哥哥，一同下地干活"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "worked_in_vienna_factory",
              "add": true,
              "reason": "在城里工厂干过四年，手艺带回了乡下"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "return-ticket-bought",
              "text": "售票窗口递出车票，他把它夹在身份证里。同屋的工友摸着那套凿子说用得着，他摆摆手。火车开动时，维也纳的烟囱一截截退到窗框外面去。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "return-ticket-bought",
              "text": "哥哥穿一件洗得发白的短衫，站在站台尽头，看见他就把水壶举起来。地里的土还是凉的，他弯腰拔了半垄草，指甲缝里嵌进黑泥，倒比城里睡得踏实。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "return-stop-in-brno",
          "weight": 1,
          "text": "车票钱只够坐到布吕恩。他在车站帮人搬箱子、给旅馆跑腿，换了几顿饭和半张到家乡的票，晚上睡在候车室的长椅上。到家时靴底磨穿了一个洞，他拄着一根捡来的木棍走进院子。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -7,
              "reason": "到布吕恩的车票与半张后续车票"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "候车室过夜，靴底磨穿受了凉"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.04,
              "reason": "在布吕恩车站跟车夫和旅馆伙计讨价还价、换活计"
            },
            {
              "type": "condition",
              "personId": "$subject",
              "condition": "chilblains",
              "add": true,
              "reason": "穿磨穿的靴子在湿冷候车室过夜，脚上生了冻疮"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "return-stop-in-brno",
              "text": "布吕恩车站的灯泡昏黄，长椅上睡着三个候车的人。他把外套垫在头下，听见调车场的铁钩撞击声，一夜没合眼。天亮时他去问旅馆伙计要不要人搬箱子。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "return-stop-in-brno",
