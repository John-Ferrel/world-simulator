  "nodes": [
    {
      "id": "p9-social-daily-culture.last-standing-ticket",
      "title": "剧院顶层的最后一张站票",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 16,
          "max": 80
        },
        {
          "kind": "cash",
          "min": 1
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 16,
          "maxAge": 80
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 80
        }
      ],
      "outcomes": [
        {
          "id": "p9-social-daily-culture.last-standing-ticket.got-ticket",
          "weight": 1,
          "text": "{subject}挤到窗口前，把一克朗硬币推进凹槽，换回一张印着座号的薄纸片。顶层站席的栏杆被前面的人汗湿，{subject}侧身找了个能看见舞台边的位置，倚着烫手的铁栏看完两幕；散场时小腿发麻，嘴里还哼着刚听到的曲调，幕间也和邻座搭上了两句话。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "约瑟夫施塔特剧院顶层站票"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "在顶层站席看完两幕歌剧"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.03,
              "reason": "与邻座挤在栏杆边交谈"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.last-standing-ticket.got-ticket.alt1",
              "key": "p9-social-daily-culture.last-standing-ticket.got-ticket",
              "text": "窗口里的女人数出找零，指甲在铜板上敲了两下。{subject}把票叼在嘴里，腾出手系紧围巾，跟着人流从侧门绕上顶层，木楼梯吱呀作响。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-daily-culture.last-standing-ticket.got-ticket.alt2",
              "key": "p9-social-daily-culture.last-standing-ticket.got-ticket",
              "text": "幕间休息时，{neighbor}从楼下带上来半块面包，两人靠在栏杆上分着吃。剧院里热得发闷，{subject}解开领口，看见乐池里第一小提琴手正在擦汗。",
              "tone": ["tender"]
            }
          ]
        },
        {
          "id": "p9-social-daily-culture.last-standing-ticket.church-organ",
          "weight": 1,
          "text": "{subject}数了数前面攒动的人头，把口袋里的硬币又攥紧了些，转身离开队伍。走到街角的教堂时，管风琴正从敞开的门里传出来，{subject}在最后一排长凳上坐下，听完整段前奏曲，一个赫勒也没花，只跪得膝盖发酸。出门时与{neighbor}道了别，约好下回还来排队。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "在教堂听免费的管风琴"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.02,
              "reason": "与一同排队的邻居在教堂门口道别"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.last-standing-ticket.church-organ.alt1",
              "key": "p9-social-daily-culture.last-standing-ticket.church-organ",
              "text": "队伍末尾又挤上来两个穿工装的人，问窗口还剩几张。{subject}把位置让开，沿墙根走到教堂门前，石阶上落着几片梧桐叶，管风琴的低音震得门框发颤。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-daily-culture.last-standing-ticket.church-organ.alt2",
              "key": "p9-social-daily-culture.last-standing-ticket.church-organ",
              "text": "长凳上坐着几个同样没买到票的人，彼此并不交谈。{subject}盯着祭坛上摇晃的烛火，等最后一个和弦散尽才起身，口袋里那枚一克朗还带着体温。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "p9-social-daily-culture.last-standing-ticket.buy-for-elder",
          "weight": 1,
          "text": "前面的老人掏零钱时手抖得厉害，数了三遍也没凑够。{subject}替老人把四十赫勒递进窗口，老人连声道谢，硬塞回一枚十赫勒铜板。等{subject}自己买票时，窗口已经挂出“售罄”的牌子，只好站在剧院门廊下听里面隐约的乐声，脚底冰凉；这一趟净少三十赫勒，却让队伍里的人都记住了这份体面。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.4,
              "reason": "替排队的老人垫付站票钱"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 0.1,
              "reason": "老人硬塞回的铜板"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "在售票队伍里替老人垫钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "自己没买到票站在门廊下"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.last-standing-ticket.buy-for-elder.alt1",
              "key": "p9-social-daily-culture.last-standing-ticket.buy-for-elder",
              "text": "老人把找回的零钱一张张捋平，夹进一本磨破边的祈祷书里。{subject}没再往前挤，退到人行道上，看见{neighbor}从队尾探出头来，摊了摊手。",
              "tone": ["tender"]
            },
            {
              "id": "p9-social-daily-culture.last-standing-ticket.buy-for-elder.alt2",
              "key": "p9-social-daily-culture.last-standing-ticket.buy-for-elder",
              "text": "窗口里的女人拉下小铁帘，哗啦一声。{subject}倚着剧院的石柱，听见里面调音的弦声断断续续，直到开场铃响，才裹紧外套往家走。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "culture",
        "goals": ["rest", "belonging"],
        "needs": ["belonging", "status"],
        "baseUtility": 1.05,
        "risk": 0.05,
        "skills": ["social"]
      }
    },
    {
      "id": "p9-social-daily-culture.cafe-newspaper",
      "title": "咖啡馆窗边的第三杯 Melange",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 16,
          "max": 80
        },
        {
          "kind": "cash",
          "min": 1
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 16,
          "maxAge": 80
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 80
        }
      ],
      "outcomes": [
        {
          "id": "p9-social-daily-culture.cafe-newspaper.read-all",
          "weight": 1,
          "text": "{subject}把木架上的《新自由报》从头版读到讣告栏，中间续了两次水，第三杯 Melange 端上来时奶泡已经塌了，三杯一共六十赫勒。侍者把找零的铜板拍在桌上，没有催的意思；{subject}折好报纸夹回木架，记住了议会辩论里的两个名字，出门时雨还没停。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.6,
              "reason": "三杯 Melange 的咖啡钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "在咖啡馆读报消磨整个下午"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.03,
              "reason": "仔细阅读整份报纸"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.cafe-newspaper.read-all.alt1",
              "key": "p9-social-daily-culture.cafe-newspaper.read-all",
              "text": "窗玻璃上的水痕把电车拉成一条条歪斜的影子。{subject}用指头蘸着杯底的水，在桌面上划出铁路新线的走向，直到侍者过来添水才抹掉。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-daily-culture.cafe-newspaper.read-all.alt2",
              "key": "p9-social-daily-culture.cafe-newspaper.read-all",
              "text": "邻桌两个老头在争地方新闻，声音越来越大。{subject}把报纸翻到体育版，假装没听见，杯里的咖啡凉了也没叫人换热。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "p9-social-daily-culture.cafe-newspaper.talk-tram",
          "weight": 1,
          "text": "{subject}把报纸推到一边，和{neighbor}聊起电车票价要涨的传闻。两人拿过糖罐当算盘，在桌布上比划通勤开销，两杯咖啡四十赫勒，争论得忘了时间，直到窗外的煤气灯亮起来。{subject}起身时发现大衣下摆沾了咖啡渍，晚饭的点早过了，却约好下回还坐这张桌子。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.4,
              "reason": "两杯咖啡的价钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "在咖啡馆长谈电车票价"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "与邻桌聊得投机"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.cafe-newspaper.talk-tram.alt1",
              "key": "p9-social-daily-culture.cafe-newspaper.talk-tram",
              "text": "侍者把第三把椅子搬过来时，{neighbor}正拿方糖代表克朗，在桌面上排出一条线路图。{subject}用指尖拨弄糖块，嘴里念着月票的差价。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-daily-culture.cafe-newspaper.talk-tram.alt2",
              "key": "p9-social-daily-culture.cafe-newspaper.talk-tram",
              "text": "窗外一把黑伞底下两个人吵了起来，{subject}和{neighbor}停了话头看了一会儿。等再回到票价上，糖罐已经空了，账单压在杯托下面。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "p9-social-daily-culture.cafe-newspaper.give-seat",
          "weight": 1,
          "text": "{subject}只喝了半杯就看见门口站着等位的老主顾，手里转着帽子。{subject}把报纸叠好放回木架，起身让出窗边的位子，一杯 Melange 三十赫勒，侍者点头致意，没再收第二杯的钱。走出门时雨小了些，{subject}站在檐下理了理衣领，觉得这半个下午也不算白来。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.3,
              "reason": "一杯 Melange 的价钱"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "在咖啡馆主动给等位的人让座"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.02,
              "reason": "简短但体面的咖啡馆歇脚"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.cafe-newspaper.give-seat.alt1",
              "key": "p9-social-daily-culture.cafe-newspaper.give-seat",
              "text": "等位的人把湿伞靠在桌边，连声道谢。{subject}从衣钩上取下外套，袖口还带着咖啡馆里的暖气，推门时铜铃叮当响了一声。",
              "tone": ["tender"]
            },
            {
              "id": "p9-social-daily-culture.cafe-newspaper.give-seat.alt2",
              "key": "p9-social-daily-culture.cafe-newspaper.give-seat",
              "text": "侍者收拾杯子时朝{subject}的方向微微欠身。{subject}没看见，已经走到街对面，踩过一片积水，鞋底湿了半边。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "daily",
        "goals": ["rest", "belonging"],
        "needs": ["belonging", "status"],
        "baseUtility": 1,
        "risk": 0.05,
        "skills": ["social"]
      }
    },
    {
      "id": "p9-social-daily-culture.lending-library",
      "title": "借书处的押金",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 16,
          "max": 80
        },
        {
          "kind": "cash",
          "min": 2
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 16,
          "maxAge": 80
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": true,
          "minAge": 25,
          "maxAge": 70
        }
      ],
      "outcomes": [
        {
          "id": "p9-social-daily-culture.lending-library.pay-deposit",
          "weight": 1,
          "text": "{subject}从内袋里数出两克朗压在柜台上，{worker}翻开借书卡，用铅笔把上次迟还的四天圈出来，还是把小说递了过来。{subject}把书塞进外套里侧，出门就翻到第一页，边走边读，差点撞上推手推车的菜贩；两克朗换来的不只是一本小说，还有一整个下午的安静。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "租书店借小说的押金"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.05,
              "reason": "借阅小说并坚持阅读"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "借到想读的小说"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.lending-library.pay-deposit.alt1",
              "key": "p9-social-daily-culture.lending-library.pay-deposit",
              "text": "书架间只容一人侧身，{subject}的胳膊肘蹭过一排游记的书脊。{worker}把印章在借书卡上按了两下，墨色有点淡，又补按了一次。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-daily-culture.lending-library.pay-deposit.alt2",
              "key": "p9-social-daily-culture.lending-library.pay-deposit",
              "text": "铜板在柜台上排成一列，{worker}一枚枚拨进抽屉，嘴里念着迟还的规矩。{subject}没争辩，只把书抱在胸前，闻见旧纸和浆糊的味道。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "p9-social-daily-culture.lending-library.volksbibliothek",
          "weight": 1,
          "text": "{subject}听{worker}报出押金数目，把伸进内袋的手又抽了回来。问清免费阅览处的位置后，{subject}穿过两条街，在 Volksbibliothek 的阅览室门口登记了姓名，坐在长桌边读了一下午；一个赫勒没花，只是不能把书带回家，天黑前就得还回去。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "在免费阅览室读了一下午书"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.04,
              "reason": "在阅览室持续阅读"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.02,
              "reason": "向租书店管理员打听免费阅览处"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.lending-library.volksbibliothek.alt1",
              "key": "p9-social-daily-culture.lending-library.volksbibliothek",
              "text": "{worker}用铅笔尖点了点墙上的告示，说押金是店里的规矩，改不了。{subject}道了谢，出门右拐，沿电车轨道一直走到免费阅览室所在的街角。",
              "tone": ["bureaucratic"]
            },
            {
              "id": "p9-social-daily-culture.lending-library.volksbibliothek.alt2",
              "key": "p9-social-daily-culture.lending-library.volksbibliothek",
              "text": "阅览室里有人咳嗽，有人翻页，安静得能听见窗外马蹄声。{subject}把手表摘下来放在桌角，提醒自己关门前要赶上还书。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "p9-social-daily-culture.lending-library.read-in-aisle",
          "weight": 1,
          "text": "{subject}站在书架前抽出一本厚小说，就着门口的光读了半章，{worker}在柜台后抬起眼皮看了一眼，没说话。读到要紧处，{subject}摸出铅笔头把页码记在车票背面，把书插回原处，说下次带够押金再来；白读半章，管理员的眼神却凉了一点。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.02,
              "reason": "在书店书架前站着读书"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.02,
              "reason": "白读半章小说"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": -0.02,
              "reason": "在租书店白读未借被管理员看在眼里"
            }
          ],
          "narration": [
            {
              "id": "p9-social-daily-culture.lending-library.read-in-aisle.alt1",
              "key": "p9-social-daily-culture.lending-library.read-in-aisle",
              "text": "门口的光斜照进来，正好落在书页中间。{subject}用拇指压住书脊，怕书页自己合上，读到精彩处脚趾在鞋里蜷了一下。",
              "tone": ["tender"]
            },
            {
              "id": "p9-social-daily-culture.lending-library.read-in-aisle.alt2",
              "key": "p9-social-daily-culture.lending-library.read-in-aisle",
