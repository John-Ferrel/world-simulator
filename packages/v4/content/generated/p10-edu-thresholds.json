          "minAge": 35,
          "maxAge": 60
        }
      ],
      "tags": [
        "night_school",
        "bookkeeping",
        "fees"
      ],
      "outcomes": [
        {
          "id": "enrolled-absent",
          "weight": 2,
          "text": "{subject}交了一学期六克朗的学费，把课表用图钉钉在床头的墙上。第一周作坊加班到八点，他赶到第七区那间小学时教室已经熄灯，簿记课本第一课没听上。回来的路上电车已经收班，他走了四十分钟。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -6,
              "reason": "夜校一学期学费"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "报名商业夜校"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "加班后步行回家"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "第一周缺课"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "enrolled-absent",
              "text": "报名处的走廊里摆着几把椅子，他是倒数第二个交钱的。{teacher}把课表折好递过来，说缺课超过三次要重报。图钉扎进墙面时，床板在下面轻轻响了一声。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "enrolled-absent",
              "text": "作坊的钟走得快，八点五分他才放下工具。街上卖热栗子的摊子还没收，他捏着课本从旁边走过去。学校铁门已经锁上，门房隔着栅栏摆摆手，说下星期三早点来。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "fee-arrangement",
          "weight": 2,
          "text": "学费还差两克朗。{subject}在报名处门口等到{teacher}出来，把口袋里的零钱摊在窗台上数。老师说先交一半，剩下的替学校擦黑板、锁教室来抵。第二天晚上他揣着半张收据回家，边走边把收据折好。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -4,
              "reason": "先交一半夜校学费"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "以工抵费就读夜校"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": 0.08,
              "reason": "老师允准以打扫抵欠费"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "fee-arrangement",
              "text": "零钱里有六枚十赫勒的铜板，一枚五赫勒的已经磨得看不清字。{teacher}数完没有催他，只说走廊和黑板每天要擦。他点头时听见隔壁教室里有人在背书，声音隔着一层门板。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "fee-arrangement",
              "text": "擦黑板的抹布挂在窗钩上，粉笔灰落在袖口上发白。锁门的钥匙串比想象中沉，他攥在手里走了一段夜路。{parent}在门口等，问他收据呢，他把半张纸展开给她看。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "skip-night-school",
          "weight": 1,
          "text": "{subject}蹲在报名处外的台阶上算了一阵：一学期学费六克朗，等于一百多个计件活，晚上少干两个钟头就少挣一份钱。他把报名表折成四折带回家，压在碗柜的抽屉底下。第二天照样去上工。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "放弃夜校报名"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 3,
              "reason": "晚间多接计件活挣的钱"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "declined_night_school",
              "add": true,
              "reason": "把夜校报名表压进抽屉"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "skip-night-school",
              "text": "报名处门口有人进进出出，夹着新课本往外走。{subject}把手插在口袋里，看着一个熟识的{worker}进去又出来，手里多了张课表。他没喊人，转身沿着街沿往回走。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "skip-night-school",
              "text": "抽屉底下已经有几张旧纸，报名表压上去时翘起一角。晚饭是土豆和面包，{parent}问他报名的事，他说再看看吧。桌角的油灯快没油了，火苗跳了几下。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p10-edu-thresholds.apprentice-review",
      "title": "师傅的工作台前",
      "weight": 1,
      "rate": 0.0256,
      "conditions": [
        {
          "kind": "age",
          "min": 16,
          "max": 19
        },
        {
          "kind": "education",
          "in": [
            "apprenticeship"
          ]
        },
        {
          "kind": "employment",
          "employed": true
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 16,
          "maxAge": 19
        },
        {
          "key": "master",
          "kind": "worker",
          "required": true,
          "minAge": 40,
          "maxAge": 70
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 20,
          "maxAge": 40
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": false,
          "minAge": 35,
          "maxAge": 70
        }
      ],
      "tags": [
        "apprenticeship",
        "journeyman",
        "review"
      ],
      "outcomes": [
        {
          "id": "pass-review",
          "weight": 2,
          "text": "窗框四角榫接严丝合缝，{master}拿角尺量了两遍，在评语纸上写“可出师”。旁边的{worker}停下手里的刨子看了几眼。从下月起按伙计算工钱，考核费两克朗已付清，材料费从工钱里扣。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.08,
              "reason": "榫接活通过考核"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.1,
              "reason": "师傅评语写可出师"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "出师考核费"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$master",
              "kind": "employer",
              "trust": 0.1,
              "obligation": 0.05,
              "reason": "师傅认可出师"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 2,
              "reason": "passed the journeyman review"
            },
            {
              "type": "role",
              "personId": "$subject",
              "role": "journeyman",
              "add": true,
              "reason": "qualified as a journeyman"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "qualified_journeyman",
              "add": true,
              "reason": "passed the trade review"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "pass-review",
              "text": "工作台挪到屋子中央，周围腾出一圈空地。{subject}落榫时屏住气，木槌敲下去的声音又闷又准。{master}俯身看四角，用指甲刮了一下接缝，没找到能塞进纸片的地方。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "pass-review",
              "text": "评语纸上的字是钢笔写的，笔锋往下压。{master}把纸推过来时手背上的墨渍还没干。下工前{worker}过来看了看窗框，说了一句“干得不错”，声音压在刨床的响声里。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "splinter-redo",
          "weight": 2,
          "text": "一记榫头敲下去，木料沿着纹理裂开一道口子。{master}盯着裂口看了很久，让他再做一件，出师推迟三个月。师兄弟{worker}递来新料，没多说话。作坊里的钟滴答作响，碎木屑踩在脚下像细沙。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.18,
              "reason": "敲裂木料出师推迟"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.03,
              "reason": "重做一件活多练了手艺"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$master",
              "kind": "employer",
              "trust": -0.06,
              "reason": "师傅对他多了一层失望"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "journeyman_exam_postponed",
              "add": true,
              "reason": "qualification postponed by the master"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "splinter-redo",
              "text": "裂口从榫眼一直拉到边缘，像一条干了的河。{master}用手指抹过断面，抬起眼来说，重做，三个月后再看。旁边的{worker}把破料捡起来，扔进柴箱。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "master-holds-back",
          "weight": 1,
          "text": "他做的活合格，角度和接缝都挑不出毛病。{master}看完却说作坊缺人手，出师证明要等明年，眼下按学徒的工钱照旧。{subject}把工具一件件擦干净放回架上，没说留下也没说不留。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.2,
              "reason": "活合格却被压着不放"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "手艺得到认可"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "师傅把出师证明扣到明年，想把他的手艺留在作坊里",
              "confidence": 0.8,
              "sourceKind": "witnessed",
              "personId": "$master",
              "visibility": "private",
              "trueInWorld": true
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "journeyman_exam_postponed",
              "add": true,
              "reason": "qualification postponed by the master"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "master-holds-back",
              "text": "工作台上的窗框还立着，{master}隔了半天才开口。巷子里有人来问今天能不能交活，{worker}出去回了话，门开时带进一股凉风。{subject}手里的抹布已经擦到只剩一层薄木屑。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "master-holds-back",
              "text": "评语纸摊在柜台上，最后一行没有落笔。{master}说等他再想想，把纸收进抽屉里锁了。晚上{subject}没直接回家，在桥边站了一会儿，口袋里的角尺硌着大腿。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p10-edu-thresholds.technische-hochschule-entrance",
      "title": "技术学院门口的报名桌",
      "weight": 1,
      "rate": 0.0272,
      "conditions": [
        {
          "kind": "age",
          "min": 17,
          "max": 20
        },
        {
          "kind": "education",
