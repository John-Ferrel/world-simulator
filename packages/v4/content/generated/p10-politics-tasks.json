    {
      "id": "p10-politics-tasks.join-union",
      "title": "活动室门口的两张桌子",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 65
        },
        {
          "kind": "employment",
          "employed": true
        },
        {
          "kind": "placeKind",
          "in": [
            "factory",
            "union"
          ]
        },
        {
          "kind": "notHasRole",
          "role": "union_member"
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "unionMember",
          "kind": "union_member",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "union",
          "kind": "organization",
          "required": true,
          "organizationKind": "union"
        },
        {
          "key": "party",
          "kind": "organization",
          "required": false,
          "organizationKind": "party"
        }
      ],
      "tags": [
        "union",
        "party",
        "membership"
      ],
      "outcomes": [
        {
          "id": "p10-join-union-register",
          "weight": 1,
          "text": "他俯身在蓝皮会员册上写下姓名和车间，又数出六十赫勒交第一个月会费，收据带着油墨味。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.6,
              "reason": "第一个月工会会费"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "在工会活动室正式登记入会"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$unionMember",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "介绍人担保他入会"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-join-union-register",
              "text": "他把笔尖在墨水瓶口刮了两下，{unionMember}在介绍人一栏敲了敲手指；墙角有人压低声音念罢工基金账目上的欠款。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-join-union-register",
              "text": "收据撕下来时还黏着手；{unionMember}把蓝皮册子合上，说下星期三带三个月会费来核一遍，别把纸弄丢。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-join-union-wait",
          "weight": 0.8,
          "text": "介绍人那晚没来，他坐在后排发潮的木凳上听完会费说明，把表格折好揣回口袋。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "空等了一场，入会没办成"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "工会入会需要介绍人签字，并连续三个月交会费",
              "confidence": 0.8,
              "sourceKind": "witnessed",
              "personId": "$unionMember",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-join-union-wait",
              "text": "门缝里透进煤气路灯的黄光，{unionMember}在桌前翻名单，说担保人今晚夜班，表格只能先压着。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-join-union-wait",
              "text": "他把没填完的入会表夹进面包袋，走出{union}时听见隔壁{party}的门里有人在念请愿书，字句断断续续。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-join-union-party",
          "weight": 0.7,
          "text": "他没在工会桌前停下，拐进隔壁党部问入党手续，花两赫勒买了本小册子，被叮嘱周末来听讲。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.02,
              "reason": "买一本党部小册子"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "contacted_party",
              "add": true,
              "reason": "向党部询问入党手续"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "隔壁党部周末有讲演，入党要两名党员介绍",
              "confidence": 0.7,
              "sourceKind": "witnessed",
              "personId": "$unionMember",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-join-union-party",
              "text": "小册子封面上的人像印得发糊，他付了二赫勒，把它塞进外套内袋，没再回头看工会那张空着的椅子。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-join-union-party",
              "text": "党部屋里的人让他坐在靠墙的凳子上，念了半页章程；他出来时街上卖栗子的炉子正冒着白烟。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
        "domain": "politics",
        "goals": [
          "cause",
          "belonging"
        ],
        "needs": [
          "belonging",
          "safety"
        ],
        "baseUtility": 1.3,
        "risk": 0.3,
        "skills": [
          "social",
          "literacy"
        ]
      }
    },
    {
      "id": "p10-politics-tasks.organize-meeting",
      "title": "借来的后屋和三十把椅子",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 20,
          "max": 65
        },
        {
          "kind": "hasRole",
          "role": "union_member"
        },
        {
          "kind": "placeKind",
          "in": [
            "factory",
            "union",
            "other"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 20,
          "maxAge": 65
        },
        {
          "key": "unionMember",
          "kind": "union_member",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "innkeeper",
          "kind": "neighbor",
          "required": true,
          "minAge": 35,
          "maxAge": 70
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 65
        }
      ],
      "tags": [
        "meeting",
        "organization",
        "union"
      ],
      "outcomes": [
        {
          "id": "p10-organize-meeting-success",
          "weight": 1,
          "text": "后屋挤满了人，{innkeeper}最后只收了两克朗场地费；会议通过了缩短工时和承认工会的动议。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "付酒馆后屋场地费"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.07,
              "reason": "主持了车间会议并通过动议"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$unionMember",
              "kind": "colleague",
              "trust": 0.06,
              "reason": "一起把会议记录整理寄出"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-organize-meeting-success",
              "text": "椅子不够，有人靠着啤酒桶站；记录本摊在桌上，他把三十多人的签名念了一遍，才让{unionMember}把信寄给工会。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-organize-meeting-success",
              "text": "会后{innkeeper}用抹布擦着桌面，嘴里念叨酒钱还没结；窗外院子里冻着的石板路反着灯光。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-organize-meeting-walkout",
          "weight": 0.8,
          "text": "{innkeeper}临到傍晚反悔，说房东不准借地方，他们只好在院子里站着开会，来的人少了一半。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "会议被场地问题打散"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "只到一半人的会议没能通过加薪动议"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$innkeeper",
              "kind": "acquaintance",
              "trust": -0.05,
              "reason": "酒馆老板临时收回后屋"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-organize-meeting-walkout",
              "text": "院子里站着十几个人，风把帽子吹得斜了；{unionMember}把动议纸折了又折，最后只念了半页。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-organize-meeting-walkout",
              "text": "{innkeeper}堵在后屋门前说不行，大家只好散到路灯下；有人骂了一句，跺着脚回去了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-organize-meeting-police",
          "weight": 0.7,
          "text": "街对面站着两个戴头盔的警察，说话的都压低嗓子；记录里只写会费和互助金，动议没有落笔。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "会议在警察监视下缩了水"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "watched_by_police",
              "add": true,
              "reason": "开会时被警察记下活动"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "会议当晚街对面有警察记录进出人数",
              "confidence": 0.75,
              "sourceKind": "witnessed",
              "personId": "$official",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-organize-meeting-police",
              "text": "他把记录本翻到只有会费那一页，{unionMember}点头没说话；外面的脚步声在门前停了一会儿又走开。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-organize-meeting-police",
              "text": "有人从窗缝看出去，说街角那两个人换了位置；{innkeeper}把酒杯收得很快，说打烊了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
