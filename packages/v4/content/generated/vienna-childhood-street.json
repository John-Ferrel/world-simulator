      "conditions": [
        {
          "kind": "age",
          "min": 6,
          "max": 11
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 6,
          "maxAge": 11
        },
        {
          "key": "mother",
          "kind": "parent",
          "required": true,
          "minAge": 28,
          "maxAge": 50
        }
      ],
      "outcomes": [
        {
          "id": "errand-ok",
          "weight": 1,
          "text": "{subject}攥着母亲给的铜板在纳旭市场买回一磅土豆和一小包盐，路上没让土豆滚出围裙。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 2,
              "reason": "买回土豆和盐"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.15,
              "reason": "市场花销"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$mother",
              "kind": "kin",
              "trust": 0.08,
              "fear": 0,
              "reason": "跑腿办妥，母亲更放心"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "errand-ok",
              "text": "土豆从围裙兜里滚到市场台阶上，{subject}用下巴抵住围裙才没让它们继续跑。回家时母亲正把汤锅从炉子上端下来。",
              "tone": [
                "dry",
                "warm"
              ]
            },
            {
              "id": "alt",
              "key": "errand-ok",
              "text": "卖土豆的女人多塞了一颗小洋葱，说{subject}数铜板数得清楚。母亲把洋葱切成四瓣扔进汤里，没问多出来的是哪来的。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "errand-lost-coin",
          "weight": 1,
          "text": "{subject}在菜摊前蹲下捡滚落的土豆时，一枚铜板从指缝滑进排水格栅，母亲晚上数钱时少了三枚克鲁泽。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.3,
              "reason": "铜板掉进下水道"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$mother",
              "kind": "kin",
              "trust": -0.05,
              "fear": 0.08,
              "reason": "丢钱后母亲数落"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "弄丢铜板"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "errand-lost-coin",
              "text": "铜板在格栅上转了两圈就不见了。{subject}趴在地上看黑乎乎的排水沟，卖菜的女人说别看了，回家跟你妈说清楚。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "errand-lost-coin",
              "text": "母亲把围裙口袋翻过来抖了抖，三枚克鲁泽的缺口对不上。{subject}盯着地板缝，听见母亲说明天土豆少买半磅。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "errand-bullied",
          "weight": 1,
          "text": "两个大孩子堵在市场拱廊下，把{subject}的围裙带子系在柱子上，街上一个更大的孩子路过时用削土豆的小刀割开了结。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.1,
              "fear": -0.05,
              "reason": "邻居帮忙解围"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "被大孩子欺负"
            },
            {
              "type": "condition",
              "personId": "$subject",
              "condition": "bruised_shoulder",
              "severity": 0.03,
              "reason": "被推搡时肩膀撞到柱子"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "errand-bullied",
              "text": "围裙带子被系在拱廊柱上，{subject}的土豆撒了一地。街上一个更大的孩子从人群里挤过来，小刀一挑，结就松了。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "errand-bullied",
              "text": "大孩子笑着走开，{subject}蹲着捡土豆，肩膀火辣辣的。街上一个更大的孩子把最后一颗土豆踢回围裙里，说以后走肉铺那条巷子。",
              "tone": [
                "dry",
                "warm"
              ]
            }
          ]
        }
      ]
    },
