      "tags": [
        "unemployment",
        "factory",
        "hiring"
      ],
      "outcomes": [
        {
          "id": "gate-name-taken",
          "weight": 2,
          "text": "门房把{subject}的名字写进本子，说第二天带身份证件和住址证明来，录不录用还得看{employer}的意思。{subject}走出几步又回头，问清要几张证明，门房不耐烦地敲了敲玻璃。",
          "effects": [
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "factory_callback",
              "add": true,
              "reason": "工厂门房登记了名字"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "拿到次日复试机会"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gate-name-taken",
              "text": "玻璃后面的招工纸被门房用尺子压平，{subject}的名字写在横线本上，墨迹歪着。旁边的{worker}凑过来看了一眼，说这厂子去年也招过两回，录用的多半是厂里老人的亲戚。"
            },
            {
              "id": "alt",
              "key": "gate-name-taken",
              "text": "门房问会不会写字，{subject}说会，他就把本子推出来让{subject}自己写。写完他扫了一眼，说证件带齐，别像上回那人拿张教堂的纸条来糊弄。"
            }
          ]
        },
        {
          "id": "gate-queue-clash",
          "weight": 1,
          "text": "{subject}挤到前面报了名字，后面的人立刻嚷嚷起来，说排队得有个先后。门房把本子一合，说都走都走，今天不记了。{official}从台阶下过来维持秩序，人群才慢慢散开，招工纸还压在玻璃后面。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "插队报名字引起争执"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "招工登记被一并取消"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gate-queue-clash",
              "text": "前面的人贴得太紧，{subject}侧身挤到铁栅栏边刚开口，一个抱孩子的女人先骂了起来。门房敲着玻璃喊安静，最后索性把本子收进抽屉，说改天再来。"
            },
            {
              "id": "alt",
              "key": "gate-queue-clash",
              "text": "招工纸上的工钱写得明白，一天三克朗八十赫勒。{subject}怕再等下去名额没了，从人缝里挤到前面，后面的{worker}一把拽住袖子。门房抬头看了看乱糟糟的队伍，把玻璃窗拉上了。"
            }
          ]
        },
        {
          "id": "gate-price-check",
          "weight": 1,
          "text": "{subject}凑近玻璃把招工纸读完，发现工钱比巷子里传的少了一克朗，还要自备围裙和手套。身后的人还在往前挤，{subject}退出来，沿街往下一家作坊走，把招工纸的事丢在厂门口。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.01,
              "reason": "招工条件不如传言"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "seeking_work",
              "add": true,
              "reason": "继续沿街找活"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gate-price-check",
              "text": "招工纸上用小字写着工钱和自备物件，{subject}在心里算了算，围裙加手套差不多要一克朗，头一个月等于白干几天。{worker}还在门房跟前争，{subject}已经顺着街沿走远了。"
            },
            {
              "id": "alt",
              "key": "gate-price-check",
              "text": "玻璃后面的纸上盖着红章，工钱一栏被涂改过。{subject}问门房怎么回事，他说按纸上的算，嫌少就别来。街角的面包房正卸面粉，{subject}走过去问要不要帮工。"
            }
          ]
        }
      ]
    },
    {
