        {
          "id": "overtime-wage-scuffle.pressed",
          "weight": 1,
          "text": "{subject}把加班的时辰记在排字房墙角的粉笔账上，{worker}带头去跟{employer}对账。{employer}看着粉笔印沉默一会儿，多补了两个克朗，但把{subject}的名字从下月的正式工候选名单上划掉，扔回学徒组。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 2,
              "reason": "对账后补发的加班钱"
            },
