        {
          "key": "teacher",
          "kind": "teacher",
          "required": false,
          "minAge": 25,
          "maxAge": 65
        }
      ],
      "outcomes": [
        {
          "id": "took-factory-job",
          "weight": 2,
          "text": "{subject}把听课证从桌上拿起来，放进床头抽屉，跟{parent}说明年再报。第二天他穿上围裙去印刷厂上工，第一周工钱十八克朗，拿在手里比想象中薄。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "印刷厂杂工",
              "wage": 18,
              "workplaceId": "$workplace",
              "reason": "正式受雇于印刷厂"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 18,
              "reason": "第一周工钱"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "deferred_school_for_work",
              "add": true,
              "reason": "为工作推迟入学"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.05,
              "respect": 0.04,
              "reason": "听从家庭安排先挣钱"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "took-factory-job",
              "text": "{parent}把工钱袋上的绳结解开，数出买菜和煤的份，剩下的放回桌上。{subject}把听课证压在抽屉最底下，上面还沾着报名处的油墨味。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "took-factory-job",
              "text": "上工第一天，{employer}让他先扫机器底下的纸屑。他扫到中午，腰弯得发酸，口袋里那张听课证硬邦邦地硌着大腿。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "chose-night-school",
          "weight": 2,
          "text": "{subject}把工钱袋推回去，说夜班课已交过费。白天他接零活，给面包房送两趟货，工钱比正式工少了一半。晚上坐在教室里，手指还带着面粉味，握笔时总打滑。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "选择继续夜校课程"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 9,
              "reason": "白天零工一周所得"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "白天干活晚上上课，休息不足"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "night_school_priority",
              "add": true,
              "reason": "优先保住夜校学业"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": -0.05,
              "reason": "拒绝正式工作让母亲担忧"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "chose-night-school",
              "text": "{parent}把两份纸又摆了一遍，{subject}只拿起听课证。母亲没再说话，把工钱袋收进围裙口袋，转身去捅炉子。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "chose-night-school",
              "text": "夜校教室的凳子腿长短不齐，{subject}用折起的课程表垫在下面。老师在黑板上写算式，他低头记下，面粉从袖口簌簌落在本子上。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "negotiated-half-week",
          "weight": 1,
          "text": "{subject}去找{employer}，问能不能每周少上一天工，用那天去听课。厂主翻了翻排班表，说少一天就少一天的工钱，活儿不等人。少年答应了，每周四去教室，回来再补夜班。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "印刷厂杂工",
              "wage": 15,
              "workplaceId": "$workplace",
              "reason": "协商减少工时以就读夜校"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 15,
              "reason": "每周工钱减少后的收入"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "半工半读注册课程"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$employer",
              "kind": "employer",
              "trust": 0.06,
              "reason": "厂主同意弹性排班"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "周四上课后回厂补活"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "negotiated-half-week",
              "text": "{employer}用铅笔尖戳着排班表上星期四那一格，说缺的活计要他自己找时间补。{subject}点头，把课程表折成小方块放进工装口袋。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "negotiated-half-week",
              "text": "星期四下午他坐在教室最后一排，隔壁工位的油墨味还没洗掉。老师在讲比例尺，他低头画图，手指关节上沾着黑边。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "education",
        "goals": ["family", "status"],
        "needs": ["autonomy", "status"],
        "baseUtility": 1.5,
        "risk": 0.35,
        "skills": ["numeracy", "social"]
      }
    },
    {
      "id": "p9-childhood-youth-aspiration.join-a-club",
      "title": "工人青年会的门",
      "weight": 0.9,
      "rate": 0.07,
      "conditions": [
        {
          "kind": "age",
          "min": 14,
          "max": 17
        },
        {
          "kind": "cash",
          "min": 1
        },
        {
          "kind": "placeKind",
          "in": ["union", "street", "home"]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 14,
          "maxAge": 17
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 16,
          "maxAge": 25
        },
        {
          "key": "workersYouth",
          "kind": "organization",
          "required": true,
          "organizationKind": "union"
        }
      ],
      "outcomes": [
        {
          "id": "joined-and-borrowed",
          "weight": 2,
          "text": "{subject}跟着{neighbor}走进印刷厂后面的屋子，交了十赫勒会费，在借书簿上按了手印。他挑了一本讲蒸汽机的册子，封面烫金已经磨掉；管理员说下月十赫勒要按时交，书才能续借。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.1,
              "reason": "工人青年会月费"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.03,
              "reason": "阅读蒸汽机原理小册"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.08,
              "reason": "邻居带他加入青年会"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "workers_youth_member",
              "add": true,
              "reason": "成为工人青年会会员"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "找到可以借书的地方"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "joined-and-borrowed",
              "text": "屋里烧着铁炉，{neighbor}把会费交给靠门坐的人。{subject}在借书簿上按手印时，指腹沾了印泥，翻书页留下浅红痕迹。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "joined-and-borrowed",
              "text": "墙边有人在摆棋，有人哼歌本上的曲子。{subject}把蒸汽机册子塞进外套内袋，出门时{neighbor}说下周有读书会，记得带铅笔。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "went-once-and-left",
          "weight": 2,
          "text": "{subject}交了第一个月的会费，进去坐了一刻钟。屋里太吵，下棋的争论盖过了念书的声音，他借的书也被人翻得卷了边。下个月他路过门口，没再进去交十赫勒。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.1,
              "reason": "只交了一个月会费"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": -0.03,
              "reason": "没再去青年会，邻居有些失望"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "workers_youth_quit",
              "add": true,
              "reason": "退出工人青年会活动"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "觉得会里太吵不适合读书"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "went-once-and-left",
              "text": "铁炉边的长凳坐满了人，{subject}把借来的书摊在膝上，旁边两个人在为一盘棋高声争。他把书合上，又坐了一会儿才走。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "went-once-and-left",
              "text": "第二个月{neighbor}在楼梯口问他怎么没来，{subject}说晚上要帮家里干活。邻居点点头，把歌本夹在腋下先走了。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "worked-for-dues",
          "weight": 1,
          "text": "{subject}翻遍口袋只有几枚赫勒，便跟管事的说愿替大家抄歌本抵会费。他坐在窗边抄了一下午，手指被墨水染黑，换来的借书权让他捧回一本讲齿轮的旧书，书页里夹着上一个人留下的铅笔字。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.03,
              "reason": "抄写歌本练习书写"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.02,
              "reason": "阅读齿轮原理旧书"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.05,
              "reason": "邻居介绍他以工抵费"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "workers_youth_work_trade",
              "add": true,
              "reason": "以抄歌本换取借书资格"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "靠劳动换来借书机会"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "worked-for-dues",
              "text": "歌本纸是粗的，{subject}的钢笔尖刮起毛边。管事的看了看他抄的谱子，说行，那本齿轮书先借你两星期。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "worked-for-dues",
              "text": "抄到最后一页时天已经暗了，{neighbor}给他端来一杯温水。他把齿轮书卷进外套，出门时闻见纸页上的旧烟味。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "social",
        "goals": ["belonging", "status"],
        "needs": ["belonging", "status"],
        "baseUtility": 1.15,
        "risk": 0.15,
        "skills": ["social"]
      }
    },
    {
      "id": "p9-childhood-youth-aspiration.prepare-exam",
      "title": "考试前夜的煤油灯",
      "weight": 1,
      "rate": 0.09,
      "conditions": [
        {
          "kind": "age",
          "min": 14,
          "max": 17
        },
        {
          "kind": "education",
          "in": ["primary", "apprenticeship"]
        },
        {
          "kind": "health",
          "min": 0.4
        },
        {
          "kind": "placeKind",
          "in": ["home"]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 14,
          "maxAge": 17
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": false,
          "minAge": 25,
          "maxAge": 65
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": false,
          "minAge": 30,
          "maxAge": 55
        }
      ],
      "outcomes": [
        {
          "id": "studied-late-passed",
          "weight": 2,
          "text": "{subject}把煤油灯芯捻到最亮，复习算术到后半夜，德文作文列了三段提纲。第二天考场上算错一道比例题，但短文写得清楚，{teacher}收卷时多看了他两眼。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "通过入学考试"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.04,
              "reason": "算术考试练习"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.04,
              "reason": "德文短文写作"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "熬夜复习，睡眠不足"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "考试通过"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "studied-late-passed",
              "text": "灯罩上熏出黑圈，{subject}把面包屑扫到桌角，在草稿纸上重算第三遍。天快亮时他趴在桌上眯了一会儿，醒来发现袖口沾了墨。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "studied-late-passed",
              "text": "考场上他坐在靠窗第二排，题目里的数字比昨晚练的简单。短文写完还剩一刻钟，他检查了两遍，把比例那道题空着交了上去。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "oil-ran-out-slept-in-exam",
          "weight": 2,
          "text": "煤油烧到一半时灯芯冒起黑烟，{subject}只好借面包房后窗透出的光背公式。后半夜他靠在墙上睡着了，醒来已经七点。考场上脑子发沉，算术卷子只答了一半，{teacher}收卷时敲了敲桌面。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "熬夜且睡眠不足"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "考试未答完"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "failed_entrance_exam",
              "add": true,
              "reason": "入学考试未通过"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": -0.04,
              "reason": "教师对考试表现失望"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "oil-ran-out-slept-in-exam",
              "text": "{subject}把空煤油灯推到桌角，窗外面包房的炉火还亮着。他攥着铅笔背公式，声音越来越低，最后额头抵在摊开的算术本上。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "oil-ran-out-slept-in-exam",
              "text": "考场里他看题看了两遍才认出比例符号。交卷铃响时他还在算最后两道，{teacher}把卷子从他手边抽走，纸角划了一下他的指节。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "cheat-sheet-washed-off",
          "weight": 1,
          "text": "{subject}把公式用铅笔写在左手心，出门前在水龙头下搓了搓，字迹只剩浅浅灰印。考场上他凭记忆答题，算到第三题时手心出汗，灰印化开成一道黑线。他答完了，但不知道对不对。",
          "effects": [
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "exam_guilt",
              "add": true,
              "reason": "带小抄进考场后又洗掉"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "心里不踏实"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.02,
              "reason": "靠记忆完成算术题"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.02,
              "reason": "母亲察觉到他的心不在焉"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cheat-sheet-washed-off",
              "text": "水龙头的水冰凉，{subject}搓手心时听见母亲在屋里喊他吃早饭。他把手在裤子上擦干，掌纹里还嵌着铅笔灰。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "cheat-sheet-washed-off",
              "text": "考到一半他低头看手，灰印糊成一片。他索性不再看，把演算纸写得满满的，交卷后一个人在走廊里站了很久。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "education",
        "goals": ["knowledge", "status"],
        "needs": ["knowledge", "autonomy"],
        "baseUtility": 1.3,
        "risk": 0.2,
        "skills": ["literacy", "numeracy"]
      }
    }
  ]
}
