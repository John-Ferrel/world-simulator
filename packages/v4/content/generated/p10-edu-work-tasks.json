    {
      "id": "p10-edu-work-tasks.ask-promotion",
      "title": "厂长办公室外的半小时",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 20,
          "max": 30
        },
        {
          "kind": "employment",
          "employed": true
        },
        {
