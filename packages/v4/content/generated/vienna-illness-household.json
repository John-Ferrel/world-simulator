          "narration": [
            {
              "id": "default",
              "key": "neighbor-help-night",
              "text": "{neighbor}听见动静，端来热水和药片，替{subject}守了半宿。天亮{child}退了烧，{subject}把半块面包送了过去。",
              "tone": [
