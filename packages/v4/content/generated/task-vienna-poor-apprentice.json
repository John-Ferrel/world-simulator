      "outcomes": [
        {
          "id": "cover-shift-overtime-pay",
          "weight": 1,
          "text": "他顶完后半班，工头按钟点多给了两克朗加班费。回家时手指抖得端不住汤碗，母亲把碗推到他跟前，他先摸出硬币放在桌上。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 2,
              "reason": "顶班拿到加班费"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "连班后手指发抖浑身发虚"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sickWorker",
              "kind": "colleague",
              "trust": 0.08,
              "affection": 0.02,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0.04,
              "reason": "替病倒的工友顶了班"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "cover-shift-overtime-pay",
              "text": "机器一直转到晚上八点。他把两克朗加班费摊在桌上，母亲盛汤的手停了停，他的手指还在抖。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "cover-shift-overtime-pay",
              "text": "顶完班，他把油墨擦了两遍才敢拿碗。汤碗在手里晃，他先低头把硬币推到桌心。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "foreman-promises-rest-forgets",
          "weight": 1,
          "text": "工头答应下星期补他半天休，到了下星期却装作忘了，只在他问时含糊说以后一并算。他站回机器旁，加班费也没提，气存在胸口里没处放。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.07,
              "reason": "补休被工头赖掉"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$foreman",
              "kind": "colleague",
              "trust": -0.06,
              "affection": 0,
              "obligation": -0.03,
              "fear": 0.02,
              "respect": 0,
              "reason": "工头食言不认补休"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "foreman-promises-rest-forgets",
              "text": "星期一他提了半句，工头说以后一并算，转身去查纸单。机器声里他把后半句咽回去。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "foreman-promises-rest-forgets",
              "text": "补休的事没人再提，排班表上他的班还是照旧。他把抹布拧干挂好，胸口那股气下不去。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "sick-worker-asks-errand",
          "weight": 1,
          "text": "病倒的工友不要他替班，只求他顺路去药房买一包退烧药。他花十二赫勒买了药，又爬上三层楼送到病友家门口，回来时晚饭已经凉了。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.6,
              "reason": "替病友买退烧药"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "绕路爬楼回去误了晚饭"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sickWorker",
              "kind": "colleague",
              "trust": 0.09,
              "affection": 0.04,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0.03,
              "reason": "替病友跑腿买药"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "sick-worker-asks-errand",
              "text": "药房伙计从木格子里夹出一包药粉，收十二赫勒。他爬上三层楼，把纸包从门缝递进去，听见里面咳了两声。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "sick-worker-asks-errand",
              "text": "回来时家里汤已经凉了，母亲问怎么晚这么久。他把空了的药房纸袋折起，没多解释。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
