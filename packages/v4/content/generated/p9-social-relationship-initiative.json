  "nodes": [
    {
      "id": "p9-social-relationship-initiative.invite-to-theatre",
      "title": "请人去看星期天的轻歌剧",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 17,
          "max": 45
        },
        {
          "kind": "notHasRelation",
          "relationKind": "partner"
        },
        {
          "kind": "cash",
          "min": 3
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 17,
          "maxAge": 45
        },
        {
          "key": "partner",
          "kind": "partner",
          "required": true,
          "minAge": 17,
          "maxAge": 45
        },
        {
          "key": "friend",
          "kind": "neighbor",
          "required": false,
          "minAge": 17,
          "maxAge": 45
        }
      ],
      "outcomes": [
        {
          "id": "two-gallery-tickets",
          "weight": 1,
          "text": "在柜台前把话问出口，对方愣了一下，说星期天下午可以。两张楼座票一共两克朗二十赫勒，约在剧院侧门前见。对方把那叠乐谱往旁边推了推，说散场后可以沿环城道走一段。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2.2,
              "reason": "两张星期天轻歌剧楼座票"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$partner",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.06,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0.02,
              "reason": "一起看了一场轻歌剧，散场后沿环城道走了半圈"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "开口成功，星期天有了着落"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "two-gallery-tickets",
              "text": "有人把两张楼座票压在柜台边的玻璃板上，说侧门见。对方低头看了看票根上的排号，把包乐谱的麻绳又绕了一圈，说到时候别迟到。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "two-gallery-tickets",
              "text": "散场时楼座的木栏杆还嗡嗡响，两人跟着人流往下挤。有人问下次还来不来，对方把披肩往上拉了拉，说看情况，先记着这个星期天。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "walk-instead-of-tickets",
          "weight": 1,
          "text": "票在口袋里被手指捏出折痕，话到嘴边却改成了请对方沿多瑙运河走一段。两人从桥下走到水闸，买了两只热栗子，一共十六赫勒。剧院的事谁也没有提起，票根还留在外套内袋里。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.32,
              "reason": "两只热栗子和来回电车"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$partner",
              "kind": "acquaintance",
              "trust": 0.04,
              "affection": 0.03,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "在运河边走了半个下午，话不多但彼此不别扭"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "没敢提剧院的事，回家路上有点懊恼"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "walk-instead-of-tickets",
              "text": "水面上有煤驳的油气，对方把围巾压在下巴底下，说天气再冷就不好走了。有人在口袋里摸到那两张硬纸片，最终只摸出了买栗子的硬币。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "walk-instead-of-tickets",
              "text": "走到水闸时天已经暗下来，对方说该回去给炉子添煤了。有人站在桥头看了一会儿水面，把外套内袋里的票根又按平了一次。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "unsigned-note",
          "weight": 1,
          "text": "开口成了问路，对方指完方向就转身去整理那叠乐谱。当晚有人坐在租来的房间里，把一张信纸写了撕、撕了写，最后只剩一句“星期天下午剧院有楼座”，没有署名，信封上写了书店的地址，邮票六赫勒。第二天投进街角的邮筒，此后三天经过书店都绕着走。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.12,
              "reason": "邮票和信纸"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "话没出口，只寄出一张没署名的便条"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$partner",
              "kind": "acquaintance",
              "trust": 0.01,
              "affection": 0.01,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "一张没有回音的便条，关系停在点头之交"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "unsigned-note",
              "text": "巷口的邮筒漆皮已经掉了，投信口有些涩。有人把信封塞进去，听见它落到底的声音，然后快步往回走，围巾一路没扎好。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "unsigned-note",
              "text": "书店的玻璃窗后，对方正把一捆乐谱往架上搬。有人从对街走过没有停，眼睛盯着鞋尖，假装是在数人行道的石缝。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
        "domain": "social",
        "goals": [
          "belonging"
        ],
        "needs": [
          "belonging",
          "autonomy"
        ],
        "baseUtility": 1.2,
        "risk": 0.2,
        "skills": [
          "social"
        ]
      }
    },
    {
      "id": "p9-social-relationship-initiative.apology-at-bakery",
      "title": "面包店门口的那句道歉",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 17,
          "max": 45
        },
        {
          "kind": "hasRelation",
          "relationKind": "friend",
          "minTrust": 0.05
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 17,
          "maxAge": 45
        },
        {
          "key": "friend",
          "kind": "neighbor",
          "required": true,
          "minAge": 17,
          "maxAge": 45
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": false,
          "minAge": 30,
          "maxAge": 70
        }
      ],
      "outcomes": [
        {
          "id": "settle-the-account",
          "weight": 1,
          "text": "七点刚过，对方照例来买一只 Semmel。有人把紫罗兰往柜台上一放，把上回算错的账一笔一笔说清：借出去的是八克朗，记成了十克朗，是自己记错了。对方听完没马上说话，把零钱数进围裙口袋，最后说中午过来喝碗汤。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.4,
              "reason": "一小束紫罗兰和两只 Semmel"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$friend",
              "kind": "friend",
              "trust": 0.12,
              "affection": 0.06,
              "obligation": 0,
              "fear": 0,
              "respect": 0.05,
              "reason": "在面包店柜前把账算清，误会解开"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "道歉说出口，胸口松下来"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "settle-the-account",
              "text": "面包店里全是热面团味，柜台后的妇人拿铁夹子夹起 Semmel。有人把话讲得慢，一句是一句，对方一边听一边把围裙上的面粉拍掉，最后伸手接了那束花。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "settle-the-account",
              "text": "两个星期不来往，门口碰见时两人都先看别处。这次先开口的人把账本里的一页撕下来摊在柜台上，说数字是自己写错的。对方看了半天，说下回别在酒馆里算账。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "violets-on-the-step",
          "weight": 1,
          "text": "话在喉咙里滚了几遍，终究没有等到对方进门。门一响，有人就把紫罗兰放在门槛边，转身往街角走。花被早晨的扫帚拨到墙根，对方捡起来闻了闻，追到巷口只看见一个拐弯的背影，午后托人捎来一句话，说钱的事再算。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.24,
              "reason": "一束紫罗兰"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$friend",
              "kind": "friend",
              "trust": 0.05,
              "affection": 0.02,
              "obligation": 0,
              "fear": 0,
              "respect": -0.02,
              "reason": "没有当面道歉，只留下花"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "转身走开时心里发虚"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "violets-on-the-step",
              "text": "石阶上还有夜里的潮气，花束靠门放着，紫色在灰石头前显得很轻。扫街的人推着车过来，看了花一眼，抬脚从旁边绕过去。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "violets-on-the-step",
              "text": "巷口的风把包装纸吹开一角。对方弯腰把花拾起来，往街上左右看了两回，只看见早班的人流和一辆电车拐过去。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "semmel-no-words",
          "weight": 1,
          "text": "在柜台前买了两只 Semmel，递过一只，自己咬另一只，旧账一个字没提。对方接过面包，两人并肩站在店门口，把那点热气吃完。钱的事还横在中间，但对方说星期六照旧来喝咖啡，别又躲着。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.14,
              "reason": "两只 Semmel"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "面包店买回的一只面包"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$friend",
              "kind": "friend",
              "trust": 0.06,
              "affection": 0.03,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0,
              "reason": "用一只面包破冰，旧账暂时不提"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "僵局松了一点，虽然话没说透"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "semmel-no-words",
              "text": "面包还是温的，纸袋上透出油印子。两人站在门口的台阶上，各自低头嚼，谁也没有先提那八克朗，只谈起街角那家肉铺的价钱。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "semmel-no-words",
              "text": "对方吃完拍了拍手上的碎屑，说星期六老时候。有人点点头，心里清楚账还没清，但两个星期的沉默算是过去了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
        "domain": "social",
        "goals": [
          "belonging",
          "care"
        ],
        "needs": [
          "belonging",
          "safety"
        ],
        "baseUtility": 1.15,
        "risk": 0.15,
        "skills": [
          "social"
        ]
      }
    },
    {
      "id": "p9-social-relationship-initiative.borrow-handcart",
      "title": "借一辆手推车和十克朗",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 17,
          "max": 45
        },
        {
          "kind": "cash",
          "max": 40
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 17,
          "maxAge": 45
        },
        {
          "key": "friend",
          "kind": "neighbor",
          "required": true,
          "minAge": 17,
          "maxAge": 45
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "handcart-and-ten",
          "weight": 1,
          "text": "星期天搬家的前一晚，有人坐在印厂友人家的厨房里把事说全：车要借，十克朗也要借。对方合上账本，从抽屉里数出两张五克朗，说月底先还三克朗，剩下的按月摊。手推车的轮轴有点响，搬之前得先上油。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 10,
              "reason": "友人借给搬家应急的十克朗"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$friend",
              "kind": "friend",
              "trust": 0.1,
              "affection": 0.04,
              "obligation": 0.12,
              "fear": 0,
              "respect": 0.05,
              "reason": "开口借车借钱，写下还款日期"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "房租的窟窿补上了，但也添了债"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "handcart-and-ten",
              "text": "厨房桌上摊着孩子的作业本和一只没洗的杯子。对方把借条写好，让签字画押，说朋友归朋友，账要清楚。有人把借条折好放进内袋。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "handcart-and-ten",
              "text": "手推车停在楼后的院子里，木板上还有上一回运煤留下的黑印。有人蹲下去转了转轮子，听见轴响，说明天一早先借点机油。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "only-the-cart",
          "weight": 1,
          "text": "开口时只提了手推车，钱的事咽回去。对方爽快地把车钥匙样的铁钩递过来，说用完了搁回院里就行。十克朗改去当铺想办法，一件旧外套和一只怀表抵了十二克朗，赎期三个月，票据折好收在证件夹里。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 12,
              "reason": "当铺抵当旧外套和怀表换来的钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$friend",
              "kind": "friend",
              "trust": 0.04,
              "affection": 0.02,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0,
              "reason": "只借车，没有开口借钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "债没欠到朋友头上，可怀表不在口袋里了"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "only-the-cart",
              "text": "当铺柜台高过人的胸口，伙计把怀表盖翻开看了看，报出数目。有人点头，接过票据和纸币，把外套的扣子重新系好才推门出去。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "only-the-cart",
              "text": "朋友一直送他到巷口，还在说钱不够就讲一声。有人只说够了，回家路上摸了摸空下来的马甲口袋，那地方原来有表链的响动。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "hire-the-movers",
          "weight": 1,
          "text": "站在门口把借钱的话过了两遍，最后没有开口。转身去找了街角的搬运行，一辆板车加两个帮工，一趟一克朗五十赫勒。家里能当的都当了，现钱只够这一趟，搬完当天连买煤的钱都要现算。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1.5,
              "reason": "搬运行一趟的工钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$friend",
              "kind": "friend",
              "trust": -0.02,
              "affection": 0,
              "obligation": 0,
              "fear": 0,
              "respect": 0.02,
              "reason": "宁可花钱也不向朋友开口，朋友后来才知道"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "事情办成了，可现钱见了底"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "hire-the-movers",
              "text": "搬运行的两个帮工把床架绑上板车，绳子勒得木头吱响。有人跟在车后走，一路上算着剩下的赫勒，连孩子要的一只小面包都没敢买。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "hire-the-movers",
              "text": "经过印厂友人家门口时，板车正好拐弯。对方在窗后抬了抬手，有人只点了一下头，没停下，绳子在手里攥得很紧。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
        "domain": "social",
