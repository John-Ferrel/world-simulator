      "outcomes": [
        {
          "id": "aid-joined",
          "weight": 1,
          "text": "{subject}在圣坛边的长椅上等{official}写完册子，交了第一季的会费一克朗二十赫勒。她的名字被写进那本厚册，旁边注着门牌号。回家走的是巷子，风从教堂门口灌过来，她把围巾掖紧了，脚步比来时稳。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1.2,
              "reason": "缴纳互助会第一季会费"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.07,
              "reason": "名字进了互助会册子，心里踏实"
            }
