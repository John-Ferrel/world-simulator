    {
      "id": "p10-migration-tasks.move-district",
      "title": "手推车上的三趟",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 60
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "max": 50
        },
        {
          "kind": "placeKind",
          "in": ["home"]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 60
        },
        {
          "key": "landlord",
          "kind": "neighbor",
          "required": true,
          "minAge": 35,
          "maxAge": 70
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 60
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 55
        }
      ],
      "tags": ["moving", "district", "rent"],
      "outcomes": [
        {
          "id": "move-three-loads-settled",
          "weight": 1,
          "text": "他把床架和炉子分成三趟推过桥，第三趟天已擦黑。旧房东当面清煤账，扣下两克朗十二赫勒，说炉灰也算钱。新房子在工地拐角，孩子转了学，新房东却要一次收一季度租，他数了两遍口袋，只够一半。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -9,
              "reason": "结清旧屋煤账、给新房东交部分季度租金与手推车租用费"
            },
            {
              "type": "residence",
              "householdId": "$household",
              "residenceId": "place-wien-leopoldstadt-tenement",
              "reason": "为省房租并靠近新工地，搬进利奥波德城区的合租房"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "新房东催缴剩余季度租，心里发紧"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "新房子的房东只按季度收租，一次要交十克朗以上",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$landlord",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "move-three-loads-settled",
              "text": "手推车的轮子在石板路上嘎吱响，绳子勒进他的肩窝。旧房东拿粉笔在门框上记下煤账，抹布一擦就没了。新屋朝院子，墙上还有上一位住户留下的挂钩。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "move-three-loads-settled",
              "text": "第二趟推到桥心，邻居扶了一把歪掉的柜子。孩子抱着书包跟在车后，问学校远不远。他把钥匙塞进衣兜，听见新房东在楼梯口说：季度租，少一个赫勒也不行。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "move-share-smaller-room",
          "weight": 1,
          "text": "他拿不出一季度的租金，退回到城北一条巷子，改租一间和运煤工合住的屋子，两张床之间拉一根绳子挂衣服。押金四克朗照付，剩下的钱够买一星期的面包和煤球，可孩子转学的手续还压在旧房东那里。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -6,
              "reason": "合住屋押金四克朗与搬运用度"
            },
            {
              "type": "residence",
              "householdId": "$household",
              "residenceId": "place-wien-leopoldstadt-tenement",
              "reason": "租不起整间，只租得起合住的床位与半间屋"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": 2,
              "reason": "用剩下的钱买面包和豆子"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.02,
              "obligation": 0.1,
              "fear": 0,
              "respect": 0.03,
              "reason": "与运煤工合住一屋，互相照看炉子和门锁"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "move-share-smaller-room",
              "text": "屋子里有股煤灰味，运煤工把靴子倒扣在床脚。绳子上的衬衫滴着水。{subjectPronoun}把工具袋塞到床下，心里盘算下个星期六能不能先欠着房租。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "move-share-smaller-room",
              "text": "押金是四克朗，他一张一张数给门房。运煤工说自己夜里十一点才回来，叫他别插门闩。他点点头，把孩子的鞋摆到炉边，鞋底还是湿的。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "move-stay-and-bargain",
          "weight": 1,
          "text": "他最终没有搬，把箱子又拖回楼上，跟旧房东坐在厨房桌边谈了半个钟头。按月付、煤账分两次清，房东要他每周扫一次楼道。孩子不用换学校，母亲的药也还在原来的药房抓，只是房租每月多了八十赫勒。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -3,
              "reason": "按月先付一部分房租与旧欠煤账"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$landlord",
              "kind": "acquaintance",
              "trust": 0.04,
              "affection": 0,
              "obligation": 0.12,
              "fear": 0.02,
              "respect": 0.05,
              "reason": "谈成按月付租并承担扫楼道"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "房租每月多出八十赫勒，手头更紧"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "move-stay-and-bargain",
              "text": "房东把烟斗在桌沿上磕了磕，说行，但楼道得扫干净。他应下来，卷起袖子先扫了一趟楼梯，灰从窗口飘出去，落在院里的晾衣绳上。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "move-stay-and-bargain",
              "text": "手推车还借在那儿，他得还回去。母亲问搬不搬，他说不搬了，学校近。孩子在门后听见，抱着书包跑出去，脚步在楼道里响了一串。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "migration",
        "goals": ["family", "survival"],
        "needs": ["cash", "safety"],
