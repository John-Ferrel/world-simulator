      "weight": 1,
      "rate": 0.2,
      "conditions": [
        {
          "kind": "age",
          "min": 13,
          "max": 14
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 13,
          "maxAge": 14
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 25,
          "maxAge": 60
        },
        {
          "key": "father",
          "kind": "parent",
          "required": true,
          "minAge": 35,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "stay-in-school",
          "weight": 1,
          "text": "{teacher}在放学后把{subject}留在教室里，指着算术本上最后一道题说，再念一年，也许能进商业学校。{father}在门外听完，把帽檐压低了半指。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "reason": "继续上学并准备商业学校考试",
              "status": "secondary"
