            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.05,
              "obligation": 0.04,
              "reason": "宽限房客第一个月租金"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": -1,
              "reason": "分给房客的口粮"
            }
          ],
          "narration": [
            {
              "id": "doorway",
              "key": "p9-gap-elderhood-daily.lodger-night.no-rent",
              "text": "{neighbor}手指绞着围裙带子，说话时眼睛看着灶台。{subject}把罐子推过去，罐底在桌面上蹭出一点油印。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "register",
              "key": "p9-gap-elderhood-daily.lodger-night.no-rent",
              "text": "{official}翻开住户登记簿，笔尖在格子上点了点。{subject}站在门边报出{neighbor}的名字，又把街名重复了一遍，生怕他听岔。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
