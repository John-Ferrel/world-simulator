    {
      "id": "p9-childhood-adolescence.courtyard-gang",
      "title": "院子里的那伙人",
      "weight": 1,
      "rate": 0.026,
      "conditions": [
        {
          "kind": "age",
          "min": 12,
          "max": 15
        },
        {
          "kind": "placeKind",
          "in": [
            "street",
            "home"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 12,
          "maxAge": 15
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 12,
