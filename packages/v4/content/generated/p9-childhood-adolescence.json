      "outcomes": [
        {
          "id": "club-sign-up-hike",
          "weight": 1,
          "text": "{subject}把十赫勒放在桌上的铁皮盒里，翻到歌本最后一页，用铅笔写下自己的名字。{neighbor}在后面戳{subject}的背，说乡下的草地能躺着听云。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -10,
              "reason": "青年会远足车费"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.05,
              "affection": 0.03,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "一起报名远足"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "盼着乡下远足"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "club-sign-up-hike",
              "text": "教堂侧厅的长凳硬得硌腿，{subject}把歌本翻得哗哗响，铅笔尖在纸角断了一小截。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "club-sign-up-hike",
              "text": "修女的鞋跟敲在石板地上，{neighbor}凑过来小声说自己带了双结实的鞋，{subject}把名字写大了一点。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "club-one-visit-only",
          "weight": 1,
          "text": "{subject}去了一个下午，看那些旧歌本里夹着褪色的圣像卡，工厂来的几个年轻人在最后一排用手指敲长凳打拍子。第二个星期天{subject}没再去，在院子里帮母亲晾被单。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": -0.02,
              "affection": 0,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "没再去青年会"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.01,
              "reason": "帮家里干活"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.02,
              "reason": "见过教区里不同的人"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "club-one-visit-only",
              "text": "被单在绳子上鼓成一团，{subject}从布缝里看街道，教堂钟声响了两下，{subject}没有动。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "club-one-visit-only",
              "text": "那几个年轻人敲凳子的声音还留在耳朵里，{subject}把木夹子一个个捏紧，没跟母亲提青年会的事。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "club-follow-without-paying",
          "weight": 1,
          "text": "{subject}口袋里没有十赫勒，却还是跟着队伍走到车站。修女在栅栏边拦住{subject}，翻了翻名册，说没交钱的孩子不能上车；{neighbor}在车厢门口回头看。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "没交钱被修女当众拦下"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.02,
              "affection": 0,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "隔着栅栏看着远足队伍离开"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "被留在车站"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "club-follow-without-paying",
              "text": "火车的烟飘到站台上，{subject}攥着栅栏的凉铁条，看见{neighbor}的脸从车窗后缩回去。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "club-follow-without-paying",
              "text": "修女合上名册的动作很轻，旁边几个大人却都转过来看，{subject}把空口袋按在大腿上。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
