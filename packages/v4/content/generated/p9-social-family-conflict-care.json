  "nodes": [
    {
      "id": "p9-social-family-conflict-care.sibling-medicine-bill",
      "title": "母亲药费的分摊",
      "weight": 1,
      "rate": 0.036,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 70
        },
        {
          "kind": "cash",
          "max": 60
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "sibling",
          "kind": "sibling",
          "required": true,
          "minAge": 18,
          "maxAge": 75
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": false,
          "minAge": 55,
          "maxAge": 95
        }
      ],
      "outcomes": [
        {
          "id": "split-per-head",
          "weight": 1,
          "text": "{subject}把旧练习本翻到空白一页，写下母亲、自己和{sibling}的名字。十四克朗的药费单，{subject}和{sibling}各摊五克朗，余下四克朗从母亲的养老金里扣；{subject}把五克朗硬币一枚枚摞在桌沿，{sibling}盯着那一栏看了半天，也从围裙口袋里摸出钱来。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "分摊母亲药费中自己的一份"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": 0.05,
              "affection": 0.02,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "把药费账目摊开算清，兄妹勉强接受"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.sibling-medicine-bill.split-per-head.alt1",
              "key": "split-per-head",
              "text": "铅笔尖钝了，{subject}用指甲把最后一笔划清楚。{sibling}数出五克朗，铜板在桌面上排成窄窄一行；母亲在里屋咳了两声，谁也没有去动糖罐里剩下的零钱。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-family-conflict-care.sibling-medicine-bill.split-per-head.alt2",
              "key": "split-per-head",
              "text": "账算完，{subject}把五克朗推到药费单上，纸角被硬币压出四个圆印。{sibling}没有争，只问了一句下个月还够不够；窗外的收废品车走远了，屋里只剩钱碰着木桌的轻响。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "advance-with-room-claim",
          "weight": 1,
          "text": "{subject}把十四克朗的整张票子压在药费单上，说这钱不用还，只要求母亲那间朝院子的屋子以后归自己照看，钥匙也归自己管。{sibling}的咖啡杯在桌上顿了一下，说照看可以，房契上的名字另说；药费单总算从糖罐底下抽了出来，兄妹之间却多了一层账。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -14,
              "reason": "先垫付母亲全部药费"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": -0.05,
              "affection": -0.02,
              "obligation": 0.1,
              "fear": 0,
              "respect": 0.03,
              "reason": "垫钱换照看母亲房间的权利，兄妹心里存了疙瘩"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "claims_mother_room",
              "add": true,
              "reason": "以垫付药费为由提出照看母亲房间"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.sibling-medicine-bill.advance-with-room-claim.alt1",
              "key": "advance-with-room-claim",
              "text": "十四克朗在桌上铺平，{subject}用三只咖啡杯压住四角。{sibling}没有碰钱，只把糖罐挪开，露出底下皱巴巴的药费单，说先救了急，钥匙的事以后再讲。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-family-conflict-care.sibling-medicine-bill.advance-with-room-claim.alt2",
              "key": "advance-with-room-claim",
              "text": "钥匙在{sibling}指间转了一圈，落在桌面。{subject}把钱收进上衣内袋，听见里屋母亲的呼吸声，也知道这间朝院子的屋子从此有了两个说法。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "refuse-push-bill",
          "weight": 1,
          "text": "{subject}把药费单从糖罐底下抽出来，对折，推回桌子中央，说上个月的工钱已经贴过煤钱，这回一个赫勒也拿不出。{sibling}的脸沉下来，练习本翻得哗哗响，最后把单子重新压回糖罐底下，起身去够门后的外套。三只咖啡杯里的渣子凉在桌上，兄妹这一回把话都说薄了。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": -0.1,
              "affection": -0.08,
              "obligation": -0.05,
              "fear": 0,
              "respect": 0,
              "reason": "拒绝分摊药费，兄妹关系明显冷淡"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "把药费单推走后心里发沉"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.sibling-medicine-bill.refuse-push-bill.alt1",
              "key": "refuse-push-bill",
              "text": "{subject}的指尖碰着那张纸又缩回来。{sibling}一句话没说，把外套从钉子上扯下来，门开时楼道里的冷风灌进来，吹得练习本翻过去两页。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-family-conflict-care.sibling-medicine-bill.refuse-push-bill.alt2",
              "key": "refuse-push-bill",
              "text": "糖罐重新压住药费单，{sibling}的脚步声一层层往下。{subject}独自坐着，听见收废品的车绕回来，铃铛响了两下，屋里没有谁站起来。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-social-family-conflict-care.sick-parent-night",
      "title": "夜里的药粉和便盆",
      "weight": 1,
      "rate": 0.04,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 70
        },
        {
          "kind": "placeKind",
          "in": ["home"]
        },
        {
          "kind": "hasRelation",
          "relationKind": "kin",
          "minTrust": 0.1
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 55,
          "maxAge": 95
        },
        {
          "key": "sibling",
          "kind": "sibling",
          "required": false,
          "minAge": 18,
          "maxAge": 75
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": false,
          "minAge": 30,
          "maxAge": 75
        }
      ],
      "outcomes": [
        {
          "id": "shifts-with-sibling",
          "weight": 1,
          "text": "{subject}和{sibling}把值班时辰写在门后的粉笔板上：{sibling}守前半夜，{subject}守后半夜，医生说静养二十一天。煤油灯芯拧小，药粉分成小包摆在床头，便盆换水时尽量不碰出响。二十一天熬下来，{subject}的眼皮肿了，走路发飘，但{parent}每次起身总有人扶。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "连续夜里守夜睡眠不足"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": 0.08,
              "affection": 0.05,
              "obligation": 0.08,
              "fear": 0,
              "respect": 0.05,
              "reason": "与兄妹轮流守夜照顾父亲"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "night_care_duty",
              "add": true,
              "reason": "承担父亲夜间照看"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.sick-parent-night.shifts-with-sibling.alt1",
              "key": "shifts-with-sibling",
              "text": "门后的粉笔字一天擦掉一格。凌晨三点，{subject}把药粉倒进半杯温水，{sibling}蜷在塌了一边的椅子上打盹；便盆倒进楼道尽头的桶，回来时灯已经暗成一个小点。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-family-conflict-care.sick-parent-night.shifts-with-sibling.alt2",
              "key": "shifts-with-sibling",
              "text": "{sibling}把钟拨到床头，说前半夜归自己。{subject}合眼没一会儿就被{parent}的咳嗽叫醒，摸黑去够便盆，手肘碰翻半包药粉，只好用手指把粉末拢回纸上。",
              "tone": ["tender"]
            }
          ]
        },
        {
          "id": "hire-neighbor-daycare",
          "weight": 1,
          "text": "{subject}请楼下的{neighbor}白天来照看{parent}，先付一周六克朗工钱，讲好每天另管两顿饭，煤钱也从这六克里出。{neighbor}上午换床单，下午喂药，临走把便盆提到楼道口。{subject}下工回来先摸煤箱，再在练习本上记下当天的饭钱和煤钱，看见{parent}的嘴唇不再干裂。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -6,
              "reason": "支付邻居照看工钱和煤钱"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": -2,
              "reason": "给邻居管两顿饭"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.1,
              "affection": 0.03,
              "obligation": 0.05,
              "fear": 0,
              "respect": 0.05,
              "reason": "雇邻居白天照看父亲"
            },
            {
              "type": "health",
              "personId": "$parent",
              "amount": 0.04,
              "reason": "白天有人按时喂药和换洗"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.sick-parent-night.hire-neighbor-daycare.alt1",
              "key": "hire-neighbor-daycare",
              "text": "{neighbor}围裙口袋里装着一小包药粉，进门先看{parent}的嘴唇干不干。六克朗放在糖罐旁边，{subject}下工后数出饭钱，听见一句“今天咳得轻些”，才去灶上热自己的饭。",
              "tone": ["tender"]
            },
            {
              "id": "p9-social-family-conflict-care.sick-parent-night.hire-neighbor-daycare.alt2",
              "key": "hire-neighbor-daycare",
              "text": "楼道里飘着{neighbor}熬的汤味，{subject}把饭钱压在盘子底下。{parent}靠在叠高的枕头上，嘴角沾着药粉，{neighbor}用湿布替{parent}擦掉，顺手把灯芯挑亮。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "hospital-deposit",
          "weight": 1,
          "text": "{subject}跑了一趟医院，把{parent}送进病房：押金三克朗，搪瓷杯和旧毛巾一克朗二十赫勒，头三天的药费三克朗八十赫勒，一共八克朗。护士收走便盆，换上带刻度的玻璃壶。{subject}回到空了的床边，把塌下去的椅子扶正，才发现自己一整天只喝了一杯咖啡。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -8,
              "reason": "住院押金和住院用品"
            },
            {
              "type": "health",
              "personId": "$parent",
              "amount": 0.06,
              "reason": "父亲住进医院得到治疗"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "把父亲送进医院后心里空落"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "parent_hospitalized",
              "add": true,
              "reason": "父亲已入院"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.sick-parent-night.hospital-deposit.alt1",
              "key": "hospital-deposit",
              "text": "医院的走廊比家里亮，{subject}把三克朗押金数了两遍，又把剩下的五克朗按药费、杯子、毛巾分开放。护士说探视在下午；{parent}抬起手，指节比在家里更凉。",
              "tone": ["clinical"]
            },
            {
              "id": "p9-social-family-conflict-care.sick-parent-night.hospital-deposit.alt2",
              "key": "hospital-deposit",
              "text": "{subject}把旧毛巾叠好放在床头，玻璃壶里的水映出窗外的天。回家经过煤店，想买又没买；推开门看见床边那只便盆还留在原地，才想起今天不用再倒了。",
              "tone": ["dry"]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-social-family-conflict-care.school-fork",
      "title": "国民学校毕业后的岔路",
      "weight": 0.9,
      "rate": 0.032,
      "conditions": [
        {
          "kind": "age",
          "min": 28,
          "max": 55
        },
        {
          "kind": "householdSize",
          "min": 3
        },
        {
          "kind": "placeKind",
          "in": ["home"]
        },
        {
          "kind": "cash",
          "max": 80
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 28,
          "maxAge": 55
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 25,
          "maxAge": 65
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 65
        }
      ],
      "outcomes": [
        {
          "id": "pay-for-buergerschule",
          "weight": 1,
          "text": "{subject}把市民学校的书本费和服装费凑齐，一共十二克朗，交到{teacher}手里。回家路上把肉钱减半，晚饭只有扁豆和土豆。{teacher}在成绩单背面写了收据，把孩子的名字添进市民学校名册，说若能跟上，明年可以申请减免；煤箱旁的账本上多了一页，写着“皮鞋、石板、学费”。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -12,
              "reason": "市民学校书本费和服装费"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": -1,
              "reason": "减半肉钱，伙食变差"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.03,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0.06,
              "reason": "为孩子交费并听老师安排"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "child_in_buergerschule",
              "add": true,
              "reason": "孩子进入市民学校"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.school-fork.pay-for-buergerschule.alt1",
              "key": "pay-for-buergerschule",
              "text": "{teacher}把十二克朗点完，在窄纸条上写了收据。{subject}回家把肉铺的账划掉一半；晚饭时孩子低头吃扁豆，不敢问新衣服什么时候做。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-family-conflict-care.school-fork.pay-for-buergerschule.alt2",
              "key": "pay-for-buergerschule",
              "text": "服装费里包括一双结实皮鞋，{subject}让孩子在店里试了两次。回家经过煤店，只买半筐碎煤；孩子拎着书包走在前面，鞋底在石板路上响得清脆。",
              "tone": ["tender"]
            }
          ]
        },
        {
          "id": "apprentice-at-printer",
          "weight": 1,
          "text": "{subject}在印刷厂的招工窗口替孩子报了学徒，第一年每周带回两克朗工钱。{teacher}在成绩单背面写的推荐话被折进信封，和学徒契约一起锁在抽屉里。孩子第一天回来，袖口沾着油墨，说师傅让先搬纸；{subject}数着那两克朗，没再提升学的事。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 2,
              "reason": "孩子学徒第一周带回工钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": -0.03,
              "affection": 0,
              "obligation": 0,
              "fear": 0,
              "respect": 0.02,
              "reason": "没有听老师建议继续升学"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "child_apprentice_printer",
              "add": true,
              "reason": "孩子进入印刷厂做学徒"
            }
          ],
          "narration": [
            {
              "id": "p9-social-family-conflict-care.school-fork.apprentice-at-printer.alt1",
              "key": "apprentice-at-printer",
              "text": "学徒契约上盖着印刷厂的章，{subject}按了手印。孩子傍晚回来，指甲缝里嵌着黑油墨，把两克朗放在桌上，说师傅讲明天要早到一个钟头。",
              "tone": ["dry"]
            },
            {
              "id": "p9-social-family-conflict-care.school-fork.apprentice-at-printer.alt2",
              "key": "apprentice-at-printer",
              "text": "{teacher}在街角碰见{subject}，问了两句，听说孩子进了印刷厂，没再说什么。{subject}回家看见孩子把油墨袖子泡在冷水里，盆底沉着一层黑沙。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "ask-for-reduction",
          "weight": 1,
