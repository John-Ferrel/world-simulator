      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 17,
          "maxAge": 40
        },
        {
          "key": "partner",
          "kind": "partner",
          "required": true,
          "minAge": 17,
          "maxAge": 40
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": false,
