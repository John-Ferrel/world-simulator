        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 25,
          "maxAge": 65
        }
      ],
      "outcomes": [
        {
          "id": "reading-full",
          "weight": 2,
          "text": "后厅二十把椅子坐了十三把，{neighbor}在前排占了个位子，进门费收了近两克朗。读完有人问起小说里那个厨娘为什么不肯解释，{subject}答得满头汗，门口的小桌上 nonetheless 卖掉四本手印小册子。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 1.8,
              "reason": "朗读夜门票与小册子收入"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "在小型听众中获得关注"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.07,
              "reason": "朗读后有人提问"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.02,
              "reason": "当众面对听众的追问"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "reading-full",
              "text": "煤气灯把后厅照得发黄，桌面上有水渍和烟灰。{subject}读到一半听见有人在笑厨娘的台词，抬眼看见{neighbor}也在笑，便把下面一段念得快了些。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "reading-full",
              "text": "散场时杯盘在托盘上叮当作响，{subject}在门口收那四本小册子的零钱，一枚克朗落进围裙口袋，身上那股紧张才慢慢退下去。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "reading-small",
          "weight": 2,
          "text": "只来了七个人，其中一位始终没脱大衣。{subject}读到第三页有点慌，却听见那位听众在结尾提出一个尖锐的问题：厨娘为什么从不自己开口。后厅里静了几秒，{neighbor}替他把话筒往桌中间挪了挪。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "少数听众中的认真讨论"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.03,
              "reason": "应对听众的尖锐问题"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "小场合里的意外收获"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 0.9,
              "reason": "七张门票的收入"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "reading-small",
              "text": "后厅空位很多，{neighbor}和另一个人坐在中间。那位没脱大衣的听众等所有人走后才起身，问问题的声音不高，却让{subject}发现自己从没想过厨娘为何沉默。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "reading-small",
              "text": "散场时咖啡馆老板来收椅子，问下次还办不办。{subject}把七张票根在桌上摆开，票面印着小小的店名，边角已经卷了，像被人捏了一晚上。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "reading-cancelled",
          "weight": 1,
          "text": "下午报上那篇尖刻的剧评果然带走了不少人，开场前退票四张。{subject}在门口站到七点一刻，干脆取消朗读，回家把稿子重新誊了一遍，第二天用挂号寄给{neighbor}推荐的那位编辑，邮资花了十四赫勒。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "开场前退票带来的挫败"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.85,
              "reason": "退还部分门票钱与挂号邮资"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "mailed_piece",
              "add": true,
              "reason": "把稿子挂号寄给编辑"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.04,
              "reason": "接受推荐并告知结果"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "reading-cancelled",
              "text": "{subject}把椅子一张张推回墙边，咖啡馆老板没说什么，只把送来的两杯水端回去。玻璃门外电车叮当响过，他忽然觉得取消比硬着头皮读更体面。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "reading-cancelled",
              "text": "退票的人里有一个还问下次日期。{subject}含糊应了一声，出门时在邮局关门前赶到，把信封按到柜台上，十四赫勒硬币排成一列。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
