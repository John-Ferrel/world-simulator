          "maxAge": 35
        },
        {
          "key": "official",
          "kind": "official",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        }
      ],
      "tags": [
        "elderhood",
        "lodger",
        "housing",
        "household"
      ],
      "outcomes": [
        {
          "id": "p9-gap-elderhood-daily.lodger-night.quiet",
          "weight": 1,
          "text": "{subject}夜里被木板墙后面的响动惊醒两次，都是箱子拖动的闷声。天没亮，{neighbor}已经在厨房把炉台擦得发亮，煤球一块块码齐，说好一个月八克朗，先付了第一周；{subject}数了数硬币，把说好的规矩又低声重说一遍。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 2,
              "reason": "房客先付的第一周租金"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "房客早起擦净炉台，守规矩"
            }
