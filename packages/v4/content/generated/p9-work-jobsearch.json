  "nodes": [
    {
      "id": "p9-work-jobsearch.ask-trial",
      "title": "在厂门口问一次试工",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 16,
          "max": 60
        },
        {
          "kind": "employment",
          "employed": false
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 16,
          "maxAge": 60
        },
        {
          "key": "foreman",
          "kind": "worker",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "journeyman",
          "kind": "worker",
          "required": false,
          "minAge": 20,
          "maxAge": 45
        }
      ],
      "tags": ["job_search", "trial", "factory"],
      "outcomes": [
        {
          "id": "ask-trial.accepted",
          "weight": 2,
          "text": "工头把烟蒂在鞋底按灭，上下打量他沾灰的袖口，说明早六点来试半天，只管一顿午饭，干得好再谈工钱。{subject}连声道谢，回家路上把明早要穿的褂子先刷了一遍。",
          "effects": [
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "trial_work_pending",
              "add": true,
              "reason": "约好次日试工"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$foreman",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "工头愿意给一次试工机会"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "有了试工的盼头"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "ask-trial.accepted",
              "text": "午休的哨子刚响，{foreman}夹着烟走到门口。{subject}报上姓名、住址和干过的活，声音有点发紧。工头嗯了一声，说明早六点来，管一顿午饭，干得好再谈工钱。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "ask-trial.accepted",
              "text": "厂门口的砖墙被太阳晒得发烫。{journeyman}在旁听着，插了一句这后生看着手稳。工头把烟灰弹进阴沟，说试半天，午饭他管。{subject}点头时，肚子先响了一声。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "ask-trial.no-vacancy",
          "weight": 2,
          "text": "工头说眼下没有空缺，让他把名字和住址写在账本撕下的纸角上，说月底再来问。{subject}看那张纸被随手压进抽屉，纸角还露出半截，知道多半不会有人翻。他道过谢，往街尾另一家走去。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "名字只写在纸角上"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$foreman",
              "kind": "acquaintance",
              "trust": 0.02,
              "reason": "工头客气但没有松口"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "seeking_work",
              "add": true,
              "reason": "继续沿街问工"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "ask-trial.no-vacancy",
              "text": "{foreman}没有接话，先从抽屉里撕下一角纸。{subject}把名字、住址和手艺一样样说完，工头边写边应，写完把纸压回抽屉，说月底来问。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "ask-trial.no-vacancy",
              "text": "门口的铁栅栏后面机器还在响。{subject}隔着栅栏说完自己的来意，工头只抬了抬下巴。纸角上的铅笔字很淡，他把住址又念了一遍，怕对方写错。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "ask-trial.deposit-refused",
          "weight": 1,
          "text": "工头说要干就先交十克朗工具押金，坏了照价扣。{subject}把口袋翻出来，里面只有几个赫勒和一张车票，凑不齐。工头耸耸肩，说这里规矩就是这样，他便提着帽子转身去了下一家。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "拿不出押金被挡在门外"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "seeking_work",
              "add": true,
              "reason": "仍没有着落"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.01,
              "reason": "空手离开厂门口"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "ask-trial.deposit-refused",
              "text": "“十克朗押金，先交后干。”{foreman}说得很平。{subject}把两只口袋翻给人家看，柜台上只落下一张皱车票。工头收回话头，他也不再问，提着帽子走出栅栏。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "ask-trial.deposit-refused",
              "text": "栅栏边的工友听着都低下头。{journeyman}小声说这押金上个月还没有。{subject}数了三遍手里的赫勒，差得远，只好说声打扰了，沿着墙根往下一家走。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "work",
        "goals": ["work", "survival"],
        "needs": ["cash", "autonomy"],
        "baseUtility": 1.7,
        "risk": 0.25,
        "skills": ["social", "craft"]
      }
    },
    {
      "id": "p9-work-jobsearch.request-raise",
      "title": "把一年的活计摊在桌上",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 60
        },
        {
          "kind": "employment",
          "employed": true
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 60
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": true,
          "minAge": 35,
          "maxAge": 70
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 60
        }
      ],
      "tags": ["wages", "raise", "negotiation"],
      "outcomes": [
        {
          "id": "request-raise.granted-extra-duty",
          "weight": 2,
          "text": "厂长听完那张记满活计的纸，摆弄了一下怀表，说每周加一克朗，但从下月起仓库钥匙归他管，月底盘点要留下对账。{subject}当晚就把钥匙串系在腰上，回家路上算了算，多的一克朗刚够交房租添头。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 4,
              "reason": "加薪一周一克朗的积攒"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.04,
              "reason": "学着盘点和记账"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$employer",
              "kind": "employer",
              "trust": 0.05,
              "reason": "厂长把仓房交给他"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "工钱涨了"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "request-raise.granted-extra-duty",
              "text": "{employer}把怀表扣在桌面上，一刻钟走得清清楚楚。{subject}把那张纸推过去，一行行念，念到替人顶班时停了一下。厂长说加一克朗，钥匙和月底盘点也归你。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "request-raise.granted-extra-duty",
              "text": "办公室有股墨水味。{worker}在门外等着，透过玻璃看见{subject}把纸摊平。厂长开抽屉取出仓库钥匙串，往桌上一放，说工钱加一克朗，月底得把数目对上。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "request-raise.postponed",
          "weight": 2,
          "text": "厂长翻了两页纸，说这个月订单少，加薪的事推到明年，连具体哪个月都没提。他出来时那张纸还留在桌上，边角被茶杯压出一道湿印。活还是那些活，工钱还是二十六克朗。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "加薪被推到没有月份"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$employer",
              "kind": "employer",
              "trust": -0.03,
              "reason": "觉得东家只是推托"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.01,
              "reason": "开口谈工钱没有失礼"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "request-raise.postponed",
              "text": "“明年再说，眼下订单少。”{employer}把纸往桌边一推。{subject}站着没动，想问哪个月，厂长的怀表已经合上。茶杯底下压着那两页活计，印子慢慢洇开。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "request-raise.postponed",
              "text": "{worker}从门缝里看见他出来时手里空空的。厂长原话说生意淡，加薪留到明年。{subject}回工位把锤子放回木架，什么也没说，只把袖口又卷高了一指。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "request-raise.leaked-wages",
          "weight": 1,
          "text": "说到一半，{subject}顺口把自己听说别家熟手拿三十克朗的事抖了出来。厂长脸色一沉，说那你上别家去，原本默许加的那一克朗当场收回。他回到工位，{worker}问谈成了没有，他只摇摇头。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "说漏嘴丢掉加薪"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$employer",
              "kind": "employer",
              "trust": -0.08,
              "reason": "东家认为他拿别处压价"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "厂里传出他不安分的话"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "request-raise.leaked-wages",
              "text": "“别家熟手三十克朗。”{subject}话一出口就后悔。{employer}把怀表往桌上一磕，说那你上别家去。门开后，走廊里打字机的声音听得格外清。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "request-raise.leaked-wages",
              "text": "厂长本来都拿起笔了，听见那个数目又放下。{subject}想补一句自己不是那个意思，{worker}正好推门进来送单子，屋里静了一下，那笔终于没收。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "work",
        "goals": ["work", "status"],
        "needs": ["cash", "status"],
        "baseUtility": 1.5,
        "risk": 0.5,
        "skills": ["social", "numeracy"]
      }
    },
    {
      "id": "p9-work-jobsearch.railway-depot",
      "title": "南站货场的招工日",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 60
        },
        {
          "kind": "employment",
          "employed": false
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 60
        },
        {
          "key": "stationForeman",
          "kind": "worker",
          "required": true,
          "minAge": 35,
          "maxAge": 65
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 55
        },
        {
          "key": "railway",
          "kind": "organization",
          "required": true,
          "organizationKind": "state"
        }
      ],
      "tags": ["job_search", "railway", "depot", "hiring"],
      "outcomes": [
        {
          "id": "railway-depot.day-labor",
          "weight": 2,
          "text": "站务员把出生证明和上一任东家的离职证明摊在桌上核对，又让他看远处车皮上的号码，考视力。后生念对了，便被派去跟装卸班，按日结钱，一天两克朗四十分，干得好才补进正式名册。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$railway",
              "occupation": "货场临时装卸工",
              "wage": 2.4,
              "workplaceId": "$workplace",
              "reason": "招工日被收作按日结钱的临时工"
            },
            {
              "type": "condition",
              "personId": "$subject",
              "condition": "back_strain",
              "add": true,
              "reason": "整日扛麻袋扭伤腰背"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$stationForeman",
              "kind": "acquaintance",
              "trust": 0.05,
              "reason": "站务员收下了他的证明"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "排了半宿队终于有活"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "railway-depot.day-labor",
              "text": "天色还灰着，{subject}手里攥着几张折皱的证明。{stationForeman}让他念车皮上的号码，听见念对了，就朝装卸班一挥手，说先按日结钱，一天两克朗四十分。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "railway-depot.day-labor",
              "text": "货场的煤烟落在肩上。{worker}帮他扛第一袋时教他把腰沉下去。站务员在名册边上记了日期，说干得好才有正式名分，{subject}点头，把袋子往肩上一顶。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "railway-depot.eyesight-failed",
          "weight": 2,
          "text": "体检室的窗子很小，医生让他认墙上贴的字牌，他眯着眼把最后两行念错。站务员只留下他的名字，说货场有空缺再叫。他走出南站，手里那张洗礼证明的边已经被汗浸软。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "视力不合格被搁下"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "seeking_work",
              "add": true,
              "reason": "名字留在货场等空缺"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$stationForeman",
              "kind": "acquaintance",
              "trust": 0.02,
              "reason": "站务员记下名字"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "railway-depot.eyesight-failed",
              "text": "字牌贴在石灰墙上，最后两行他实在分不清。{official}用笔杆敲敲桌面，{stationForeman}把名字写进另一本册子，说有缺再叫。{subject}把证明一张张叠好，折边已经发软。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "railway-depot.eyesight-failed",
              "text": "排在他前面的{worker}很快过了关。轮到他时，医生把灯挪近了些，他还是念错。出了南站，太阳才刚爬上车皮，他站在路边把揉皱的证明捋平。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "railway-depot.no-baptism",
          "weight": 1,
          "text": "站务员一样样点过去，最后卡在洗礼证明上。他手里只有出生纸，教区在城另一头。{subject}搭车赶去，回来时日头偏西，名册已经收进柜里，装卸班早开工了。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "往返教区的车钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.07,
              "reason": "赶回来名额已满"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "seeking_work",
              "add": true,
              "reason": "仍需另找活路"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "railway-depot.no-baptism",
              "text": "“洗礼证明。”{stationForeman}把手一摊。{subject}只有出生纸，说教区在城另一头。站务员看了眼钟，说名册按时候收。他跑出去搭车，回来时柜门已经上锁。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "railway-depot.no-baptism",
              "text": "教区的办事员翻了很久簿子才开出证明，纸上的墨还没干透。{subject}一路攥着往南站赶，月台上卸货的人已经排成两行，他站在队尾，听人说上午就招满了。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "work",
        "goals": ["work", "survival"],
        "needs": ["cash", "status"],
        "baseUtility": 1.8,
        "risk": 0.3,
        "skills": ["numeracy", "social"]
      }
    },
    {
      "id": "p9-work-jobsearch.relative-introduction",
      "title": "舅公家的星期天",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 16,
          "max": 60
        },
        {
          "kind": "cash",
          "max": 60
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 16,
          "maxAge": 60
        },
        {
          "key": "relative",
          "kind": "neighbor",
          "required": true,
          "minAge": 35,
          "maxAge": 70
        },
        {
          "key": "foreman",
          "kind": "worker",
          "required": false,
          "minAge": 30,
