  "nodes": [
    {
      "id": "p9-childhood-household.supper-bowl",
      "title": "一锅土豆汤",
      "weight": 1,
      "rate": 0.036,
      "conditions": [
        {
          "kind": "age",
          "min": 3,
          "max": 8
        },
        {
          "kind": "householdSize",
          "min": 4
        },
        {
          "kind": "cash",
          "max": 45
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 3,
          "maxAge": 8
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 22,
          "maxAge": 50
        },
        {
          "key": "sibling",
          "kind": "sibling",
          "required": false,
          "minAge": 2,
          "maxAge": 14
        }
      ],
      "outcomes": [
        {
          "id": "gave-potato-to-younger",
          "weight": 1,
          "text": "{subject}把自己碗里那块最大的土豆拨到{sibling}碗里，只用汤水泡面包。{parent}看见了，没说话，把自己那片薄香肠掰下一半，悄悄放进{subject}的碗底，锅底刮得吱吱响。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "分食让全家这顿勉强吃饱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": 0.08,
              "affection": 0.1,
              "obligation": 0.04,
              "fear": 0,
              "respect": 0,
              "reason": "让出土豆给更小的弟妹"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "被母亲暗中照顾"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gave-potato-to-younger",
              "text": "五点钟天已黑透，楼道里有人提着煤筐上楼，铁皮桶碰着栏杆。{subject}数着锅里剩下的片数，把土豆夹给{sibling}，自己舔汤勺上的盐味。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "gave-potato-to-younger",
              "text": "锅底只剩一层糊汤。{parent}转身去添柴时，{subject}把土豆按进{sibling}碗里，那孩子低头吃得飞快，汤溅到桌板上。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "caught-adding-ladle",
          "weight": 1,
          "text": "{subject}趁{parent}转身去灶口添煤，又把勺子伸进锅里刮下半个土豆。父亲从桌边抬眼，什么也没说，只把碗往桌中央推了推；{subject}立刻把勺子放下，坐得笔直，手心发烫。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "被父亲看见后感到羞愧"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.03,
              "affection": -0.02,
              "obligation": 0.05,
              "fear": 0.06,
              "respect": 0.04,
              "reason": "父亲沉默的管教"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "caught-adding-ladle",
              "text": "勺子碰到锅底那一声很轻，可屋里太静。父亲放下刀叉，把烟斗往桌上一搁，{subject}连汤也不敢再舀，只盯着自己碗里浮着的油星。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "caught-adding-ladle",
              "text": "煤火从灶口蹿出来，映得墙上的挂历发红。{subject}的勺子停在半空，父亲用指节敲了两下桌面，母亲便把那口锅端到灶后头去了。",
              "tone": [
                "tense"
              ]
            }
          ]
        },
        {
          "id": "saved-bread-for-morning",
          "weight": 1,
          "text": "{subject}说自己在外头已经吃过，把分到的黑面包留在桌上，用布盖好。夜里肚子叫得睡不着，翻来覆去听着{sibling}的呼吸声；天亮时那块面包还在，边缘硬得能敲响桌面，{parent}把它掰成三份。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "省下的面包留到次日早餐"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "夜里空腹未进食"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.05,
              "affection": 0.06,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0.02,
              "reason": "母亲看出孩子懂事"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "saved-bread-for-morning",
              "text": "面包搁在炉边，被余温烘得外壳发脆。{subject}躺在草垫上翻了个身，听见楼下院子里的水龙头还在滴，肚子一阵一阵地空。",
              "tone": [
                "matter-of-fact"
              ]
            },
            {
              "id": "alt",
              "key": "saved-bread-for-morning",
              "text": "第二天清早，{parent}揭开那块布，面包已经硬了。她没问缘由，只拿刀切成三块，把最厚的一块推到{subject}面前。",
              "tone": [
                "warm"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-childhood-household.water-and-coal",
      "title": "上学前的两桶水",
      "weight": 1,
      "rate": 0.036,
      "conditions": [
        {
          "kind": "age",
          "min": 6,
          "max": 11
        },
        {
          "kind": "householdSize",
          "min": 4
        },
        {
          "kind": "health",
          "min": 0.4
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 6,
          "maxAge": 11
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 25,
          "maxAge": 55
        },
        {
          "key": "sibling",
          "kind": "sibling",
          "required": false,
          "minAge": 3,
          "maxAge": 12
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": false,
          "minAge": 30,
          "maxAge": 70
        }
      ],
      "outcomes": [
        {
          "id": "late-for-school",
          "weight": 1,
          "text": "{subject}先把两桶水一级一级提上四楼，水沿楼梯板缝往下漏，又被煤球筐压得膝盖发软。赶到学校时七点的钟早敲过，老师在本子上记下名字，罚站在走廊直到第一节课下课。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "提水抬煤累得手臂发酸"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "迟到被记名"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "被罚站在走廊"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "late-for-school",
              "text": "天没亮的院子里排着木桶，铁龙头冻得发白。{subject}把水桶提上楼，桶沿撞着栏杆一声声闷响，等放下最后一桶，胡同口的钟声已经在远处敲完了。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "late-for-school",
              "text": "走廊上站着的还有两个迟到的孩子。{subject}的鞋面被水浸黑，脚趾在里头冻得发麻，老师用指节敲了敲讲台，把名字写进登记簿。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "helped-neighbor-for-bread",
          "weight": 1,
          "text": "楼下{neighbor}的煤筐散在门槛前，{subject}停下帮着把煤球一颗颗捡回筐里，又顺手抬进门。老人从抽屉里摸出一块面包塞过来，等{subject}跑到学校，已经迟了半节课，手心里还留着煤灰的印子。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "邻居给的一块面包"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.06,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0.03,
              "reason": "帮老人搬煤"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "迟到半节课"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "helped-neighbor-for-bread",
              "text": "煤球滚进楼梯间的角落，{subject}蹲下去一颗一颗摸出来，指尖黑得发亮。老人扶着门框道谢，把面包按在孩子手里，还带着炉子的余温。",
              "tone": [
                "warm"
              ]
            },
            {
              "id": "alt",
              "key": "helped-neighbor-for-bread",
              "text": "学校钟声咚咚响过街口时，{subject}正提着空水桶跑。老师问为什么迟到，孩子张开煤黑的手掌，什么也没解释，只被赶回座位。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "ignored-mother-call",
          "weight": 1,
          "text": "{parent}在灶台边喊着再提一桶水，{subject}装作没听见，空手跑下楼梯。放学回来，水缸是空的，{subject}被罚在院子里来回挑了四趟水，直到天完全黑下来。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "傍晚被罚挑水四趟"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": -0.05,
              "affection": -0.03,
              "obligation": 0.04,
              "fear": 0.05,
              "respect": 0.02,
              "reason": "逃避家务被罚"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "ignored-mother-call",
              "text": "楼梯口传来母亲喊名字的声音，{subject}把帽子往头上一扣就往下跑，木屐敲着石阶。回家时母亲不说话，只把两只空桶并排放在门口，水龙头在院子里等着。",
              "tone": [
                "tense"
              ]
            },
            {
              "id": "alt",
              "key": "ignored-mother-call",
              "text": "夜里院子里的灯笼已经挂起来，{subject}提着满桶的水上最后一趟，肩膀被桶梁勒出红印，听见自家窗户里弟弟在咳嗽。",
              "tone": [
                "dry"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-childhood-household.half-bed",
      "title": "半张床的界线",
      "weight": 1,
      "rate": 0.0288,
      "conditions": [
        {
          "kind": "age",
          "min": 5,
          "max": 11
        },
        {
          "kind": "householdSize",
          "min": 5
        },
        {
          "kind": "overcrowded",
          "value": true
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 5,
          "maxAge": 11
        },
        {
          "key": "sibling",
          "kind": "sibling",
          "required": true,
          "minAge": 3,
          "maxAge": 16
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": false,
          "minAge": 25,
          "maxAge": 55
        }
      ],
      "outcomes": [
        {
          "id": "chalk-line",
          "weight": 1,
          "text": "{subject}从学校带回来一小截粉笔，在床板正中划了条白线，谁越过就用胳膊肘顶回去。半夜{sibling}翻身压过线来，两人推搡几回，被子扯到地上，第二天谁都没睡好。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "夜里推搡没睡踏实"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": -0.04,
              "affection": -0.05,
              "obligation": 0,
              "fear": 0,
              "respect": 0,
              "reason": "为被子划界争吵"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "chalk-line",
              "text": "粉笔线在草垫上一蹭就糊了。{subject}翻身把被子掖到下巴底下，听见{sibling}的膝盖在木床板上磨出声，线的那一头又慢慢挪了过来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "chalk-line",
              "text": "屋里只有窗外煤气灯的一点黄光。{subject}用手掌压住被角，{sibling}干脆把整条被子卷成筒抱在怀里，两个人背对背各占半张床板。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "gave-wall-side",
          "weight": 1,
          "text": "{subject}把靠墙那块最暖的位置让给最小的弟妹，自己睡到床尾，脚正好顶着门缝灌进来的风。{sibling}半夜没再滚下床，{subject}的脚踝却冻得发木，天亮了还得多搓几下才站得稳。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "睡床尾受冷风"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": 0.07,
              "affection": 0.1,
              "obligation": 0.05,
              "fear": 0,
              "respect": 0.03,
              "reason": "把暖处让给更小的弟妹"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "gave-wall-side",
              "text": "墙皮一到夜里就往下掉白灰。{subject}把最小的那个往里推，又把枕头摆正，自己缩在床尾，脚趾扳着床板边取暖。",
              "tone": [
                "warm"
              ]
            },
            {
              "id": "alt",
              "key": "gave-wall-side",
              "text": "门缝底下漏着楼道里的冷气，{subject}把外套盖在自己腿上，听见床里头的弟妹呼吸渐渐匀了，才闭上眼。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "slept-on-kitchen-bench",
          "weight": 1,
          "text": "被子又被扯走之后，{subject}抱着一件外套到厨房去睡长凳，后背贴着灶口的余温。第二天清早父亲起来生火，看见长凳上的孩子，什么也没问，只把自己的毯子盖了上去。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "睡长凳受了凉"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.06,
              "affection": 0.05,
              "obligation": 0,
              "fear": 0,
              "respect": 0.02,
              "reason": "父亲夜里给孩子盖毯子"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "slept-on-kitchen-bench",
              "text": "厨房的长凳窄得翻身就要掉下来，灶膛里还有暗红的灰。{subject}把外套叠成枕头，闻着煤烟和剩汤的气味，看窗外院子里的灯笼慢慢灭掉。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "slept-on-kitchen-bench",
              "text": "天蒙蒙亮，父亲弯腰往灶里塞柴，回头看见那条毯子滑到地上，便重新盖好，火柴划了两次才点着。",
              "tone": [
                "gentle"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-childhood-household.fever-night",
      "title": "夜里的湿毛巾",
      "weight": 1,
      "rate": 0.0324,
      "conditions": [
        {
          "kind": "age",
          "min": 3,
