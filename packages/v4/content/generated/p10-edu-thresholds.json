        },
        {
          "kind": "cash",
          "householdId": "subject",
          "min": 8
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 17,
          "maxAge": 20
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "official",
          "kind": "official",
