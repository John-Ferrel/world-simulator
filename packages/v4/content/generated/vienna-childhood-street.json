          "narration": [
            {
              "id": "default",
              "key": "fever-scarlet",
              "text": "医生把听诊器贴在{subject}胸口时，母亲站在门口绞围裙。诊费掏空了煤钱，阁楼门板上多了一张红纸条。",
              "tone": [
                "dry",
                "sad"
              ]
            },
            {
              "id": "alt",
              "key": "fever-scarlet",
              "text": "巷子里已经有人家把小孩送去医院。母亲把{subject}挪到阁楼，每天从门缝递进去一碗汤，红纸条贴了十天。",
              "tone": [
                "dry"
              ]
            }
          ]
        }
      ]
