          "narration": [
            {
              "id": "default",
              "key": "signed-with-guardian",
              "text": "公证人的桌上摊着三份纸，边上压着铜制吸水器。{official}念到监护那一段时停了一下，抬眼看看在场的人，才往下念。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "signed-with-guardian",
              "text": "笔尖有旧墨，字写在纸上洇开一点。{sibling}坐在窗边，没看{subject}，只盯着自己鞋尖；文件签完，呼吸声在屋里显出来。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "objection-in-office",
          "weight": 2,
          "text": "念到房子一段，{sibling}抬手说不同意，理由是他这些年也往家里寄过钱。公证人{subject}把文件收回抽屉，说明需要双方再谈一次，约到下周三。走出门时{subject}先说了话，对方没有回，两人在石阶上一左一右地走开。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": -0.08,
              "obligation": 0.04,
              "reason": "公证时当场提出异议"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "事情没能当场办结"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "objection-in-office",
              "text": "“我不同意”这四个字出来时，公证人的手停在纸边。{official}没有争，只把文件推进抽屉，扣上锁，说下周三再来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "objection-in-office",
              "text": "屋里的挂钟走得很响。{sibling}把寄钱的年月说得清楚，{subject}没打断，只在对方说完后把帽子拿在手里，等公证人发话。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "missing-death-certificate",
          "weight": 1,
          "text": "公证人{subject}翻到最后一页，说缺一张死亡证明，眼下办不了，要拖到月底。{subject}回去翻箱子，把旧信封和票据摊了一桌，找到的只有一张洗礼证。家里人开始互相埋怨，说谁当初没把纸收好。最后他先垫钱去补办，把日期记在门后。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "补办证明的手续与跑腿钱"
