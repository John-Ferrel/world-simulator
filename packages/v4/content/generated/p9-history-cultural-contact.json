    {
      "id": "p9-history-cultural-contact.letter-adler",
      "title": "寄往党部的信",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 22,
          "max": 65
        },
        {
          "kind": "hasRole",
          "role": "union_member"
        },
        {
          "kind": "placeKind",
          "in": [
            "union",
            "factory",
            "home"
          ]
        },
        {
          "kind": "cash",
