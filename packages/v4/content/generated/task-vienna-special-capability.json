        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 59
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 25,
          "maxAge": 70
