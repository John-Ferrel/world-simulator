    {
      "id": "p10-edu-work-tasks.qualification-exam",
      "title": "商业学校的毕业考场",
      "weight": 1,
      "rate": 0.0833,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 30
        },
        {
          "kind": "education",
          "in": [
            "primary",
            "apprenticeship"
          ]
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "min": 5
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 30
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "official",
