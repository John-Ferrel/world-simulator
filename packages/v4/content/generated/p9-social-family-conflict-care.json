          "narration": [
            {
              "id": "p9-social-family-conflict-care.christmas-soup.ledger-on-table.alt1",
              "key": "ledger-on-table",
              "text": "账本纸页上还沾着上次的咖啡渍，{subject}用手指点着每一行，{sibling}凑过来看，两人的头几乎碰着。汤锅的咕嘟声盖过说话声，母亲留下的那把勺子在锅沿上搁着。",
              "tone": ["dry"]
