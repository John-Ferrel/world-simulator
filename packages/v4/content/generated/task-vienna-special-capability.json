    {
      "id": "task-vienna-special-capability.repair-machine",
      "title": "停转的踏车",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 59
        },
        {
          "kind": "capability",
          "capability": "craft_affinity"
        },
        {
          "kind": "placeKind",
          "in": [
            "home",
            "factory"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 59
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": true,
          "minAge": 20,
          "maxAge": 60
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": false,
          "minAge": 35,
          "maxAge": 70
        }
      ],
      "outcomes": [
        {
          "id": "bearing-fixed",
          "weight": 55,
          "text": "{subject}让{worker}扶住机头，自己拆开轴套，用锉刀把磨出毛刺的边口修平，又刮掉旧油泥换上一点新脂。飞轮先涩涩地转了两圈，随后顺了，傍晚踏车重新响成缝纫的嗒嗒声。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.05,
              "reason": "亲手修好踏车的轴套与飞轮"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "裁缝铺里传开他能修机器"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.05,
              "reason": "一起把停转的踏车弄转起来"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "bearing-fixed",
              "text": "铺子里全是机油和熨布的气味。{subject}把轴套搁在膝上，锉刀一下一下地走，铁屑落在围裙上。{worker}在旁边扶着机头，等他把飞轮装回去，两个人一起听那声音从刮擦变成均匀的嗒嗒。",
              "tone": [
                "matter-of-fact"
              ]
            },
            {
              "id": "alt",
              "key": "bearing-fixed",
              "text": "他先转半圈，停下来用指腹摸轴颈，再转半圈。{worker}递来一小团棉纱，他把旧油泥擦净，发现磨痕只在一边，便拿锉刀轻轻修过去。装好后他踩了两下踏板，飞轮带着皮带转起来，像有人在屋里轻轻拍手。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "temporary-fix",
          "weight": 25,
          "text": "{subject}把松动的螺丝拧紧，又垫了一小片皮子，机器当天转得动，婚礼礼服赶出了一半。可第二天早上飞轮又卡住，{employer}还是去请了城里的技师，修完说轴已经磨偏，得换件。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "临时修法没能撑过第二天"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.02,
              "reason": "从失败里看出轴已磨偏"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.03,
              "reason": "两人一起熬到傍晚赶活"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "temporary-fix",
              "text": "皮子垫进去时{subject}就有些犹豫，但{worker}已经把料子递到针下。机器转了一下午，第二天清早又发出那种刮擦声。技师蹲下看了看，说轴偏了，临时垫的东西顶不了多久。",
              "tone": [
                "matter-of-fact"
              ]
            },
            {
              "id": "alt",
              "key": "temporary-fix",
              "text": "他把螺丝挨个紧了一遍，手背蹭上黑油。{employer}站在门口问能不能撑到星期天，他点了点头。第二天机器又停住时，店铺还没开门，{worker}在门口跺脚，他蹲在踏车边，一时没再伸手。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "watch-and-learn",
          "weight": 20,
          "text": "{subject}没敢自己拆，请技师来修，自己蹲在旁边递扳手、接油盘，把拆下的零件按顺序摆在报纸上，每一步都记在纸条背面。修完他照着纸条复述了一遍，{worker}说下回可以先拆到轴套为止。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.04,
              "reason": "记下拆装顺序和轴套结构"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.2,
              "reason": "技师修完收的工钱里，他分摊了一点茶钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.04,
              "reason": "两人一起看会了拆装"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "watch-and-learn",
              "text": "技师把零件一个一个卸下来，{subject}就跟着一个一个摆到报纸上，手指点着位置记。油盘快满时他端去倒掉，回来正赶上装机，便蹲得更近，看技师怎样把轴套敲回原位。",
              "tone": [
                "matter-of-fact"
              ]
            },
            {
              "id": "alt",
              "key": "watch-and-learn",
              "text": "纸条上被他画满了圈和箭头，{worker}凑过来看，说这像小孩子画的马路。{subject}没笑，只问轴套那头为什么敲三下。技师走后他把纸条叠好塞进内袋，又在踏车旁站了一会儿才走。",
              "tone": [
                "dry"
              ]
            }
          ]
        }
      ],
      "task": {
        "domain": "work",
        "goals": [
          "work",
          "status"
        ],
        "needs": [
          "cash",
