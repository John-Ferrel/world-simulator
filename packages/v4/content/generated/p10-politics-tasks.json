      "outcomes": [
        {
          "id": "p10-leaflet-distributed",
          "weight": 1,
          "text": "天没亮，传单塞进更衣柜、面包袋和工具箱夹层；午休时楼梯间有人靠着墙逐行读，嘴角动着。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "传单在早班前散发出去"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1.2,
              "reason": "分摊纸张和油墨的钱"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.05,
              "reason": "工友发现更衣柜里的传单并传阅"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-leaflet-distributed",
              "text": "他在更衣室闻着湿油墨味，{worker}探过头来问是不是缩短工时那页，又把纸折成小方块揣进上衣。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-leaflet-distributed",
              "text": "厂门口的面包车里混着传单，有人边咬面包边看；废页在院子角落烧成一小堆灰，扫进排水沟。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-leaflet-handwritten",
          "weight": 0.8,
          "text": "排字工不肯开机，说家里的活不能丢；他和{unionMember}只好手抄五张，贴到市场旁的柱子和面包店窗边。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "没能印出正式传单"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.04,
              "reason": "说服店主允许张贴手抄传单"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.3,
              "reason": "买浆糊和纸"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-leaflet-handwritten",
              "text": "纸边被风卷起来，他用冻僵的手按了按浆糊；面包店老板探出头说别贴门上，贴窗边可以。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-leaflet-handwritten",
              "text": "{unionMember}把写完的一张举到煤气灯下看，字被烟熏得发黄；市场那边已经有赶早市的人停下来看。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-leaflet-confiscated",
          "weight": 0.7,
          "text": "厂门口搜包，传单被门房翻出来没收；他收到一张传唤单，名字写进了门房的记录本。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "传单被查，名字记在门房本上"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "under_summons",
              "add": true,
              "reason": "因分发传单收到传唤单"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "当众被搜包"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-leaflet-confiscated",
              "text": "门房把一叠纸拍在木桌上，边角还带着油墨味；他签字时笔尖在传唤单上顿了顿，{worker}在后面没敢出声。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-leaflet-confiscated",
              "text": "厂门外的风把没收的传单吹得哗啦响，{official}把名字念了一遍，让他下午去办公室一趟。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
