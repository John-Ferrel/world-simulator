            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "收到邀请的意外之喜"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "kraus-invite",
              "text": "{worker}在街角把话带到，说完自己先笑了。{subject}回家点灯重抄那封信，剪掉两段时剪刀在纸上停顿了一下，掉下来的碎纸落进煤油灯罩里。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "kraus-invite",
              "text": "朗读会的地址写在一张便条上，字迹潦草。{subject}把便条压在玻璃镇纸下，翻出那封六页的信默读，读到第三页时忽然觉得语气太冲，自己先摇了摇头。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
