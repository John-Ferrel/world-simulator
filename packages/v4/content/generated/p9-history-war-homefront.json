  "nodes": [
    {
      "id": "p9-history-war-homefront.mobilization-notice",
      "title": "门缝里的动员通知",
      "weight": 1,
      "rate": 0.0324,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 50
        },
        {
          "kind": "historicalProcess",
          "processKind": "war_mobilization",
          "phases": [
            "emerging",
            "mobilizing",
            "confrontation"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 50,
          "sex": "male"
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "official",
          "kind": "official",
          "required": true,
          "minAge": 30,
          "maxAge": 70,
          "organizationKind": "army"
        }
      ],
      "outcomes": [
        {
          "id": "report-and-leave-key",
          "weight": 1,
          "text": "报到日清晨，{subject}把房门钥匙和半个月工钱一共十二克朗塞给{neighbor}，托他每星期给母亲送煤和药。车站里全是穿便服的男人，{official}在月台上点名，点到名字的人把行李扔进车厢。火车开动时，{subject}摸到口袋里那张房租收据，边角已经被汗浸软了。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -12,
              "reason": "把半个月工钱交给邻居照看家里"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.2,
              "obligation": 0.15,
              "reason": "托付钥匙和家用"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "mobilized",
              "add": true,
              "reason": "按通知报到入伍"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "report-and-leave-key",
              "text": "楼梯间里煤油灯还没灭，{neighbor}把钥匙揣进围裙口袋，数了两遍那十二克朗。{subject}没回头，只听见母亲在楼上开窗又关窗。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "report-and-leave-key",
              "text": "车站的钟敲了六下，{official}把名单折起来塞进公文包。{subject}站在最后一节车厢门口，看见{neighbor}举着那张房租收据朝他晃了晃，意思是一切都记下了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "seek-deferment",
          "weight": 1,
          "text": "先没去车站。{subject}在厂门口等到中午，厂主说位置留到月底但工钱不补；又去市政办事处排了一整天队，窗口只递出一张待查的纸条。回到家时{neighbor}正在门口劈引火柴，问{subject}到底走不走，{subject}把纸条折好放进内袋，说等通知。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "排队误工和买面包的开销"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "排了一天队只拿到待查纸条"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.05,
              "reason": "邻居帮着留意消息"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "seek-deferment",
              "text": "办事处走廊里挤了四十多人，空气里有湿大衣和墨水的味道。窗口后的职员把纸条推出来时头也没抬，{subject}看见纸上只印着“待查”两个字和一枚模糊的章。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "seek-deferment",
              "text": "{neighbor}把劈好的引火柴码在门边，说厂里有人昨天已经被带走了。{subject}没接话，只把那张纸条对着灯看，纸边裁得不齐，印泥蹭在指头上。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "leave-by-night-train",
          "weight": 1,
          "text": "报到前一晚，{subject}把行李卷成一个小包，从西站搭夜车去城外的亲戚家。临走前对{neighbor}说家里对外就讲已经收到通知、人按时走了。{neighbor}站在门灯下点了点头，又追出来塞了两个凉土豆，说路上别在站台上买热食。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "邻居塞的凉土豆"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.1,
              "obligation": 0.1,
              "reason": "邻居答应替家里遮掩"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "avoided_mobilization",
              "add": true,
              "reason": "搭夜车离开，没有报到"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "leave-by-night-train",
              "text": "夜车车厢里灯罩蒙着蓝布，一个卖票员来回查票。{subject}把脸转向窗玻璃，外面只有自己的影子和偶尔闪过的站台灯。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "leave-by-night-train",
              "text": "{neighbor}等火车声远了才关门，回屋把{subject}留下的地址抄在烟盒背面。第二天早上有人来问，他说人已经按通知走了，还指了指车站方向。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-history-war-homefront.rationing",
      "title": "面包店门前的配给队",
      "weight": 1,
      "rate": 0.0324,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 70
        },
        {
          "kind": "historicalProcess",
          "processKind": "war_mobilization",
          "phases": [
            "mobilizing",
            "confrontation",
            "repression"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 75
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 30,
          "maxAge": 70,
          "occupation": "Bäcker"
        }
      ],
      "outcomes": [
        {
          "id": "half-loaf-for-children",
          "weight": 1,
          "text": "天没亮{subject}就站在面包店拐角，前面已经排了二十多人。到下午{worker}从柜台后探出头说只剩半炉，每人半份。{subject}把领到的半块黑面包用布包好，自己掰了指甲大的一角尝了尝，剩下的全留给家里的孩子。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 2,
              "reason": "领到的半份黑面包留给家里"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "排了一整天队只吃一点面包边"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "看着面包不够分"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "half-loaf-for-children",
              "text": "面包店门框上挂着块木板，粉笔写着“今日三十份”。{worker}把柜台上的碎屑扫进纸袋，也递给后面的人。{subject}把布包贴在胸口，怕凉了也怕被人看见。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "half-loaf-for-children",
              "text": "队伍里有人开始数前面的人头，数到三十就骂起来。{subject}没作声，只把配给卡捏在掌心，卡边磨得发白。半份面包到手时还带着烤炉的余温。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "buy-flour-from-corner",
          "weight": 1,
          "text": "排队到中午，{worker}挂出“售罄”的牌子。{neighbor}悄悄拉了拉{subject}的袖子，说街角有人有一袋面粉，不要收据。{subject}数出八克朗换回那袋面粉，比配给价贵了一倍多，袋子底下还沾着潮气，回家得先摊在炉边烘干。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -8,
              "reason": "从街角买高价面粉"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": 3,
              "reason": "一袋面粉补充家里主食"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.1,
              "reason": "邻居指了买粮的路子"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "buy-flour-from-corner",
              "text": "街角那人把面粉袋从大衣里挪出来，眼睛一直看着面包店方向。{subject}接过袋子时摸到袋口的绳结是新的，什么也没问，把八克朗折成小方块递过去。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "buy-flour-from-corner",
              "text": "回到院子里，{neighbor}帮{subject}把面粉倒进铁盆，挑出几粒发黑的麦子。两人都没提为什么不走正门，只听见楼上有人在敲配给卡，一下一下的。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "share-card-with-neighbor",
          "weight": 1,
          "text": "轮到{subject}时店里已经没货，{worker}说卡上可以登记明天优先。{neighbor}提出两家合用一张卡轮流排队，多领的那份记在账上，月底一起算。{subject}把卡交出去，在账本上画了一道，旁边写着“面包半份”。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "两家合卡多领的一份"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.15,
              "obligation": 0.1,
              "reason": "合卡轮流排队，账目互认"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "share-card-with-neighbor",
              "text": "账本是{neighbor}从烟盒背面裁的，铅笔头短得捏不住。{subject}划那道线时手有点抖，不是舍不得，是没想到一张卡还能这样用。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "share-card-with-neighbor",
              "text": "{worker}看了看两张卡又看了看他们，没说话，把两份面包一起推出来。{neighbor}把多的一份用围裙兜好，低声说下回轮{subject}睡懒觉，自己来排。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-history-war-homefront.hospital",
      "title": "医院走廊里的第三张床",
      "weight": 0.9,
      "rate": 0.0288,
      "conditions": [
        {
          "kind": "age",
          "min": 18,
          "max": 70
        },
        {
          "kind": "historicalProcess",
          "processKind": "war_mobilization",
          "phases": [
            "mobilizing",
            "confrontation",
            "repression",
            "institutionalizing"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        },
        {
          "key": "doctor",
          "kind": "worker",
          "required": true,
          "minAge": 30,
          "maxAge": 70,
          "occupation": "Arzt"
        }
      ],
      "outcomes": [
        {
          "id": "stay-and-help-nurse",
          "weight": 1,
          "text": "没有床位，{subject}就在走廊里帮护士换床单、烧热水，一直忙到夜里查房。{doctor}路过时看了{subject}一眼，说绷带不够，让明天自己带旧布来。{neighbor}在楼梯口等，递来一块冷掉的土豆饼。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "在医院走廊帮工到深夜"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "在医院帮护士照料伤员"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$doctor",
              "kind": "acquaintance",
              "trust": 0.1,
              "respect": 0.1,
              "reason": "医生记住了这个帮手"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "stay-and-help-nurse",
              "text": "热水桶从走廊这头提到那头，{subject}的指节被铁提手勒出红印。窗边第三张床上的人一直看着天花板，换床单时也没动。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "stay-and-help-nurse",
              "text": "{doctor}的白大褂下摆沾着泥点，说话时眼睛还在看手里的登记板。{neighbor}把土豆饼掰开，一半塞给{subject}，说楼梯口的穿堂风比外面还冷。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "take-wounded-home",
          "weight": 1,
          "text": "{doctor}写了一张换药的单子，说医院走廊不能再加人。{subject}和{neighbor}把伤员扶回自家屋子，腾出靠炉子近的那张床。单子上写着每天换两次纱布，{subject}自己去药房排队，细纱布一小卷要一克朗二十赫勒，先买了三天的量。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -3.6,
              "reason": "买纱布和药水"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": -1,
              "reason": "多一张嘴吃饭"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "friend",
              "trust": 0.2,
              "obligation": 0.15,
              "reason": "一起把伤员接回家照料"
            },
            {
              "type": "condition",
              "personId": "$subject",
              "condition": "fatigue",
              "add": true,
              "reason": "夜里多次起来换药"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "take-wounded-home",
              "text": "药房的队伍排到门外，玻璃柜台上摆着空纱布卷当样品。{subject}数出硬币时，柜台后的人把单子举到灯下看了两遍，才慢吞吞去取货。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "take-wounded-home",
              "text": "伤员一路上没怎么出声，只在进院子时停了一下，问这里是不是九区。{neighbor}替他拉开楼道门，说楼梯窄，扶着墙走。炉子上的水壶一直没撤，换药时正好温手。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "send-to-private-clinic",
          "weight": 1,
          "text": "走廊里确实挤不下，{doctor}写了个地址，说城另一头有家私人诊所也许有床。{subject}和{neighbor}雇了辆手推车把人送过去，诊所先收五克朗押金，收据上的字是紫色的复写纸印。回来的路上手推车空着，轮子响得比去时还清楚。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "私人诊所的押金"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "没能把伤员留在近处"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.1,
              "reason": "一起送伤员去诊所"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "send-to-private-clinic",
              "text": "诊所门口有块铜牌，擦得比医院的门把手亮。{subject}把五克朗放在柜台上，收据从复写纸底下抽出来时还带着潮气。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "send-to-private-clinic",
              "text": "手推车经过运河桥时风很大，{neighbor}把毯子角掖到伤员下巴底下。{subject}在后面推，车轮每转一圈就咯吱一声，像在数路还有多远。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-history-war-homefront.missing-relative",
      "title": "失踪名单上的名字",
      "weight": 0.9,
