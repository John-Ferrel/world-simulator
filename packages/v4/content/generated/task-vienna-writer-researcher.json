      "outcomes": [
        {
          "id": "project-reworked",
          "weight": 2,
          "text": "{subject}把第三十七页从本子上撕下来，碎纸丢进废纸篓，从第一人称重新起笔。三个月里他改成一部五十页的短稿，用挂号寄给{editor}，信封和稿纸花掉一点二克朗，母亲的药费是向{neighbor}借了五克朗才垫上的。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.06,
              "reason": "改换人称重写全书"
