          "kind": "cash",
          "min": 10
        },
        {
          "kind": "placeKind",
          "in": [
            "home",
            "hospital"
          ]
        },
        {
          "kind": "historicalProcess",
          "processKind": "cultural_movement",
          "phases": [
            "emerging",
            "mobilizing",
            "confrontation",
            "institutionalizing"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 22,
          "maxAge": 40
        },
        {
          "key": "freud",
