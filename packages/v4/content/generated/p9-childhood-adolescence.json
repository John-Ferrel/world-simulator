            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "coin-keep-secret",
              "text": "煤油灯的烟把楼梯间熏得发黄，{subject}听见楼下大人数数的声音，把两克朗往他制服口袋里按了按。",
              "tone": [
                "dry"
