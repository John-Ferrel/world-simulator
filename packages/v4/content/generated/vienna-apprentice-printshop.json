              "trust": -0.15,
              "respect": 0.04,
              "reason": "被从正式工候选划掉"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.1,
              "reason": "一起对账"
            }
