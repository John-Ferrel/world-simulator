          "minAge": 16,
          "maxAge": 50
        }
      ],
      "outcomes": [
        {
          "id": "lead-type-drop.scolded",
          "weight": 2,
          "text": "{subject}在{workplace}把整盘8点铅字从字架上碰翻，字块散进过道。{employer}从玻璃隔间出来，用尺子敲桌沿，骂了五分钟，并扣掉当天两个克朗的工钱。{worker}蹲下去替{subject}捡字，小声说“下次用两只手托底”。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "赔偿散落铅字的工钱扣款"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": -0.1,
              "fear": 0.08,
              "reason": "被当众斥责"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.06,
              "reason": "帮忙捡字并提醒手法"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "lead-type-drop.scolded",
              "text": "{subject}在{workplace}碰翻一整盘8点铅字，字块滚了一地。{employer}敲着桌沿骂人，扣下两个克朗。{worker}蹲在过道里帮忙捡字，只说了一句“下次用两只手托底”。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "lead-type-drop.repaired",
          "weight": 1,
          "text": "字块还没捡齐，{worker}把散落的字按字母补回字盘，让{subject}在午休前重新排完那页价目表。{employer}下午翻检时用指甲划过一行，说“排得还直”，没有扣钱，只是让{subject}留下把过道扫干净。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "重新排完一整页价目表",
              "skill": "craft"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.01,
              "reason": "蹲着捡铅字与扫过道"
