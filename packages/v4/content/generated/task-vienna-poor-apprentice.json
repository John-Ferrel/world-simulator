      "outcomes": [
        {
          "id": "relative-introduces-trial-half-day",
          "weight": 1,
          "text": "亲戚把他带到工头面前，工头让他下星期来试半天，先看裁纸和搬版。母亲熨平的衬衫领子还是硬得硌脖子，他站在厂门口把姓名说了两遍。",
          "effects": [
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "half_day_trial_at_big_printshop",
              "add": true,
              "reason": "获得半天试工机会"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$foreman",
              "kind": "acquaintance",
              "trust": 0.04,
              "affection": 0,
              "obligation": 0.02,
              "fear": 0,
              "respect": 0.03,
              "reason": "经亲戚引荐见过工头"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "有了试半天工的机会"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "relative-introduces-trial-half-day",
              "text": "厂门口挂着铜字招牌，亲戚先进去说了几句，工头出来打量他。下星期试半天，先学裁纸。他把姓名报得很清楚。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "relative-introduces-trial-half-day",
              "text": "衬衫领子硬得硌脖子，母亲烫它时用了半个上午。他站在门口听工头吩咐时间，把每句话在脑子里重放一遍。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "foreman-records-name",
          "weight": 1,
          "text": "工头说暂时没有空缺，但答应把他的名字记在招工簿上。亲戚在旁边补了两句好话，工头只点点头；他走出来时，招工簿还摊在门房的木台上。",
          "effects": [
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "name_in_hiring_book",
              "add": true,
              "reason": "名字被记进招工簿"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$foreman",
              "kind": "acquaintance",
              "trust": 0.02,
              "affection": 0,
              "obligation": 0,
              "fear": 0,
              "respect": 0.02,
              "reason": "工头答应记名"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "没有空缺只有空头答应"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "foreman-records-name",
              "text": "门房的木台上摊着招工簿，工头用钢笔写下名字，说有人走就叫人。他盯着那行字看，墨还没干。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "foreman-records-name",
              "text": "亲戚在门口又赔了两句好话。工头点头，把笔搁回墨水瓶，没有抬头。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "relative-refuses-guarantee",
          "weight": 1,
          "text": "亲戚临时反悔，不肯为一个刚离开旧作坊的学徒作保，说自己在厂里还要做人。他站在门口，手里攥着熨平的衬衫袖口，把路上想好的话又咽回去。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "被亲戚放鸽子又拒绝作保"
