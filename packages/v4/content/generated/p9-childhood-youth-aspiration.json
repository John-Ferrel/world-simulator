  "nodes": [
    {
      "id": "p9-childhood-youth-aspiration.trade-school-application",
      "title": "职业学校报名处",
      "weight": 1,
      "rate": 0.09,
      "conditions": [
        {
          "kind": "age",
          "min": 14,
          "max": 16
        },
        {
          "kind": "education",
          "in": ["primary", "apprenticeship"]
        },
        {
          "kind": "cash",
          "min": 5
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 14,
          "maxAge": 16
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 28,
          "maxAge": 65
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "paid-night-class",
          "weight": 2,
          "text": "{subject}把出生证明和小学毕业证摊在桌上，{teacher}数了数克朗，收下第一学期学费，在课程表夜班栏画了个勾。每周三晚六点到九点，教室在二楼，凳子要自己带。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -6,
              "reason": "职业夜校第一期学费"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "注册夜班课程"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.03,
              "reason": "开始接触制图与算术课"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": 0.08,
              "respect": 0.05,
              "reason": "登记报名时与教师的短暂接触"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "paid-night-class",
              "text": "{subject}把六枚克朗按在登记簿旁，{teacher}抬起眼镜看了看他的出生日期，在夜班名单上写下名字。他领到一张油印课程表，纸角还湿着。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "paid-night-class",
              "text": "报名处窗外传来电车铃，{teacher}从抽屉里取出一张夜班课表，指了指周三那一格。{subject}把找回的零钱塞进内袋，出门时数了两遍。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "missing-certificate",
          "weight": 2,
          "text": "{subject}交了钱，{teacher}却把小学毕业证推回来，说印刷模糊，要他下星期三补一份学校盖章的副本。报名表压在桌角，夜班名额只留到星期五。他连跑两趟学校，第二趟才找到管事的人。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "报名手续费与押金"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "证书问题拖住报名"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "needs_school_certificate",
              "add": true,
              "reason": "报名处要求补交盖章毕业证明"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$official",
              "kind": "acquaintance",
              "trust": -0.03,
              "reason": "在报名处被要求补材料"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "missing-certificate",
              "text": "{teacher}用指甲刮了刮毕业证上的印章，说这印子模糊得像被水泡过。{subject}把课程表折好放进口袋，走出教室时听见身后有人问下一个。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "missing-certificate",
              "text": "走廊里{subject}碰到{teacher}正锁门，教师说下星期三之前把副本拿来就行。他数了数兜里的车钱，决定走路去学校，省下四赫勒。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "switched-to-church-class",
          "weight": 1,
          "text": "{subject}凑不够十二克朗的正班学费，在门口站了一会儿，转身去了两条街外的教会补习班。修女收下他，发了一本旧算术册子，说每晚七点来，不要钱，但要帮着擦黑板。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "找到免费补习的出路"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.02,
              "reason": "教会补习班的基础读写练习"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "church_tutoring",
              "add": true,
              "reason": "改上免费教会补习班"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": 0.05,
              "reason": "补习班教师的接纳"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "switched-to-church-class",
              "text": "教会补习班的黑板有裂口，{subject}用湿布擦过两遍。修女把算术册子递给他，封面用铅笔写着上一个学生的名字，已经涂掉了。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "switched-to-church-class",
              "text": "他从职业学校门口走开时，听见里面在搬长凳。拐过街角，教堂侧门开着，{teacher}正往黑板上写乘法表，招手让他进来坐最后一排。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "education",
        "goals": ["knowledge", "status"],
        "needs": ["knowledge", "status"],
        "baseUtility": 1.45,
        "risk": 0.2,
        "skills": ["literacy", "numeracy"]
      }
    },
    {
      "id": "p9-childhood-youth-aspiration.save-for-books",
      "title": "攒钱买一本教科书",
      "weight": 1,
      "rate": 0.08,
      "conditions": [
        {
          "kind": "age",
          "min": 14,
          "max": 17
        },
        {
          "kind": "cash",
          "max": 35
        },
        {
          "kind": "placeKind",
          "in": ["home", "shop", "street"]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 14,
          "maxAge": 17
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": false,
          "minAge": 30,
          "maxAge": 55
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 25,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "bought-used-book",
          "weight": 2,
          "text": "{subject}把火柴盒里的零钱倒在书摊木板上，一枚一枚数出三克朗，换回那本《机械制图》。书脊裂了，他用母亲补袜子的布条重新粘过，当晚就着一盏煤油灯抄下第一页的图例。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -3,
              "reason": "旧书摊买《机械制图》"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.04,
              "reason": "研读制图教科书"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "终于买下想要的书"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.04,
              "reason": "书摊老板少收了五赫勒"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "bought-used-book",
              "text": "书摊上那本《机械制图》被压在一摞旧画报下面，{subject}抽出来时抖落一层灰。{worker}把书翻到缺角那页，说三克朗拿走，他数出最后几枚赫勒，硬币在木板上叮当响。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "bought-used-book",
              "text": "回家路上{subject}把书夹在腋下，怕雨点打湿纸页。进了门，{parent}问他哪来的书，他把粘好的书脊翻过来给母亲看，布条颜色跟袜子一样。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "money-taken-for-coal",
          "weight": 2,
          "text": "{subject}掀开火柴盒，里面的克朗少了七成。{parent}说煤快烧完了，先把钱挪去煤铺。少年没吭声，第二天在图书馆坐了一下午，把书里重要的图例抄到裁开的纸袋上。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "积蓄被挪去买煤"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "攒下的书钱被拿走"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.03,
              "reason": "在图书馆手抄书页"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": -0.04,
              "obligation": 0.06,
              "reason": "书钱被挪作家用"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "money-taken-for-coal",
              "text": "{parent}把火柴盒放回窗台，说等发了工钱再补给他。{subject}把抄好的纸袋叠成小册子，用缝衣针别在一起，封面写了书名，字比平时大。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "money-taken-for-coal",
              "text": "图书馆的暖气片只热半边，{subject}把冻僵的手指凑近灯罩，抄完第三张图纸时闭馆铃响了。他把纸袋夹进课本里，和煤铺的收据一起。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "installment-deal",
          "weight": 1,
          "text": "{subject}跟书摊老板{worker}谈成先付一克朗，剩下的两克朗下月补齐。他把自己跑面包房的路线说给老板听，老板让他把学生证押在摊上。书拿到手，他每晚翻十页，用铅笔在登记卡上画道。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "旧书首付"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "book_debt_2kr",
              "add": true,
              "reason": "欠书摊两克朗，下月补齐"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.03,
              "reason": "按计划研读制图入门"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.07,
              "obligation": 0.05,
              "reason": "书摊老板允许分期付款"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "installment-deal",
              "text": "{worker}把书翻到扉页，用铅笔写上日期和两克朗的欠额。{subject}把学生证放到柜台上的铁盒里，出门时回头看了一眼，证上那张照片拍得比本人精神。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "installment-deal",
              "text": "他把书用旧报纸包好，路过面包房时闻见新出炉的味道，摸了摸口袋里的硬币又松开。到家翻开第一页，纸边还粘着上一任主人留下的干面包渣。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ],
      "task": {
        "domain": "daily",
        "goals": ["knowledge", "survival"],
        "needs": ["cash", "knowledge"],
        "baseUtility": 1.2,
        "risk": 0.1,
        "skills": ["numeracy"]
      }
    },
    {
      "id": "p9-childhood-youth-aspiration.ask-a-mentor",
      "title": "去找那位排字师傅",
      "weight": 1,
      "rate": 0.08,
      "conditions": [
        {
          "kind": "age",
          "min": 14,
          "max": 17
        },
        {
          "kind": "education",
          "in": ["primary", "apprenticeship"]
        },
        {
          "kind": "cash",
          "min": 1
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 14,
          "maxAge": 17
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": true,
          "minAge": 40,
          "maxAge": 65
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": false,
          "minAge": 25,
          "maxAge": 65
        }
      ],
      "outcomes": [
        {
          "id": "weekly-lesson",
          "weight": 2,
          "text": "{subject}在咖啡馆角落找到{worker}，把抄好的字母表铺在咖啡杯旁边。老师傅用手指顺着字母格划过，说每星期天早上来一钟头，先认字盘上的空格和倒字。少年把这句话记在信纸背面。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.05,
              "reason": "排字师傅教授字盘基础"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.1,
              "respect": 0.08,
              "reason": "老师傅答应每周指导"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "typesetting_mentor",
              "add": true,
              "reason": "跟排字师傅学习字盘"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.06,
              "reason": "得到师傅指点"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "weekly-lesson",
              "text": "{worker}把老花镜往鼻梁上推了推，让{subject}用食指在字盘空位上比画。咖啡馆伙计来续水时，老人把字母表折起来，说下星期带旧字样本来看。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "weekly-lesson",
              "text": "少年把没写完的信推到一边，老师傅看了一眼抬头，说字太挤。他让{subject}明早去印刷厂后门，先从擦铅字开始认。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "borrowed-specimen-book",
          "weight": 2,
          "text": "{worker}说自己眼睛不行了，带不了徒弟，但从帆布袋里抽出一本旧字样本，让{subject}拿回去临摹。书皮用麻线缝过三次，扉页上有一行褪色的签名。少年双手接过来，在咖啡馆门口鞠了个躬。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.04,
              "reason": "临摹旧字样本"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.08,
              "affection": 0.03,
              "reason": "老师傅借出私人字样本"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "typesetting_specimen_book",
              "add": true,
              "reason": "持有借来的排字样本"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "咖啡馆里请老师傅喝一杯"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "borrowed-specimen-book",
              "text": "字样本很沉，{subject}把它裹在旧衬衫里夹着走。路过印刷厂时，他停下来看排字房窗户透出的灯，怀里书的麻线硌着肋部。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "borrowed-specimen-book",
              "text": "{worker}用咖啡匙压住书页，说看完就还，别弄上油渍。少年点头，把咖啡钱留在桌上，出门时听见老人咳嗽了两声，又翻开报纸。",
              "tone": ["dry"]
            }
          ]
        },
        {
          "id": "asked-to-come-back-later",
          "weight": 1,
          "text": "{worker}看了看{subject}抄的字母表，说大小不一，让他回去用直尺画格子重抄一遍，下个月再来。少年把纸折好，在咖啡馆门口站了一会儿，走回印刷厂时绕到排字房窗外看了很久。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "被师傅要求先练基本功"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.02,
              "reason": "按要求重新抄写字母"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "mentor_pending_retry",
              "add": true,
              "reason": "下月再去找排字师傅"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.03,
              "respect": 0.05,
              "reason": "老师傅愿意等他下次再来"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "asked-to-come-back-later",
              "text": "老人用指节点了点纸上的字母间距，说连字盘都认不全，急不来。{subject}把信纸和字母表一起收进布袋，出门时把袋口系紧了。",
              "tone": ["matter-of-fact"]
            },
            {
              "id": "alt",
              "key": "asked-to-come-back-later",
              "text": "回家路上他在旧货店橱窗前站住，看里面摆着木格字盘。他比划了一下格子大小，决定今晚先用尺子在烟盒背面练。",
              "tone": ["dry"]
            }
          ]
        }
      ],
      "task": {
        "domain": "education",
        "goals": ["knowledge", "belonging"],
        "needs": ["knowledge", "safety"],
        "baseUtility": 1.25,
        "risk": 0.15,
        "skills": ["social", "literacy"]
      }
    },
    {
      "id": "p9-childhood-youth-aspiration.job-or-school",
      "title": "工钱袋与听课证",
      "weight": 1,
      "rate": 0.09,
      "conditions": [
        {
          "kind": "age",
          "min": 15,
          "max": 17
        },
        {
          "kind": "education",
          "in": ["primary", "apprenticeship"]
        },
        {
          "kind": "cash",
          "max": 60
        },
        {
          "kind": "hasRelation",
          "relationKind": "kin",
          "minTrust": 0.2
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 15,
          "maxAge": 17
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 30,
          "maxAge": 55
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": true,
          "minAge": 32,
          "maxAge": 68,
          "organizationKind": "factory"
