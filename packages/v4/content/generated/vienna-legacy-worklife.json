    }
  ],
  "nodes": [
    {
      "id": "vienna-legacy-worklife.hours-ledger",
      "title": "工时表上的一行改动",
      "weight": 1,
      "rate": 0.0432,
      "conditions": [
        {
          "kind": "legacy",
          "legacyKind": "reform"
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": false,
          "minAge": 25,
          "maxAge": 75
        }
      ],
      "outcomes": [
        {
          "id": "hours-ledger.sign",
          "weight": 1,
          "text": "{subject}在维也纳第十区工场的油墨未干的工时表上按下拇指印，接受每周少拿四十赫勒的计件差额，换来星期六下午的空闲。指纹留在表格边缘，擦也擦不掉。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "星期六下午减少的计件工钱"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "第一次按自己的意愿留下名字"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "accepted_hours_reform",
              "add": true,
              "reason": "在工时表上按了手印"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "hours-ledger.sign",
              "text": "老工人凑近看那张表，说这纸比工资袋还薄。{subject}把拇指蘸进印泥，按下去时听见工头说了句“下一个”。学徒在旁边数少掉的铜板，数到四十赫勒时不出声了。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "hours-ledger.sign",
              "text": "印泥是赭红色的，像干了的面包瓤。{subject}按完手印，工头把表举到窗边吹干，阳光里那张纸透出指印的轮廓。楼下第十区的街面传来运煤车的铁皮声，星期六下午突然显得很宽。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "hours-ledger.refuse",
          "weight": 1,
          "text": "{subject}拒绝按手印，把工时表推回工头面前，指出上个月被拖欠的计件工资还有八克朗没结。工头说表是上头贴的，欠账是账房的事，两件事不能混在一起谈。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 8,
              "reason": "追回的拖欠计件工资"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "被工头记成不肯配合的人"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.06,
              "reason": "工友看到有人敢开口要欠账"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "hours-ledger.refuse",
              "text": "工头把表折成四折塞进围裙口袋，说“你会后悔的”。{subject}当天下午去账房窗口排队，窗上的铁栅栏有股锈味。账房先生翻了半天蓝皮本子，最后从抽屉里数出八克朗硬币，一枚一枚推过台面。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "hours-ledger.refuse",
              "text": "学徒在旁边小声说，拒绝按手印的人名字会被单独抄在一张纸上。{subject}没接话，把八克朗换成一克朗的硬币，数给家里时硬币在桌上滚了两圈才停。屋里的煤油灯芯剪得太短，光只够照亮手边的桌面。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "hours-ledger.read-for-others",
          "weight": 1,
          "text": "{subject}替不识字的工友读工时表，一行一行念到星期六那栏，发现有两个人的名字被漏掉了。工头说漏掉的是临时工，{subject}把这两个名字用铅笔头补在表格背面。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.04,
              "reason": "逐行读表并补记名字"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.08,
              "reason": "替工友读出表上的内容"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "工友开始找这个人读通知"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "hours-ledger.read-for-others",
              "text": "铅笔头短得捏不住，{subject}把它夹在两指之间，在表格背面写下两个名字。被漏掉的人一个叫扬，一个叫弗兰茨，都是每天清早从火车站走来的临时工。工头看了一眼背面，没说话，把表贴回墙上。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "hours-ledger.read-for-others",
              "text": "围过来的工友有七八个，有人把耳朵凑到{subject}嘴边，怕听漏一个数字。念到“星期六下午停工”时，人群里有人笑了一声，又马上收住。墙上的表被风掀起一角，{subject}用拇指按住，继续往下念。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ]
    },
    {
      "id": "vienna-legacy-worklife.union-office",
      "title": "工会办公室的欠账",
      "weight": 1,
      "rate": 0.04,
      "conditions": [
        {
          "kind": "legacy",
          "legacyKind": "reform"
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 75
        }
      ],
      "outcomes": [
        {
          "id": "union-office.post-ledger",
          "weight": 1,
          "text": "{subject}把旧欠款的账页抄在一张大纸上，贴在工会办公室门边的墙上，数字旁边注明是哪一年、哪一次运动留下的。老成员站在纸前看了很久，新来问入会的人也在看。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "把账目公开让会员自己判断"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "邻居看到账目被摊开"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "union_ledger_public",
              "add": true,
              "reason": "主张把旧账公开"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "union-office.post-ledger",
              "text": "浆糊是隔夜的，刷上去时带着股酸味。{subject}把纸四角按平，有人凑近念出“一九〇一年，欠三十四克朗”。办公室里的椅子腿不平，坐在上面的人一动就晃，可没人起身。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "union-office.post-ledger",
              "text": "窗外是维也纳第十五区的一条窄街，卖烤栗子的炉子冒着白烟。{subject}贴完纸退后两步看，发现“欠”字被浆糊洇开了一点。老成员没说话，只把眼镜摘下来擦了又擦。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "union-office.enroll-first",
          "weight": 1,
          "text": "{subject}先给窗外站着的人办入会，收下第一笔会费一克朗，在名册上写下名字和住址。欠账的事被推到下次会议，老成员把账本合上，合得很轻。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 1,
              "reason": "新会员的入会费先记在桌上"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.05,
              "reason": "替来问的人办了入会"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.03,
              "reason": "在账目争执中先接待新人"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "union-office.enroll-first",
              "text": "来问入会的是个瘦高的年轻人，帽檐捏在手里，说自己在第十六区的织布厂做了半年。{subject}把名册翻到空白页，蘸水笔尖在“住址”那栏停了一下，等他报出街名。老成员在角落里把账本合上，声音很轻。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "union-office.enroll-first",
              "text": "一克朗硬币在桌上排开。{subject}数了两遍，才在名册上写“已缴”。窗外有人探头问这里是不是工会，接待的人这次知道怎么开口了，把门拉开一半。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "union-office.write-off",
          "weight": 1,
          "text": "{subject}主张销掉旧账，说当年的承诺没有全部兑现，硬追下去只会让新成员以为工会只会翻旧本子。老成员把账本推到桌子中间，让在场的人一个一个表态。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "销账主张引来老成员的不满"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": -0.03,
              "reason": "邻居觉得不该把旧账一笔勾销"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "union_debt_written_off",
              "add": true,
              "reason": "主张销掉工会旧欠款"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "union-office.write-off",
              "text": "账本的纸边已经发毛，{subject}翻到那一页时，手指沾上一层灰。有人说“三十四克朗够买两袋面粉”，没人接话。最后举手表决，赞成销账的手比反对的多两只，老成员把手放下去时，椅子又晃了一下。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "union-office.write-off",
              "text": "窗外有人来问入会，接待的人一时不知道怎么开口，{subject}替他说“进来坐”。老成员把账本拿回去，用一块旧布包好，放进抽屉最里面。抽屉关上的声音比平时响。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ]
    },
    {
      "id": "vienna-legacy-worklife.apprentice-wage",
      "title": "学徒的第一张工资袋",
      "weight": 1,
      "rate": 0.0384,
      "conditions": [
        {
          "kind": "legacy",
          "legacyKind": "reform"
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": false,
          "minAge": 25,
          "maxAge": 75
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 65
        }
      ],
      "outcomes": [
        {
          "id": "apprentice-wage.hand-to-family",
          "weight": 1,
          "text": "{subject}把工资袋原封不动交给家里，只抽出两枚十赫勒的硬币留作车钱。母亲数了数，比上个月多出六枚，问是不是算错了，{subject}说新规定就是这么算的，没再多讲。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 3,
              "reason": "按新规定多出的学徒工资交给家里"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "多出的钱换了一顿晚饭的面包和猪油"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.04,
              "reason": "师兄看到工资袋没有声张"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "apprentice-wage.hand-to-family",
              "text": "工资袋上的油墨还没干透，{subject}的手指染了一点黑。母亲把硬币倒在厨房桌上，一枚枚排开，排到第六枚时停住。灶上的水壶响了，她拿起来又放下，没继续问。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "apprentice-wage.hand-to-family",
              "text": "家里那间屋子朝北，下午的光只够照亮桌角。{subject}把车钱塞进外套内袋，听见母亲在数硬币时嘴里念念有词。师兄说过别到处讲，{subject}就没讲，连妹妹问起也只说“够用”。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "apprentice-wage.ask-master",
          "weight": 1,
          "text": "{subject}拿着工资袋回到柜台前，问掌柜为什么师兄的袋子里没有多出这几枚硬币。掌柜说师兄的工钱另算，又补了一句“暂时的”。师兄站在旁边，把脸转向窗外。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "掌柜觉得学徒多嘴"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": -0.05,
              "reason": "师兄被当众问起工钱"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.03,
              "reason": "对照两张工资袋算差额"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "apprentice-wage.ask-master",
              "text": "柜台上摊着两张工资袋，一张油墨新，一张已经磨毛了边。{subject}把两袋并排放，掌柜伸出食指把旧的拨到一边，说“你管好自己的”。师兄在窗口看街对面修鞋摊，一直没回头。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "apprentice-wage.ask-master",
              "text": "掌柜的木尺敲了两下柜台，声音短促。{subject}把问题又问了一遍，掌柜才说师兄是“老规矩进来的”。师兄这时转过身，笑了一下，笑得不太自然，说“没事，你问得对”。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "apprentice-wage.beer-with-senior",
          "weight": 1,
          "text": "{subject}请师兄去街角酒馆喝一杯，花掉十二赫勒。师兄喝了半杯才说，当年争工时的人里有一个后来被工场辞了，名字没留在任何表上。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "请师兄喝一杯啤酒"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.09,
              "reason": "一杯酒换来的旧事"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.03,
              "reason": "在酒馆里打听工场旧事"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "apprentice-wage.beer-with-senior",
              "text": "酒馆在街角，门楣低，进去要低头。啤酒是温的，杯口有泡沫挂在边上。师兄用指尖在桌上画了一道，说辞掉的那个人叫莱奥，走的时候连工具都没让带。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "apprentice-wage.beer-with-senior",
              "text": "十二赫勒换来两杯淡啤酒，找零是四枚一赫勒的铜币。{subject}把铜币收好，听师兄讲那年冬天的事，讲到一半师兄停了停，说“你别到处讲”。酒馆里有人拉手风琴，声音盖过了后半句。",
              "tone": ["matter-of-fact"]
            }
          ]
        }
      ]
    },
    {
      "id": "vienna-legacy-worklife.sick-fund",
      "title": "病假簿与互助金",
      "weight": 1,
      "rate": 0.0384,
      "conditions": [
        {
          "kind": "legacy",
          "legacyKind": "reform"
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 18,
          "maxAge": 65
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 75
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 25,
          "maxAge": 70
        }
      ],
      "outcomes": [
        {
          "id": "sick-fund.fill-form",
          "weight": 1,
          "text": "{subject}替晕倒的工友填病假表，填完自己走去衙门排队。窗口前的队伍拐过走廊，排到日落才轮到。办事员把表翻来覆去看了三遍，盖了一个章，说药费要等复核。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "在衙门走廊站了大半天"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.09,
              "reason": "替工友填表并排队"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "literacy",
              "amount": 0.04,
              "reason": "照着规章逐栏填病假表"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "sick-fund.fill-form",
