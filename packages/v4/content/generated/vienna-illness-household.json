            },
            {
              "id": "partner-away",
              "key": "neighbor-help-night",
              "text": "{subject}正没主意，{neighbor}敲门进来，带了热水和退烧药。孩子清晨安静下来，{subject}切了半块面包还这份人情。",
              "tone": [
                "matter_of_fact"
              ]
            }
          ]
