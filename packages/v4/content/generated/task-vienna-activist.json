      ],
      "outcomes": [
        {
          "id": "speak-meeting-motion-passed",
          "weight": 1,
          "text": "他站起来把工价和工时一笔一笔报清楚，说计件单价三个月里降了两成。后屋安静下来，只有那只钟在走。主持人敲了敲啤酒瓶，动议以二十三票对九票通过，有人当场把数字记在烟盒背面。",
          "effects": [
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "在会议上清晰陈述工价问题并推动动议通过"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.05,
              "reason": "面对四十多人发言并说服会议"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$chair",
              "kind": "acquaintance",
              "trust": 0.08,
              "respect": 0.06,
              "reason": "主持人认可他的发言效果"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "speak-meeting-motion-passed",
              "text": "他手里捏着一张工价条，念到第三个数字时声音稳了下来。靠墙站着的人往前挪了半步，长凳吱呀响了一声。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "speak-meeting-motion-passed",
              "text": "烟盒背面写满了正字，主持人把半瓶啤酒推到桌角，好腾地方放名单。表决时手臂举得高低不齐，但数下来够了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "speak-meeting-shouted-down",
          "weight": 1,
          "text": "他刚说到罢工基金，靠门那排就有人喊“先顾眼前”。话头被截断两三次，后屋分成两片声音，主持人敲桌子也没压住。散会时一个老工人拍拍他肩膀说太急了，他出门才发现手心全是汗。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.09,
              "reason": "发言被嘘声打断，会议出现分裂"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "部分会员认为他操之过急"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$chair",
              "kind": "acquaintance",
              "trust": -0.02,
              "reason": "发言引发争执，主持人难以控制会场"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "speak-meeting-shouted-down",
              "text": "“罢工基金”四个字刚出口，门边就有人把帽子往桌上一摔。他停了两秒想接话，另一个声音又从角落顶上来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "speak-meeting-shouted-down",
              "text": "主持人把钟往桌中间推了推，可没人看时间。散会后长凳挪得横七竖八，半瓶啤酒还立在桌角没动。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "speak-meeting-yields-floor",
          "weight": 1,
          "text": "他站到桌边，看见旁边老工人的手一直举着，指节上全是裂口。他把发言让了出去，自己坐回长凳上听。老工人讲完，主持人问还有没有补充，他摇了摇头，把口袋里写好的提纲又折了一道。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "让出发言机会，略感失落但平静"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$chair",
              "kind": "acquaintance",
              "trust": 0.04,
              "reason": "主动让出发言，主持人记下他的自制"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "yielded_floor_at_meeting",
              "add": true,
              "reason": "在会议上把发言机会让给老工人"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "speak-meeting-yields-floor",
              "text": "老工人站起来时膝盖响了一声，后屋自动静了。他把提纲塞回内袋，纸角戳着肋骨，不怎么舒服。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "speak-meeting-yields-floor",
              "text": "主持人朝老工人点了点头，又看了他一眼。他摆摆手，把长凳往墙边挪了挪，给后来的人腾出站的地方。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
