            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "被看作传闲话的人"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "意识到自己传了不该传的话"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "neighborhood-rumor.spread-further",
              "text": "面包店柜台前排队的人伸着脖子听，{subject}压低声音把楼道里的话讲了一遍，末尾还加了一句“我早觉得不对劲”。面粉的气味里，有人点头，有人只是把硬币往前推。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "neighborhood-rumor.spread-further",
              "text": "他本来只想说两句，可面包店的人问得仔细，他就把听来的细节都倒了出来。后来在楼梯上碰见三楼的女人，对方把脸转向墙，他才觉得话说多了。",
              "tone": ["matter-of-fact"]
            }
          ]
        },
        {
          "id": "neighborhood-rumor.warn-lock",
          "weight": 1,
          "text": "{subject}没有跟着传话，只在楼梯上提醒{neighbor}把门锁换掉，免得债主找错门。{neighbor}半信半疑，还是让看门人换了锁芯，事后没道谢，也没再提这件事。",
          "effects": [
            {
              "type": "cash",
