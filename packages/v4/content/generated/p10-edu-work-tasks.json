      "outcomes": [
        {
          "id": "p10-edu-work-tasks.request-transfer.approved",
          "weight": 1,
          "text": "{employer}在调岗申请上签了字，工钱不变。新车间在十七区边上，他每天少走四十分钟，班次固定。报到那天新工头把他当外人，图纸只给他看半张，他先记下机器摆位，没多问。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "新车间的熟手",
              "wage": 0,
              "workplaceId": "$workplace",
              "reason": "调岗获批，工钱不变"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": 0.03,
              "reason": "通勤缩短，休息时间增加"
