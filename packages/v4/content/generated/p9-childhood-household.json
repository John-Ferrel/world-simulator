        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 6,
          "maxAge": 11
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 25,
          "maxAge": 55
        },
        {
          "key": "sibling",
          "kind": "sibling",
