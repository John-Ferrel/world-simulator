      ],
      "tags": [
        "technical_school",
        "entrance",
        "higher_education"
      ],
      "outcomes": [
        {
          "id": "reject-prep",
          "weight": 2,
          "text": "数学和制图都过了线，德语作文差一分。{teacher}把成绩单推过来，说先读一年预科再考。{official}在报名表背面写了预科学费和三门课的时数。{worker}在门口等着，听他说完，把手里替他提的书接了过去。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "德语作文差分落榜"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "技术学院差一分可先读一年预科再考",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$official",
              "visibility": "private",
              "trueInWorld": true
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "acquaintance",
              "trust": 0.06,
              "reason": "落榜后同行一段路"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "reject-prep",
              "text": "布告上的录取名额用黑框围起来，下面是各科分数线。{subject}在德语一行来来回回看，那一分写在括号里。{teacher}把预科班的说明纸裁了一半递给他，边角还带着裁纸的毛。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "reject-prep",
              "text": "报名桌后面的{official}把考试费收据和成绩单一起递出来，纸上有复写的紫色字迹。预科班在同一个院子里上课，走廊尽头能看见制图室的窗子。{worker}说，先去把书看了再想。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "drawing-fail",
          "weight": 2,
          "text": "考试费交了，制图题把比例写错，图的右下角挤出了框。{official}收卷时扫了一眼没有说话。未被录取，{subject}把那张图纸带回家，用图钉贴在床头墙上，正好盖住旧课表留下的四个针眼。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -3,
              "reason": "技术学院考试报名费"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.15,
              "reason": "制图比例画错落榜"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.03,
              "reason": "从错图里记住了比例"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "kept_failed_drawing",
              "add": true,
              "reason": "把落榜的图纸贴在墙上"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "drawing-fail",
              "text": "制图室里全是铅笔划纸的声音，尺子压住纸边，他的手心把纸角压出了汗渍。收卷时他把错的地方又看了一遍，才把纸递出去。回家路上他把图纸卷成筒，握在手里不松。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "audit-semester",
          "weight": 1,
          "text": "作坊师傅的推荐条起了作用，教授同意让他旁听一学期。学费照交，考试资格要看期末成绩，座位在阶梯教室最后一排，得自己带凳子。{teacher}把课表抄给他，又多写了一行：旁听生没有学籍。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -8,
              "reason": "技术学院旁听学费"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "higher",
              "level": 1,
              "reason": "以旁听身份入读技术学院"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "auditing_higher_course",
              "add": true,
              "reason": "旁听一学期，无正式学籍"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "audit-semester",
              "text": "教授的办公室在二楼拐角，推荐条在桌上摊开。{teacher}念了一遍条子上的评语，教授用铅笔在课表边上写了“旁听”两个字。走廊里贴着正式生的名单，{subject}从头看到尾，没有自己的名字。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "audit-semester",
              "text": "阶梯教室最后一排没有固定座位，他第二天就带了一张折叠凳。讲台上的人讲投影和应力，粉笔灰在光里慢慢落。下课他追着黑板上的图抄，本子最后一页不够，就写到了封底上。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    }
  ]
}
