  "nodes": [
    {
      "id": "p10-edu-thresholds.buergerschule-exam",
      "title": "商业学校的入学考试",
      "weight": 1,
      "rate": 0.0272,
      "conditions": [
        {
          "kind": "age",
          "min": 12,
          "max": 14
        },
        {
          "kind": "education",
          "in": [
            "primary"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 12,
          "maxAge": 14
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 30,
          "maxAge": 55
        }
      ],
      "tags": [
        "exam",
        "buergerschule",
        "admission"
      ],
      "outcomes": [
        {
          "id": "exam-pass",
          "weight": 2,
          "text": "算术十二题全部写完，听写只把“Kassa”拼错一个字母。口试时{teacher}问父亲的职业，{subject}把住址和父亲在纺织厂做帮工说得清清楚楚。楼下{parent}手里那张学费单被汗浸软。九月一号，录取通知连同七克朗的缴费单一起塞进信箱。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "被商业学校录取"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -7,
              "reason": "缴纳商业学校入学费用"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.12,
              "reason": "收到录取通知"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "exam-pass",
              "text": "走廊里一百多个孩子挤成一排，编号纸被捏出折痕。口试房间里只有一张桌子，{teacher}的声音不高，{subject}把每个字都说足。出来时母亲还没敢问，只是把课程介绍又折了一道。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "exam-pass",
              "text": "铅笔写到只剩一小截，算术的最后一题是折扣计算。{subject}验算两遍才交卷。九月那天，{parent}拿着录取通知站在楼梯口念给邻居听，缴费单上七克朗的数目被念得格外慢。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "exam-waitlist",
          "weight": 2,
          "text": "听写念到第三句时，{subject}一走神漏掉整行，后面的词就再也接不上。算术对了九题，名次落到第二十九，正好在二十八名之外。{teacher}在教室门口说九月再来问有没有空位。{parent}把学费单折成小方块，说先别扔。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.15,
              "reason": "考试名次落到候补"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "商业学校只录二十八人，九月或许有空位补入",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$teacher",
              "visibility": "private",
              "trueInWorld": true
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "未直接录取"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "exam-waitlist",
              "text": "外面下着小雨，母亲在楼下等了一个多钟头，鞋边潮了。{subject}把编号纸塞进口袋，没有讲漏掉的那一行，只说老师让九月再来。回家路上两人都没怎么说话。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "exam-waitlist",
              "text": "走廊尽头的布告贴出名次，二十九号被红笔圈在候补里。{parent}踮脚看了两遍才认出来，问监考的{teacher}是不是还有机会。老师说，九月开学头一天来问，有人不来就有位子。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "exam-fever",
          "weight": 1,
          "text": "考试前夜{subject}发起烧来，额头烫手，{parent}把湿布敷在他脑门上，劝他别去。天刚亮他还是出了门，走到市民学校二楼时腿发软，算术只做了一半就趴在桌上。出门时他把铅笔折成两截，扔进阴沟。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "带病赴考加重发热"
            },
            {
              "type": "condition",
              "personId": "$subject",
              "condition": "fever",
              "add": true,
              "reason": "考试前夜起的烧没有退"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.18,
              "reason": "算术只做了一半"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "exam-fever",
              "text": "教室里墨水和湿羊毛外套的气味混在一起。{subject}握笔的手一直抖，横线画不直，格子里的数字叠在一起。监考的{teacher}看了他一眼，没说什么，只把窗子推开一条缝。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "exam-fever",
              "text": "回家路上{parent}把手贴在他后颈上试温度，另一只手提着他没吃完的面包。路过街角药房时她停了停，看了看橱窗里的退烧粉价钱，又拉着他继续往前走。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p10-edu-thresholds.realschule-scholarship",
      "title": "一张减免学费的申请表",
      "weight": 1,
      "rate": 0.0272,
      "conditions": [
        {
          "kind": "age",
          "min": 13,
          "max": 16
        },
        {
          "kind": "education",
          "in": [
            "primary"
          ]
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "max": 40
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 13,
          "maxAge": 16
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 30,
          "maxAge": 60
        },
        {
          "key": "official",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 65
        }
      ],
      "tags": [
        "scholarship",
        "realschule",
        "fees"
      ],
      "outcomes": [
        {
          "id": "grant-approved",
          "weight": 2,
          "text": "校长在推荐栏里写了“勤勉、算术突出”。{parent}从厂里要来盖红章的工资单，房东的租金收据也凑齐了。星期三中午{subject}把表格递进窗口，{official}翻了一遍，说学费减半，书本费还得自家出。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "status": "secondary",
              "level": 1,
              "reason": "获得减免后升入实科中学"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -6,
              "reason": "自付书本费"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "获得基金会减免"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": 0.08,
              "reason": "校长写了推荐信"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "grant-approved",
              "text": "工资单上油印的数字被{parent}折得起了毛。收据用别针别在表格角上，{subject}数了三遍才放进信封。窗口里的{official}用指节敲了敲桌面，把减半后的数目念给他听。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "grant-approved",
              "text": "校长办公室里有旧书和烟斗的气味。{teacher}写完推荐语，把笔搁下看了看他，说名次排在前面的几个人里，只有他家里拿不出书本费。星期五中午前表格就交上去了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "grant-missed",
          "weight": 2,
          "text": "表格上缺一张租金收据。{subject}先跑房东家，铁门锁着；再跑一趟，房东太太说收据本在她丈夫身上。等他拿着纸条赶回学校，星期五中午的窗口已经关上，玻璃后面只剩一张椅子。{official}让他明年再申请。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.16,
              "reason": "错过申请截止"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -0.6,
              "reason": "两天来回的电车钱"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "基金会减免申请缺一份房东租金收据，窗口只在星期三和星期五开",
              "confidence": 0.85,
              "sourceKind": "witnessed",
              "personId": "$official",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "grant-missed",
              "text": "第二次去房东家时，楼道里正在烧煤，气味呛人。房东太太翻了半天围裙口袋，只找出半张空白纸条。{subject}一路小跑到学校，台阶上的影子已经拉得很长，窗口的木板正在往下放。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "grant-missed",
              "text": "{parent}在厂门口等下班的人，替儿子讨回那张工资单时手冻得发红。表格填好了，只差一张收据。{teacher}在走廊里碰见他，听他说完，只拍了拍他的肩膀，说功课别落下。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "grant-second",
          "weight": 1,
          "text": "基金会只给年级第一名减免全部费用，第二名减一半。{subject}的名次差两位，表格被归进“未获”那一摞。回家后他把那份通知从中间剪开，夹进算术课本的封皮里，压平了折痕。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.1,
              "reason": "申请未获准"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "saved_scholarship_notice",
              "add": true,
              "reason": "把基金会通知剪下夹进课本"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "竞争减免未成功"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "grant-second",
              "text": "公告栏前站着六七个学生，名字和名次用蓝墨水写成两栏。{subject}从上往下数，数到自己的名字就停了。{teacher}在旁边说，成绩再往前挪两位就有希望，窗帘绳在他手里轻轻晃着。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "grant-second",
              "text": "剪下来的通知只有巴掌大，他妈妈问剪这做什么，他说留着。晚上点灯做习题时，那页纸从课本里滑出来，折痕朝着灯光，纸边已经起了毛。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p10-edu-thresholds.leave-school-for-work",
      "title": "学年中途空出来的座位",
      "weight": 1,
      "rate": 0.0272,
      "conditions": [
        {
          "kind": "age",
          "min": 13,
          "max": 16
        },
        {
          "kind": "education",
          "in": [
            "primary"
          ]
        },
        {
          "kind": "cash",
          "householdId": "subject",
          "max": 25
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 13,
          "maxAge": 16
        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 30,
          "maxAge": 55
        },
        {
          "key": "teacher",
          "kind": "teacher",
          "required": true,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": true,
          "minAge": 35,
          "maxAge": 70
        }
      ],
      "tags": [
        "dropout",
        "factory",
        "family_money"
      ],
      "outcomes": [
        {
          "id": "leave-for-factory",
          "weight": 2,
          "text": "星期一早上{subject}去厂里报到，{employer}让他先搬纱锭。他从学校领回自己的课本，{teacher}在门口把没发下来的毕业证明的事说了一遍。工钱按周结，头一周扣掉工具押金，带回家的钱只够买两天的面包。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "status": "none",
              "level": 0,
              "reason": "学年中途退学进厂"
            },
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "纺织厂童工",
              "wage": 5,
              "workplaceId": "$workplace",
              "reason": "替代减薪的父亲养家"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.12,
              "reason": "离开学校进厂"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "leave-for-factory",
              "text": "桌上一头是招工条，一头是课表，{parent}的手在两样东西之间来回摸。{teacher}说再读一年就有毕业证明，声音放得很低。星期一学校还没上课，{subject}已经站在厂门口看人刷卡上班。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "leave-for-factory",
              "text": "课本用旧报纸包成一捆，{subject}抱回家时胳膊勒出印子。车间里棉絮浮在光柱中间，机器的响声盖过一切。{employer}隔着棉絮喊了一声，让他在下班前把那堆纱锭搬完。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "half-time-study",
          "weight": 2,
          "text": "和{parent}谈到后半夜，说定再读半年：白天上课，放学后去面包铺送面包。{teacher}替他去问，学校同意先留着座位。第一周他送完最后一篮面包回到家，作业本上的字已经开始打晃。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "面包铺送货车工",
              "wage": 3,
              "workplaceId": "$workplace",
              "reason": "半工半读补贴家用"
            },
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 2,
              "reason": "半工半读的第一笔工钱"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "白天上课夜里送面包"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "half_time_school",
              "add": true,
              "reason": "学校同意保留学籍"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "half-time-study",
              "text": "面包篮的皮带磨着肩膀，冬天里一路都是炉子的余温。送完最后一趟，他把空篮子倒扣在铺子门口，抬头看了一下钟。回到家里，{parent}把留好的汤从炉子上端下来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "half-time-study",
              "text": "{teacher}在办公室里翻出一张旧表，说半工半读要家长按手印。{parent}把拇指按在印泥上时犹豫了一下，还是按了。第二天{subject}背着书包和面包篮一起出门，两样东西在楼梯上撞得直响。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "keep-enrollment",
          "weight": 1,
          "text": "{teacher}写了一封半工半读的申请，学校同意保留学籍到学年末，厂里只肯按日结钱，没有固定工位。{subject}每逢星期一、三、五去上工，回来时天已经黑透，就在厨房桌上补课。父亲的工钱仍少一成，但家里没有断粮。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "码头日结搬运工",
              "wage": 4,
              "workplaceId": "$workplace",
              "reason": "按日结钱的临时工"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "enrollment_retained",
              "add": true,
              "reason": "学校保留学籍到学年末"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$teacher",
              "kind": "acquaintance",
              "trust": 0.1,
              "reason": "老师替他写了半工半读申请"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "还有书可读"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "keep-enrollment",
              "text": "厨房桌上的油灯芯剪得很短，作业本摊在面包板和盐罐之间。{parent}把父亲的旧外套改小给他做工服，针脚粗，袖口卷了好几道。厂里按日点工钱，每天在铁盒里放几个铜币。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "keep-enrollment",
              "text": "申请纸上有{teacher}写的“该生勤勉，家境困难”几个字，下面盖着学校的小圆章。厂里的{employer}看完只说了一句：想来就来，按天算。{subject}把回执叠好，夹在课表和招工条中间。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p10-edu-thresholds.night-school-fee",
      "title": "夜校报名处的最后一张椅子",
      "weight": 1,
      "rate": 0.0256,
      "conditions": [
        {
          "kind": "age",
          "min": 14,
          "max": 18
        },
        {
          "kind": "employment",
