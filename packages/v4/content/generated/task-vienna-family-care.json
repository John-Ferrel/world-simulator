    {
      "id": "task-vienna-family-care.room-move",
      "title": "换到朝北的小间",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
        {
          "kind": "age",
          "min": 25,
          "max": 59
        },
        {
          "kind": "overcrowded",
          "value": true
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 25,
          "maxAge": 59
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 30,
