      "outcomes": [
        {
          "id": "negotiate-employer-partial",
          "weight": 1,
          "text": "厂长用指甲刮着怀表盖，听完被扣工资的数目，答应先补一半，下月再谈工时。门外的工人接过补发的几张克朗，数了两遍。厂长把常春藤上枯掉的叶子摘了一片，说到此为止，一刻钟刚好。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 1.5,
              "reason": "争取到部分补发工资"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "在谈判中为工人争取到部分补偿"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.1,
              "reason": "被扣工资的工人拿到部分补偿"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "negotiate-employer-partial",
              "text": "怀表盖弹开又合上，厂长把那张写满数字的纸转了个方向。门外工人接过钱时，拇指在纸币边缘来回搓。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "negotiate-employer-partial",
              "text": "窗台上的常春藤耷拉着，厂长摘掉一片枯叶才开口。他听完补一半的数，把纸折好，没再追问工时的条款。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "negotiate-employer-locked-out",
          "weight": 1,
          "text": "厂长没等他说完就叫来门房，说今天谈不出结果。第二天车间门口贴出停工通知，纸边用四颗图钉钉着，他去问门房，门房只指了指通知上的日期。两个被扣工资的工人站在旁边，谁也没说话。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "印刷工",
              "wage": 0,
              "workplaceId": "$workplace",
              "reason": "被厂长叫门房请出后车间停工"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.12,
              "reason": "谈判破裂导致停工通知"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$employer",
              "kind": "employer",
              "trust": -0.15,
              "fear": 0.08,
              "reason": "厂长拒绝谈判并采取停工手段"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "negotiate-employer-locked-out",
              "text": "门房的手掌抵在他后背上，不算用力，但方向很明确。他回头看，厂长已经把怀表收进马甲口袋，常春藤在窗台上晃了晃。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "negotiate-employer-locked-out",
              "text": "停工通知上的墨迹还新，他把四个图钉逐个按了按，确认钉牢了。两个工人站在他身后，其中一个把帽子摘下来攥在手里。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "negotiate-employer-committee",
          "weight": 1,
          "text": "市政厅的官员把双方请到一间摆了绿色台灯的小办公室，谈了两个小时。厂长最后同意设一个委员会，但没有期限，也没有写进补偿数字。官员合上本子说这是良好开端，被扣工资的工人在走廊里把帽子转了又转。",
          "effects": [
            {
              "type": "relation",
              "a": "$subject",
              "b": "$official",
              "kind": "acquaintance",
              "trust": 0.03,
              "reason": "官员介入调停，双方建立联系"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "谈判只促成无期限委员会，实际收获有限"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "committee_without_deadline",
              "add": true,
              "reason": "参与设立没有期限的劳资委员会"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "negotiate-employer-committee",
              "text": "绿色台灯把每个人的手照得发青，官员的钢笔在纸上戳出好几个点。厂长靠在椅背上，说委员会可以，但得按他的章程来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "negotiate-employer-committee",
              "text": "走廊的瓷砖很凉，工人把帽子从左手转到右手。他听见办公室里椅子挪动的声音，知道谈完了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
