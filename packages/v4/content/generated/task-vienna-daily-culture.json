            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.06,
              "affection": 0.02,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0,
              "reason": "提醒邻居换锁并垫了零钱"
