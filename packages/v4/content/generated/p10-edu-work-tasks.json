          "key": "parent",
          "kind": "parent",
          "required": false,
          "minAge": 40,
          "maxAge": 65
        }
      ],
      "tags": [
        "apprenticeship",
        "craft",
        "career_change"
      ],
      "outcomes": [
        {
          "id": "p10-edu-work-tasks.seek-apprenticeship.accepted",
          "weight": 1,
          "text": "{master}让他先扫一遍刨花，再看他磨的刨刃。刃口平直，师傅点头收下他，约定三年学徒期，头一年只管饭。头三个月他白天学刨料，晚上替作坊看门。{parent}听说只管饭，皱了皱眉，没再说什么。",
          "effects": [
            {
              "type": "education",
              "personId": "$subject",
              "status": "apprenticeship",
              "level": 1,
              "reason": "进入细木作坊学徒期"
            },
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$master",
              "occupation": "细木学徒",
              "wage": 0,
              "workplaceId": "$workplace",
              "reason": "头一年只管饭，无工钱"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.06,
              "reason": "学磨刨刃与刨料"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$master",
              "kind": "employer",
              "trust": 0.06,
              "reason": "师傅收下他做学徒"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.seek-apprenticeship.accepted",
              "text": "作坊门口堆着新进的木料，松脂味很重。他把工具袋放下，先抄起扫帚把刨花扫到墙角，再蹲下去磨刨刃。{master}站在旁边看，等他磨完才说，明天早来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.seek-apprenticeship.accepted",
              "text": "头一天的手掌被刨子把磨出水泡，他用布条裹上接着刨。傍晚{worker}递来一碗汤，说头一年都这样。他把工具挂上墙钩，位置是从下往上数第三个。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-edu-work-tasks.seek-apprenticeship.test-piece",
          "weight": 1,
          "text": "{master}嫌他二十岁手已经定了型，让他先做一套榫头再说。他借了凿子，在废料上做了三个，前两个歪，第三个勉强合缝。师傅没答应也没拒绝，只说明天再带一个来，他回去的路上都在比划角度。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "craft",
              "amount": 0.04,
              "reason": "反复试做榫头"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "被嫌年纪大，手艺未成"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$master",
              "kind": "acquaintance",
              "trust": 0.03,
              "reason": "师傅愿再给他一次试做机会"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.seek-apprenticeship.test-piece",
              "text": "{master}把废料推到他面前，说做完我看。他握着凿子时手腕发僵，第一个榫肩削多了，第二个缝里能透光。师傅用指甲划过合缝处，没说话，把料子留下。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.seek-apprenticeship.test-piece",
              "text": "作坊里的学徒都在看。他把第三个榫头装上去，木槌敲了两下才到位。{master}说带一个来，明天。他把废料收进工具袋，出了门才发现袖子沾满木屑。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-edu-work-tasks.seek-apprenticeship.deposit",
          "weight": 1,
          "text": "工具押金要八克朗，他拿不出。{master}让他用自己的旧工具试一个月，干得好再收。他那把刨子的刃口有缺口，头几块料刨得毛糙。一个月里他每晚磨刃，磨到指节发亮，师傅只来看过两次。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -2,
              "reason": "买磨刀石与补工具柄"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "熬夜磨刃，手上裂口"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "apprenticeship_trial",
              "add": true,
              "reason": "用旧工具试用一个月，待师傅决定"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.seek-apprenticeship.deposit",
              "text": "他把旧刨子放在工作台上，刃口的缺口在灯下看得清。{master}用拇指试了试，说先用一个月。那天起他收工后留下来磨刃，磨石上的水混着铁屑，指尖冻得发木。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.seek-apprenticeship.deposit",
              "text": "工具押金的数目他在回去的路上反复算，八克朗，家里拿不出。第二天他背着旧工具袋又去，师傅扫了一眼说试一个月。他把刨子挂上墙钩，钩子有点松。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
