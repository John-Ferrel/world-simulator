    {
      "id": "p9-gap-childhood-chores.mind-sibling",
      "title": "看住最小的弟妹",
      "weight": 1,
      "rate": 0.08,
      "conditions": [
        {
          "kind": "age",
          "min": 6,
          "max": 11
        },
        {
          "kind": "householdSize",
          "min": 4
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 6,
          "maxAge": 11
        },
        {
          "key": "sibling",
          "kind": "sibling",
          "required": false,
