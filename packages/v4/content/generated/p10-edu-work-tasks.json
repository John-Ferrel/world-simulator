          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 20,
          "maxAge": 30
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": true,
          "minAge": 35,
          "maxAge": 70
        },
        {
          "key": "bookkeeper",
          "kind": "official",
          "required": false,
          "minAge": 30,
          "maxAge": 65
        },
        {
          "key": "worker",
          "kind": "worker",
          "required": false,
          "minAge": 20,
          "maxAge": 55
        }
      ],
      "tags": [
        "promotion",
        "bookkeeping",
        "factory"
      ],
      "outcomes": [
        {
          "id": "p10-edu-work-tasks.ask-promotion.trial",
          "weight": 1,
          "text": "{employer}翻过那本包在布里的出入库本子，看到箱数和发货单对得上，说先让他兼管发货账，每月加三克朗，试用三个月。他出门时{worker}拍了拍他的肩膀。工钱不多，但那是他第一次把手写的数字换成了桌上的位置。",
          "effects": [
            {
              "type": "employment",
              "personId": "$subject",
              "organizationId": "$employer",
              "occupation": "发货记账兼包装工",
              "wage": 3,
              "workplaceId": "$workplace",
              "reason": "厂主让他兼管发货账并加薪试用"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "本子被厂主认可，工友间口碑上升"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.04,
              "reason": "实际管发货账"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.ask-promotion.trial",
              "text": "他在办公室门外站了半小时，本子被手汗洇出印子。{employer}翻到最后一页，那里记着他自己核过的三批箱数，一处也没改。桌上的墨水瓶开着，厂主蘸笔时说了句，先试三个月。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.ask-promotion.trial",
              "text": "包装间的机器声隔着门传进来。他把本子摊开，一页页翻给厂主看，指尖点着他用铅笔标的箱数。厂主靠在椅背上听完，说发货账归你，工钱加三克朗。他出门时差点忘了把布包带走。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-edu-work-tasks.ask-promotion.deferred",
          "weight": 1,
          "text": "{employer}听完，说记账的位置要给商会介绍的人，他继续管包装，明年再考虑。本子还给了他。回包装间时{worker}正在点数，他把本子塞回布里，发现手心的汗把第一页边角浸软了。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "位置给商会介绍的人，只得到一句明年再说"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$employer",
              "kind": "employer",
              "trust": 0.02,
              "reason": "当面陈情，厂主记得他"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.02,
              "reason": "工友听说他敢去找厂主"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.ask-promotion.deferred",
              "text": "厂主说话时没抬眼，笔在订货单上划。他把本子推回去，问明年是什么时候，厂主说等商会的信。门外的钟走了一刻，他站着听完，才转身。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.ask-promotion.deferred",
              "text": "他把布包夹在腋下往回走，包装间的纸箱堆到胸口高。{worker}问怎么样，他摇摇头说留着位置没给。纸箱的干草味混着机器油，他重新拿起记号笔。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-edu-work-tasks.ask-promotion.conflict",
          "weight": 1,
          "text": "他和{bookkeeper}在门口争了几句，对方说本子上的字号不合规矩，他回了一句你根本没核过夜班的箱数。{employer}把本子留下，位置给了别人，第二天他被调去夜班。本子他再没见着。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.12,
              "reason": "争执后位置旁落并被调去夜班"
            },
            {
              "type": "relation_end",
              "a": "$subject",
              "b": "$bookkeeper",
              "kind": "colleague",
              "reason": "当面争执，记账处的门路断了"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "改上夜班，作息颠倒"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.ask-promotion.conflict",
              "text": "他把本子放在厂主桌上，{bookkeeper}伸手来翻，说字号不规整。声音传出门外，几个包装工停下手里的活。厂主最后把本子合上压在墨水瓶下，说夜班缺人。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.ask-promotion.conflict",
              "text": "夜里十点的厂房只亮着几盏汽灯，他搬箱子时还在想那句话。本子留在厂主桌上，账他没再碰。{worker}下白班路过，说算了，别为三克朗把饭碗砸了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
