        },
        {
          "key": "parent",
          "kind": "parent",
          "required": true,
          "minAge": 25,
          "maxAge": 60
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 18,
          "maxAge": 70
        }
      ],
      "tags": [
        "childhood",
        "sibling",
        "care",
        "household"
      ],
      "outcomes": [
        {
          "id": "sibling-carried-afternoon",
          "weight": 1,
          "text": "{parent}走后，{sibling}一直往井台边挣，{subject}索性把她背在背上，围着{residence}的院子一圈圈走。走到傍晚，{sibling}趴在背上睡着了，{subject}的胳膊却酸得放不下来，晚饭时连木勺都握不稳。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "背弟妹走了一下午，胳膊酸痛"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.02,
              "reason": "学会哄住哭闹的幼儿"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": 0.08,
              "affection": 0.06,
              "obligation": 0.05,
              "fear": 0,
              "respect": 0,
              "reason": "背着弟妹一下午"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "sibling-carried-afternoon",
              "text": "院门口不时有煤车碾过，{subject}把{sibling}往上颠了颠，绕开井台那圈湿滑的石头。屋檐下晾着的旧布被风吹得拍墙，声音一下一下。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "sibling-carried-afternoon",
              "text": "邻家的孩子还在敲铁皮桶，{sibling}一听见就想过去。{subject}把她抱回来，让她揪着自己的衣领，一圈又一圈走，直到太阳落到烟囱后面。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "sibling-falls-at-well",
          "weight": 1,
          "text": "{subject}低头去捡滚到墙角的土豆，{sibling}已经挪到井台边，脚下一滑坐在湿石头上，哭得喘不上气。{neighbor}闻声从门里出来把孩子抱进屋擦脸。{parent}晚上回来，听完缘由把{subject}数落了一顿，罚她少领半份晚饭。",
          "effects": [
            {
              "type": "health",
              "personId": "$sibling",
              "amount": -0.03,
              "reason": "在井台边摔了一跤"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "看护失手被母亲责骂"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": -0.03,
              "affection": -0.02,
              "obligation": 0.02,
              "fear": 0.04,
              "respect": 0,
              "reason": "没看住弟妹"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "sibling-falls-at-well",
              "text": "井台边的石头被桶水泼得发亮，{sibling}的鞋底一滑就坐了下去。{neighbor}抱起孩子时，{subject}还攥着那只捡了一半的土豆站在原地。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "sibling-falls-at-well",
              "text": "哭声从井台那边传过来，{subject}跑过去时{sibling}的裤腿已经湿了一片。{parent}傍晚进门，先把孩子抱起来看膝盖，再回头看{subject}，一句话没说，{subject}自己把碗放下了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "sibling-shelter-missed-river",
          "weight": 1,
          "text": "{subject}把木盆翻过来，拿旧布搭了个小棚，{sibling}蜷在里面睡着。院里的同伴在巷口喊了两遍去河边，{subject}都摇头，等{parent}回来时天已经暗了。同伴第二天说她胆子小，{subject}没辩解，只把小棚拆了还回盆。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "错过和同伴去河边的约"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": 0.05,
              "affection": 0.05,
              "obligation": 0.04,
              "fear": 0,
              "respect": 0,
              "reason": "守着睡着的弟妹没离开"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$parent",
              "kind": "kin",
              "trust": 0.04,
              "affection": 0.02,
              "obligation": 0.03,
              "fear": 0,
              "respect": 0.02,
              "reason": "母亲回家见弟妹安睡"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "sibling-shelter-missed-river",
              "text": "木盆扣在墙根，旧布从盆沿垂下来，{sibling}的呼吸慢慢匀了。巷口同伴的喊声过去又回来，{subject}只是坐着，用手压住被风吹起的布角。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "sibling-shelter-missed-river",
              "text": "河边的笑声顺着巷子飘进来，{subject}往盆里看了一眼，{sibling}翻了个身又睡了。她把散开的布角掖紧，听见自己的肚子在响。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
        "domain": "family",
        "goals": [
          "family",
