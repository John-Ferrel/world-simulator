    "events": {
      "count": 31,
      "samples": [
        {
          "date": {
            "year": 1915,
            "month": 8
          },
          "action": "vienna-history-war-homefront/volunteer-on-the-ward",
          "subject": "person-berta-weiss",
          "text": "Berta Weiss 在医院走廊里帮护士换床单。Anna Moser 的丈夫刚从前线送回来，腿上裹着渗血的绷带；Berta Weiss 没有多问，只把热水和干净的布放在床头。回家时，Berta Weiss 的手上还留着消毒水味。",
          "participants": [
            "person-berta-weiss",
            "person-anna-moser"
          ]
        },
        {
          "date": {
            "year": 1915,
            "month": 12
          },
          "action": "vienna-history-war-conscription/report-for-service",
          "subject": "person-emil-weiss",
          "text": "Emil Weiss 在名单上找到自己的名字，把家里的钥匙交给Berta Weiss，跟着队伍走进兵营。Gustav Berg 只问了一句会不会写字，就把他分到连部抄名单。晚上，Emil Weiss 在铺位上给家里写第一封信，信纸是兵营发的，格子很窄。",
          "participants": [
            "person-emil-weiss",
            "person-berta-weiss",
            "person-gustav-berg"
          ]
        },
        {
          "date": {
            "year": 1915,
            "month": 9
          },
          "action": "vienna-history-war-homefront/take-in-the-family",
          "subject": "person-grete-stein",
          "text": "Grete Stein 把Emil Weiss 和两个孩子接到自己的一间半房里。五个人分两张床，煤只够烧到半夜。Grete Stein 把最后一袋面粉分成两份，第二天去市场排队时才知道配给又减了；回家后，Grete Stein 没有把这件事告诉孩子。",
          "participants": [
            "person-grete-stein",
            "person-emil-weiss"
          ]
        },
        {
          "date": {
            "year": 1915,
            "month": 3
          },
          "action": "vienna-history-war-homefront/volunteer-on-the-ward",
          "subject": "person-maria-kral",
          "text": "Maria Kral 在医院走廊里帮护士换床单。Luise Kral 的丈夫刚从前线送回来，腿上裹着渗血的绷带；Maria Kral 没有多问，只把热水和干净的布放在床头。回家时，Maria Kral 的手上还留着消毒水味。",
          "participants": [
            "person-maria-kral",
            "person-luise-kral"
          ]
        },
        {
          "date": {
            "year": 1916,
            "month": 1
          },
          "action": "vienna-history-war-conscription/report-for-service",
          "subject": "person-alois-lechner",
          "text": "Alois Lechner 在名单上找到自己的名字，把家里的钥匙交给Emil Weiss，跟着队伍走进兵营。Gustav Berg 只问了一句会不会写字，就把他分到连部抄名单。晚上，Alois Lechner 在铺位上给家里写第一封信，信纸是兵营发的，格子很窄。",
          "participants": [
            "person-alois-lechner",
            "person-emil-weiss",
            "person-gustav-berg"
          ]
        },
        {
          "date": {
            "year": 1916,
            "month": 8
          },
          "action": "vienna-history-war-antiwar/speak-at-the-gathering",
          "subject": "person-alois-lechner",
          "text": "Alois Lechner 在工友聚会上说，前线需要的不是更多的口号，而是面包和停战。Hermann Kral 第一个附和，另两个人起身走了。第二天，车间主任把Alois Lechner 叫去问话，但没有开除；午休时，几个年轻工人过来问传单还有没有。",
          "participants": [
            "person-alois-lechner",
            "person-hermann-kral"
          ]
        },
        {
          "date": {
            "year": 1916,
            "month": 2
          },
          "action": "vienna-history-war-antiwar/argue-for-the-front",
          "subject": "person-ferdinand-winter",
          "text": "Ferdinand Winter 认为反战传单只会给工厂招来警察。Ferdinand Winter 在门口拦住Luise Kral，把一叠爱国募捐单塞回去，说现在应该先支持前线。两人在楼梯上吵了起来，最后Luise Kral 把募捐单揉成一团，塞进Ferdinand Winter 的外套口袋。",
          "participants": [
            "person-ferdinand-winter",
            "person-luise-kral"
          ]
        },
        {
          "date": {
            "year": 1916,
            "month": 1
          },
          "action": "vienna-history-war-homefront/collapse-from-exhaustion",
          "subject": "person-helene-winter",
          "text": "Helene Winter 连续几天在医院和家之间跑，开始发烧。Ferdinand Winter 替Helene Winter 去排队领面包，回来时只拿到半块黑面包。Helene Winter 躺在床上听见走廊里有人推车经过，车轮声一直到天亮；第二天，Helene Winter 没有力气去医院。",
          "participants": [
            "person-helene-winter",
            "person-ferdinand-winter"
          ]
        }
      ]
    }
  },
