  "nodes": [
    {
      "id": "vienna-adolescence.workshop-apprentice",
      "title": "作坊学徒",
      "weight": 1,
      "rate": 0.2,
      "conditions": [
        {
          "kind": "age",
          "min": 12,
          "max": 17
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 12,
          "maxAge": 17
        },
        {
          "key": "employer",
          "kind": "employer",
          "required": true,
          "minAge": 30,
          "maxAge": 70,
          "organizationKind": "factory"
        },
        {
          "key": "mother",
          "kind": "parent",
          "required": true,
          "minAge": 30,
          "maxAge": 55
        }
      ],
      "outcomes": [
        {
          "id": "apprenticeship-accepted",
          "weight": 2,
          "text": "{subject}跟着{mother}走进{workplace}，{employer}让{subject}推了十分钟刨子，木花落了一地，当场收下当学徒，讲好每周一先交三天的饭钱。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 3,
              "reason": "{subject}学徒首周的膳食预付款"
            },
            {
              "type": "education",
              "personId": "$subject",
              "reason": "在木工作坊学到推刨和量尺",
              "status": "apprenticeship"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.1,
              "reason": "{employer}当场收徒并交代规矩"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$mother",
              "kind": "kin",
              "affection": 0.05,
              "obligation": 0.05,
              "reason": "{mother}带{subject}去作坊谈学徒"
            }
          ],
          "narration": [
            {
              "id": "accepted-a",
              "key": "apprenticeship-accepted",
              "text": "{subject}跟着{mother}走进{workplace}，{employer}让{subject}推了十分钟刨子，木花落了一地，当场收下当学徒，讲好每周一先交三天的饭钱。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "accepted-b",
              "key": "apprenticeship-accepted",
              "text": "{employer}用拇指蹭了蹭{subject}推刨时压出的木纹，点头说留下，{mother}从手帕里数出三枚硬币放在工作台上。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "apprenticeship-rejected",
          "weight": 1,
          "text": "{employer}看了看{subject}的手掌，说太薄，推不了硬木，让{mother}领回去。{subject}在门口站了一会儿，听见里面刨子又响起来。",
          "effects": [
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.08,
              "reason": "被作坊拒绝当学徒"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "{employer}当面拒绝收徒"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$mother",
              "kind": "kin",
              "affection": -0.03,
              "obligation": 0.05,
              "reason": "{mother}白跑一趟作坊"
            }
          ],
          "narration": [
            {
              "id": "rejected-a",
              "key": "apprenticeship-rejected",
              "text": "{employer}看了看{subject}的手掌，说太薄，推不了硬木，让{mother}领回去。{subject}在门口站了一会儿，听见里面刨子又响起来。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "rejected-b",
              "key": "apprenticeship-rejected",
              "text": "{employer}把{subject}推好的木条翻过来看了一眼，说歪了，学徒名额已经满了，{mother}把手里攥着的三枚硬币又放回手帕。",
              "tone": [
                "dry"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "vienna-adolescence.brothers-torn-jacket",
      "title": "哥哥的旧外套",
      "weight": 1,
      "rate": 0.18,
      "conditions": [
        {
          "kind": "age",
          "min": 12,
          "max": 17
        },
        {
          "kind": "householdSize",
          "min": 4
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 12,
          "maxAge": 17
        },
        {
          "key": "father",
          "kind": "parent",
          "required": true,
          "minAge": 35,
          "maxAge": 60
        }
      ],
      "outcomes": [
        {
          "id": "sew-it-yourself",
          "weight": 2,
          "text": "{subject}把哥哥留下的灰外套摊在厨房桌上，自己用粗线把腋下的裂口缝上，针脚歪歪扭扭。{father}看了一眼，没说话，把自己那碗汤推过去半碗。",
          "effects": [
            {
              "type": "skill",
              "personId": "$subject",
              "amount": 0.04,
              "reason": "自己缝补外套裂口",
              "skill": "craft"
            },
            {
              "type": "food",
              "householdId": "$household",
              "amount": 1,
              "reason": "{father}分给{subject}半碗汤"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$father",
              "kind": "kin",
              "affection": 0.06,
              "trust": 0.04,
              "reason": "{father}看见{subject}自己补衣服"
            }
          ],
          "narration": [
            {
              "id": "sew-a",
              "key": "sew-it-yourself",
              "text": "{subject}把哥哥留下的灰外套摊在厨房桌上，自己用粗线把腋下的裂口缝上，针脚歪歪扭扭。{father}看了一眼，没说话，把自己那碗汤推过去半碗。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "sew-b",
              "key": "sew-it-yourself",
              "text": "{subject}坐在窗边借着最后一点天光补外套，线用完三次又接上。{father}把煤油灯往{subject}那边挪了挪，说下个月再买线。",
              "tone": [
                "dry"
              ]
            }
          ]
        },
        {
          "id": "sell-the-coat",
          "weight": 1,
          "text": "{subject}把外套拿到巷口的旧货贩子那里，换回两个铜板，藏在鞋垫底下。晚上{father}发现外套不见了，盯着空衣钩看了很久。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": 2,
              "reason": "卖掉哥哥旧外套"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$father",
              "kind": "kin",
              "trust": -0.08,
              "fear": 0.05,
              "reason": "{father}发现外套被卖掉"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "背着父亲卖掉外套"
            }
          ],
          "narration": [
            {
              "id": "sell-a",
              "key": "sell-the-coat",
              "text": "{subject}把外套拿到巷口的旧货贩子那里，换回两个铜板，藏在鞋垫底下。晚上{father}发现外套不见了，盯着空衣钩看了很久。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "sell-b",
              "key": "sell-the-coat",
              "text": "{subject}把灰外套叠好塞给旧货贩子，贩子捏了捏袖口，只肯给两个铜板。{father}晚饭时问外套去哪了，{subject}说晾在外面忘了收。",
              "tone": [
                "dry"
              ]
            }
          ]
        }
      ]
