        "skills": ["social"]
      }
    },
    {
      "id": "p9-gap-childhood-chores.market-line",
      "title": "替家里排一次配给队",
      "weight": 1,
      "rate": 0.085,
      "conditions": [
        {
          "kind": "age",
          "min": 6,
          "max": 11
        },
        {
          "kind": "householdSize",
          "min": 3
        }
      ],
      "roles": [
