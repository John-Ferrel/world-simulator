            {
              "type": "relation",
              "a": "$subject",
              "b": "$sibling",
              "kind": "kin",
              "trust": -0.04,
              "reason": "互相埋怨纸张没保管好"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "事情拖到月底，心里发闷"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "missing-death-certificate",
              "text": "“缺一张纸”让全屋人安静了一瞬。回去后{subject}把箱子拖到灯下，一件件翻；{sibling}在旁边说风凉话，说早该有人管这些。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "missing-death-certificate",
              "text": "纸堆里没找到那份证明，只有几张旧收据。{subject}把日期用铅笔记在门后，第二天一早去办事处排队，回来时鞋上沾着雨天的泥。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
