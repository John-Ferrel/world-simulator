        ],
        "baseUtility": 1.35,
        "risk": 0.25,
        "skills": [
          "craft"
        ],
        "capability": "craft_affinity"
      }
    },
    {
      "id": "task-vienna-special-capability.hard-journey",
      "title": "去疗养院的三次换车",
      "weight": 1,
      "rate": 0.0167,
      "conditions": [
