            "home"
          ]
        },
        {
          "kind": "health",
          "max": 0.9
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 22,
          "maxAge": 70
        },
        {
          "key": "neighbor",
          "kind": "neighbor",
          "required": true,
          "minAge": 1,
          "maxAge": 80
        },
        {
          "key": "doctor",
          "kind": "worker",
          "required": true,
          "minAge": 30,
          "maxAge": 70,
          "occupation": "Arzt"
        }
      ],
      "outcomes": [
        {
          "id": "fetch-doctor-half-fee",
          "weight": 1,
          "text": "{subject}踩着没到小腿的雪去敲{doctor}的门，先付一半出诊费，医生答应天亮前到。回来时鞋里灌满雪水，{neighbor}的额头已经烫得不敢碰。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1.5,
              "reason": "预付医生一半出诊费"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.03,
              "reason": "冒雪夜行，脚趾冻得发麻"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.12,
              "reason": "半夜冒雪为邻居请医生"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "fetch-doctor-half-fee",
              "text": "雪把电车轨道埋了一半，{subject}沿着墙根走，风从领口灌进去。{doctor}开门时披着睡袍，听完只问出诊费带了多少。三克朗的出诊费先付一克朗五十赫勒，他收了钱，答应天亮前一定到。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "fetch-doctor-half-fee",
              "text": "医生家的门铃冻住了，{subject}用拳头捶了七八下。{doctor}在门里问清地址，把听诊器放进皮包。回来的路上{subject}数着口袋里剩下的铜币，进门时{neighbor}的呼吸又急又浅，湿布已经捂不凉。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "carry-child-hospital",
          "weight": 1,
          "text": "{subject}用毯子裹起{neighbor}，背到综合医院急诊走廊。长椅上挤满人，等到窗户发白，孩子的烧退了些，{subject}的胳膊却抖得端不住水杯。",
          "effects": [
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "雪夜背孩子去医院，肩臂脱力"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "孩子在急诊退烧，心里稍安"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.15,
              "reason": "背邻居家的孩子去急诊"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "carry-child-hospital",
              "text": "雪灌进后领，{subject}把{neighbor}往上颠了颠，毯子角扫过结冰的路面。急诊走廊的煤气灯整夜亮着，值班护士给了半杯温水。天亮时孩子额头出了汗，{subject}的胳膊却抖得端不稳杯子。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "carry-child-hospital",
              "text": "从家到医院走了四十分钟，{subject}的鞋底磨得只剩一层布。急诊门口有人抽烟，烟味混着石炭酸，孩子趴在{subject}肩上哼哼。等到窗外发白，护士叫进去量了体温，说暂时稳住了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "wait-with-wet-cloth",
          "weight": 1,
          "text": "{subject}用湿布和半瓶退烧药熬到天亮，煤都添进了炉子。{doctor}来时只在门口站了站，留一张饮食单，说继续观察，出诊费免了。",
          "effects": [
            {
              "type": "food",
              "householdId": "$household",
              "amount": -1,
              "reason": "整夜添煤烧水，多耗了口粮份额"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.02,
              "reason": "整夜守候，睡眠不足"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$neighbor",
              "kind": "acquaintance",
              "trust": 0.08,
              "reason": "彻夜照看邻居家发烧的孩子"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "wait-with-wet-cloth",
              "text": "炉子里的煤一块块塌下去，{subject}把湿布换了七八回。孩子抽了一阵，后来慢慢睡沉。{doctor}天亮后进门，没脱大衣，看了看眼睑，在纸上写下“稀粥、温水、静卧”，说药不用再加。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "wait-with-wet-cloth",
              "text": "退烧药水只剩半瓶，{subject}按药房标签倒了两次。后半夜孩子睁开眼要水喝，{subject}把铜壶里最后一点温水倒进杯子。医生来时雪已经停了，只在门垫上蹭了蹭靴底，留下饮食单便走。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "p9-history-medical-daily.pharmacy-shortage",
      "title": "药房里最后一瓶药",
      "weight": 1,
      "rate": 0.032,
      "conditions": [
        {
          "kind": "age",
          "min": 22,
          "max": 70
        },
        {
          "kind": "cash",
