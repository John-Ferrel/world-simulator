              "type": "flag",
              "personId": "$subject",
              "flag": "study_deferred_by_family",
              "add": true,
              "reason": "学业被家庭暂时搁置"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "shop-over-school",
              "text": "碗碟在厨房里碰得响。{subject}坐在原位没动，桌上账本还摊着，左边一栏的欠款数字被灯光照得发亮。",
              "tone": ["dry"]
            },
            {
              "id": "alt",
              "key": "shop-over-school",
              "text": "他回房把听课证压在一叠旧报纸下，纸边露出一点。楼下父亲在关店门，铁栓落下时响了一声。",
              "tone": ["matter-of-fact"]
            }
          ]
