            "confrontation",
            "institutionalizing"
          ]
        }
      ],
      "roles": [
        {
          "key": "subject",
          "kind": "subject",
          "required": true,
          "minAge": 22,
          "maxAge": 65
        },
        {
          "key": "adler",
          "kind": "historical",
          "required": true,
          "minAge": 58,
          "maxAge": 66,
          "historicalId": "Q366845"
        },
        {
          "key": "party",
          "kind": "organization",
          "required": false,
          "organizationKind": "party"
        }
      ],
      "outcomes": [
        {
          "id": "adler-reply-yes",
          "weight": 1,
          "text": "{subject}收到{adler}亲笔回信，说可派一位演说者，附一叠小册子和一张去维也纳新城的车票。支部会议改在大厅，听众挤到门外，散会时收了四十二克朗会费。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "寄信和买信封邮票"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "阿德勒回信答应派演说者并附来小册子",
              "confidence": 0.9,
              "sourceKind": "witnessed",
              "personId": "$subject",
              "visibility": "private",
              "trueInWorld": true
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.08,
              "reason": "支部因组织演讲受到称赞"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$adler",
              "kind": "acquaintance",
              "trust": 0.1,
              "respect": 0.15,
              "reason": "通信后得到对方回复"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "adler-reply-yes",
              "text": "邮差在午饭前送来厚信封，里面除回信还有一叠油印小册子。{subject}把信纸摊在桌上，念到“同意派员”时，邻座的老工人把汤匙放下，说大厅得提前借。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "adler-reply-yes",
              "text": "回信末尾的签名墨色很重。{subject}揣着信去支部，路上在报摊前停了一下，当天的《工人报》仍然没货。借大厅要三克朗押金，先由会费垫上。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "adler-reply-polite-no",
          "weight": 1,
          "text": "{adler}回信很客气，说总部排不出人，建议先和本地支部联系。{subject}把信读了两遍，发现连称呼都是书记代写的。会费收据夹在信里退回，会议日期只好划掉重排。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "往返邮资和信纸"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.06,
              "reason": "被婉拒后的失望"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "总部以人手不足为由婉拒派演说者",
              "confidence": 0.85,
              "sourceKind": "witnessed",
              "personId": "$subject",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "adler-reply-polite-no",
              "text": "回信只有半页，措辞周到得像账单。{subject}把会费收据从信封里抖出来，纸角已经折了。旁边的工友问怎么样，{subject}说总部忙，先自己想办法。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "adler-reply-polite-no",
              "text": "信封上的党部戳记很清楚，里面的字却像抄来的。{subject}在支部会上把信念了一遍，没人接话，最后有人说那就请本地小学教师来讲。会议日期用铅笔改了。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "letter-sits-two-weeks",
          "weight": 1,
          "text": "信在编辑部压了两个星期。{subject}索性搭电车进城，在党部门口等到散会，只见到一位书记，说信已转给阿德勒本人，但本周不会答复。回程车票花掉四十赫勒。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -1,
              "reason": "电车票和路上买的面包"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "白跑一趟的疲惫"
            },
            {
              "type": "knowledge",
              "holderId": "$subject",
              "proposition": "党部书记说信已转交但本周不会答复",
              "confidence": 0.8,
              "sourceKind": "witnessed",
              "personId": "$subject",
              "visibility": "private",
              "trueInWorld": true
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "letter-sits-two-weeks",
              "text": "党部走廊的灯只开了一半，长椅上坐着两个等消息的人。{subject}把帽子捏在手里，听书记说“转交了”，知道今天不会有结果。电车回郊区时，窗外的环城大道已经亮灯。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "letter-sits-two-weeks",
              "text": "散会的人从楼梯上下来，没人朝{subject}这边看。书记翻登记簿，指着一行字说信在阿德勒的夹子里。{subject}在门口买了个干面包，边吃边等下一班电车。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
      "task": {
