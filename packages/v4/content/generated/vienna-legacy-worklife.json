{
  "id": "vienna-legacy-worklife",
  "title": "改革之后的工场与家庭",
  "stage": "adulthood",
  "ageWindow": {
    "min": 18,
    "max": 65
  },
  "tags": ["legacy", "work", "family", "reform", "ordinary_life"],
  "baseRate": 0.16,
  "conditions": [
    {
      "kind": "age",
      "min": 18,
      "max": 65
    },
