              "type": "skill",
              "personId": "$subject",
              "skill": "social",
              "amount": 0.02,
              "reason": "学会跟客户说明潮气的来由"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$forewoman",
              "kind": "acquaintance",
              "trust": 0.03,
              "reason": "返工没推脱，女工头记下了"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "damp-linen-returned",
              "text": "客户把床单抖开，凑近闻了闻，说后墙返潮不能怪人，可今天的账不能记。他抱着床单下楼，台阶上的水渍一路滴下去。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "damp-linen-returned",
              "text": "后院的晾绳用木夹子夹，夹子不够，他把边角打在绳结里。风从院墙外灌进来，床单鼓起来，像一面面没字的旗。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
