          "minAge": 20,
          "maxAge": 50
        }
      ],
      "tags": [
        "exam",
        "commercial_school",
        "certificate"
      ],
      "outcomes": [
        {
          "id": "p10-edu-work-tasks.qualification-exam.passed",
          "weight": 1,
          "text": "四门都过了线。{teacher}把毕业证明递给他时，纸上的油墨还带潮气，说拿这个去商号招工处，至少能进柜台谈。他数出五克朗报名费时手心全是汗，现在那张证明夹在账本里，比钱硬。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "商业学校校外考生的报名费"
            },
            {
              "type": "education",
              "personId": "$subject",
              "status": "secondary",
              "level": 1,
              "reason": "通过商业学校毕业考试取得证明"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.06,
              "reason": "备考簿记与商业算术"
            },
            {
              "type": "reputation",
              "personId": "$subject",
              "amount": 0.05,
              "reason": "取得毕业证明，商号招工处愿意面谈"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.qualification-exam.passed",
              "text": "旧礼堂里桌子排成四列，只许放钢笔和算盘。他做完复利题抬头，窗外的钟刚过十一点。{teacher}收卷时点了点头，那一下他记了很久。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.qualification-exam.passed",
              "text": "速记那场他写得手腕发酸，符号连成一串。考完他和其他考生在走廊里对答案，有人叹气有人笑。三天后他来取证明，学校的门房认得他，说商号那边正缺人。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-edu-work-tasks.qualification-exam.partial",
          "weight": 1,
          "text": "簿记和算术过了，速记差两分。{official}在成绩单上分栏注明，只发单科证明，明年可以补考速记。他把单科证明折好，知道商号要的是整张。回厂时{worker}问他考得怎样，他说差一点。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "报名费不退"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.04,
              "reason": "簿记与算术达到单科合格"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.05,
              "reason": "速记差两分，只拿到单科证明"
            },
            {
              "type": "flag",
              "personId": "$subject",
              "flag": "shorthand_retake",
              "add": true,
              "reason": "计划明年补考速记"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.qualification-exam.partial",
              "text": "成绩单上速记一栏用红笔写着两分之差。他把证明对着光看，纸很薄。{official}说补考要重新交费，明年春天开考，别忘了日子。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.qualification-exam.partial",
              "text": "他在学校门口的公告板前站住，合格名单上没有他的名字，下面另有一栏单科及格的。他用指甲掐着那一行，回头往电车站走，盘算明年春天之前怎么练速记。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        },
        {
          "id": "p10-edu-work-tasks.qualification-exam.failed",
          "weight": 1,
          "text": "考前一天他在厂里加班到十点，第二天头脑发沉，复利题算错一道，连错三步。成绩下来四门只剩一门及格，报名费不退。{teacher}把卷子还给他，说那道题错在第一步，他盯着自己的字没吭声。",
          "effects": [
            {
              "type": "cash",
              "householdId": "$household",
              "amount": -5,
              "reason": "报名费不退，考试未过"
            },
            {
              "type": "health",
              "personId": "$subject",
              "amount": -0.04,
              "reason": "加班后应试，整日头沉乏力"
            },
            {
              "type": "mood",
              "personId": "$subject",
              "amount": -0.1,
              "reason": "考试未过，白花报名费"
            },
            {
              "type": "skill",
              "personId": "$subject",
              "skill": "numeracy",
              "amount": 0.02,
              "reason": "从错题里认清复利算法的第一步"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "p10-edu-work-tasks.qualification-exam.failed",
              "text": "旧礼堂里的凳子比厂里的还硬。他写到第二张卷子时太阳穴跳，笔尖在复利题上停住，最后把第一步的乘数写反了。收卷时他闻到墨水和旧木头的味道。",
              "tone": [
                "dry"
              ]
            },
            {
              "id": "alt",
              "key": "p10-edu-work-tasks.qualification-exam.failed",
              "text": "成绩贴在公告板上，他从下往上看，自己的名字在不及格那栏。旁边一个考生骂了一声，把帽子摔在台阶上。他把卷子塞进布里，往电车站走，脚底下很轻。",
              "tone": [
                "matter-of-fact"
              ]
            }
          ]
        }
      ],
