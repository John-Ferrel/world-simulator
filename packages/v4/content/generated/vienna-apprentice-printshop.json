              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": -0.12,
              "reason": "加班被算作练习"
            },
            {
              "type": "relation",
              "a": "$subject",
              "b": "$worker",
              "kind": "colleague",
              "trust": 0.08,
              "reason": "私下点了条赚钱的路"
            }
          ],
          "narration": [
            {
              "id": "default",
              "key": "overtime-wage-scuffle.paid-short",
              "text": "为赶选举传单，{subject}连排三个晚上。{employer}把加班算成“学徒练习”，只多给半克朗。{worker}在楼梯间说这是常事，叫{subject}周末去八角亭替人抄货单。",
