    {
      "id": "person-phase3-life-1",
      "name": "Life 01",
      "born": {
        "year": 1912,
        "month": 1
      },
      "died": {
        "year": 1986,
        "month": 1
      },
      "deathCause": "意外事故",
      "alive": false,
      "age": 74,
      "events": 502,
      "sample": [
        {
          "year": 1984,
          "action": "vienna-women-housework.care-old-parent/care.institution",
          "text": "医院走廊里一股石炭酸味，Helene Schnitzler把包袱交给护士，里面是两件换洗衣裳。Life 01拉着她的手说了几句，听不清。回来路过教堂，她没进去，只在台阶上坐了一会儿。"
        },
        {
          "year": 1985,
          "action": "vienna-women-housework.care-old-parent/care.self-tend",
          "text": "Life 01夜里喊人，Helene 2从窄床上坐起，摸黑去扶。炉子上煨着一小锅汤，汤面结了薄皮。Life 05上午来敲门，把一碗稠粥放在灶沿，没多留。"
        },
        {
          "year": 1985,
          "action": "vienna-market-household.friday-fish/friday-fish.salt",
          "text": "腌鲱鱼切成两段，一段今天吃，一段留着。黑面包硬得要用刀锯。Life 01来借盐，眼睛落在鱼上，说可以用半棵卷心菜换一块。Luise Bauer切了一指宽递过去。"
        },
        {
          "year": 1985,
          "action": "vienna-family-childbirth/son-born",
          "text": "Elisabeth Weiss在Haus der Tante in Klosterneuburg生下一个男婴，取名Emil 2。Emil 2把消息带到工厂，工友凑了几个克朗；家里把唯一的摇篮重新刷了一遍。"
        },
        {
          "year": 1985,
          "action": "vienna-housing-move.rent-notice/rent-notice-demand-repair",
          "text": "Elisabeth Weiss领Life 01绕墙角走了一圈，手指按在潮软发黑的墙纸上。看门人低着头说楼梯间的窗是房东亲自吩咐的，Elisabeth Weiss便把话原样托他带上去，纸仍压在煤箱上没动。"
        },
        {
          "year": 1985,
          "action": "agency:request_help",
          "text": "Helene Lechner去找Life 01求助，对方也正被房租和病人拖住，只能摇头。"
        },
        {
          "year": 1986,
          "action": "statistical_infection",
          "text": "Life 01在Haus der Tante in Klosterneuburg病倒了，肺炎让身体发热、虚弱，接下来的日子只能卧床。"
        },
        {
          "year": 1986,
          "action": "statistical_death/accident",
          "text": "Life 01在Haus der Tante in Klosterneuburg附近出了事故。工友和路人把人抬到门口，等医生赶到时已经没有了呼吸。"
        }
      ]
    },
    {
      "id": "person-phase3-life-2",
